 '冰淇淋': [[(27,48),(50,92),(73,48),(27,48)],[(27,48),(21,38),(24,25),(34,17),(47,17),(54,12),(65,17),(77,28),(79,38),(73,48)]],
 '自行车': [_circle(25,70,17),_circle(75,70,17),[(25,70),(43,40),(60,70),(25,70),(60,70),(75,70),(63,35),(72,29)],[(36,40),(49,40)]],
 '小船': [[(13,69),(87,69),(72,83),(30,83),(13,69)],[(50,15),(50,69),(20,61),(50,15)],[(54,25),(80,61),(54,61),(54,25)]],
 '月亮': [[(67,17),(52,15),(36,20),(24,32),(18,48),(21,66),(33,79),(50,85),(67,81),(78,72),(62,71),(47,61),(40,46),(43,32),(54,22),(67,17)]],
}
def bot_draw_choices():
    used=set(STATE['draw'].get('usedWords',[])); choices=[k for k in BOT_PICTURES if k not in used]
    if not choices: STATE['draw']['usedWords']=[]; choices=list(BOT_PICTURES)
    return [{'word':word,'category':'简笔画','difficulty':'easy','library':'items','aliases':{'冰淇淋':['冰激凌','雪糕'],'小船':['船'],'花朵':['花'],'鱼':['小鱼']}.get(word,[])} for word in random.sample(choices,min(3,len(choices)))]

def _bot_move(p,action,**data):
    result=Handler.handle_action(object.__new__(Handler),p,action,data)
    if result[1]!=200: print('机器人操作被拒绝:',action,result[0])
    return result[1]==200

def _bot_task():
    phase=STATE['phase']; mode=STATE['mode']; bots=[p for p in STATE['players'] if p.get('isBot')]
    if not bots or phase in ('lobby','finished'): return None
    if mode=='chuanma':
        cm=STATE['chuanma']
        if phase in ('cm_exchange','cm_dingque'):
            key='exchangeSelections' if phase=='cm_exchange' else 'dingqueSelections'
            return next((p for p in bots if p['id'] not in cm[key]),None)
        if phase=='cm_response': return next((p for p in bots if p['id'] in cm['responseOptions'] and p['id'] not in cm['responses']),None)
    if mode=='draw' and phase=='draw_choose': return player_by_id(STATE['draw']['drawerId']) if bots else None
    if mode in ('cards','dice','chuanma'):
        p=player_by_id(STATE['turnPlayerId']); return p if p and p.get('isBot') else None
    return None

def bot_step(p):
    phase=STATE['phase']; mode=STATE['mode']
    if mode=='cards':
        last=STATE['card']['lastPlay']; hand=p['hand']; target=STATE['card']['targetRank']; truthful=[c for c in hand if c['rank'] in (target,'JOKER')]
        if last and (not hand or random.random()<(.52 if len(last['cards'])>=2 else .21)):
            return _bot_move(p,'cards_challenge')
        if hand:
            pool=truthful if truthful and random.random()<.72 else hand
            return _bot_move(p,'cards_play',cardIds=[c['id'] for c in random.sample(pool,min(len(pool),random.randint(1,2)))])
    if mode=='dice':
        old=STATE['dice']['currentBid']; total=sum(x['diceCount'] for x in alive_players()); hidden=total-p['diceCount']; wild=STATE['settings']['onesWild']
        def expected(face): return sum(x==face or (wild and face!=1 and x==1) for x in p['dice'])+hidden*(2 if wild and face!=1 else 1)/6
        choices=[(q,f) for q in range(1,total+1) for f in range(1,7) if not old or (q,f)>(old['quantity'],old['face'])]
        if old and (not choices or old['quantity']>expected(old['face'])+random.uniform(.3,1.5)): return _bot_move(p,'dice_challenge')
        if old and STATE['settings']['exactEnabled'] and abs(old['quantity']-expected(old['face']))<.2 and random.random()<.15: return _bot_move(p,'dice_exact')
        if choices:
            viable=[(q,f) for q,f in choices if q<=expected(f)+.65]
            q,f=max(viable,key=lambda z:(expected(z[1])-z[0],z[0],z[1])) if viable else choices[0]
            return _bot_move(p,'dice_bid',quantity=q,face=f)
    if mode=='chuanma':
        hand=p['cmHand']; cm=STATE['chuanma']; counts=Counter(t['suit'] for t in hand)
        if phase=='cm_exchange':
            suit=min((s for s in CM_SUITS if counts[s]>=3),key=lambda s:counts[s]);return _bot_move(p,'cm_exchange',tileIds=[t['id'] for t in hand if t['suit']==suit][:3])
        if phase=='cm_dingque': return _bot_move(p,'cm_dingque',suit=min(CM_SUITS,key=lambda s:counts[s]))
        if phase=='cm_response':
            options=cm['responseOptions'][p['id']]; return _bot_move(p,'cm_respond',choice=next(x for x in ('hu','gang','peng','pass') if x in options))
        if phase=='cm_play' and cm['needsDiscard']:
            if cm_can_win(p): return _bot_move(p,'cm_self_hu')
            gang=cm_self_gang_options(p)
            if gang: return _bot_move(p,'cm_gang',suit=gang[0]['suit'],rank=gang[0]['rank'])
            pool=[t for t in hand if t['suit']==p['cmMissing']] or hand
            tile=min(pool,key=lambda t:(sum(cm_same(t,x) for x in hand),sum(x['suit']==t['suit'] and abs(x['rank']-t['rank'])==1 for x in hand),random.random()))
            return _bot_move(p,'cm_discard',tileId=tile['id'])
    if mode=='draw' and phase=='draw_choose':
        begin_draw_word(0); d=STATE['draw']; strokes=BOT_PICTURES[d['word']]
        d['strokes']=[{'seq':i+1,'color':'#111111','width':7,'erase':False,'points':[[.13+x*.0074,.05+y*.009] for x,y in line]} for i,line in enumerate(strokes)]
        d['strokeSeq']=len(strokes);d['canvasRevision']+=1;bump();return True
    return False

_bot_tick_base=update_timers
_bot_pending=None
_bot_due=0.0

def update_timers():
    global _bot_pending,_bot_due
    _bot_tick_base()
    p=_bot_task()
    if not p: _bot_pending=None;return
    key=(STATE.get('matchId'),STATE['phase'],p['id'],STATE['version'])
    now=time.time()
    if key!=_bot_pending: _bot_pending=key;_bot_due=now+.45;return
    if now>=_bot_due:
        _bot_pending=None;bot_step(p)

# A bot seat must never be claimed by an old guest seat key.
