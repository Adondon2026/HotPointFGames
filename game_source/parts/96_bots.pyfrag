# Rule-based local opponents. The same validated actions are used by humans and bots.
BOT_NAMES = ('小北', '阿南', '小西')

def trim_bots_for_mode(mode):
    limit = 3 if mode == 'ddz' else 4
    humans = sum(not p.get('isBot') for p in STATE['players'])
    bots = [p for p in STATE['players'] if p.get('isBot')]
    keep = min(max(0, limit - humans), 1 if mode == 'draw' else 3)
    for p in bots[keep:]: remove_player(p['id'])

def add_local_bot():
    mode = STATE['mode']
    if len(STATE['players']) >= (3 if mode=='ddz' else 4): return False
    if mode=='draw' and any(p.get('isBot') for p in STATE['players']): return False
    names = {p['name'] for p in STATE['players']}
    name = next(('机器人'+n for n in BOT_NAMES if '机器人'+n not in names), '机器人')
    STATE['players'].append({'id':'bot_'+secrets.token_hex(4),'name':name,'ready':True,'connected':True,'lastSeen':time.time(),'seatKey':'','isBot':True,'life':STATE['settings']['cardLives'],'diceCount':STATE['settings']['diceStart'],'hand':[],'dice':[],'score':0,'ddzHand':[],'ddzScore':0,'ddzHintCursor':0,'cmHand':[],'cmMelds':[],'cmMissing':None,'cmWon':False,'cmScore':0,'cmDrawnId':None,'cmExchange':[]})
    return True

_bot_action_base = Handler.handle_action
def _bot_room_action(self, player, action, data):
    if action in ('add_bot','remove_bot','solo_start'):
        if player['id'] != STATE['hostPlayerId'] or STATE['phase'] != 'lobby': return {'error':'仅房主可在大厅操作机器人'},403
        if action=='add_bot':
            if not add_local_bot(): return {'error':'本游戏机器人座位已满'},409
            bump(); return {},200
        if action=='remove_bot':
            target=player_by_id(str(data.get('targetId','')))
            if not target or not target.get('isBot'): return {'error':'该机器人不存在'},409
            remove_player(target['id']); bump(); return {},200
        if sum(not p.get('isBot') for p in STATE['players'])!=1: return {'error':'单人开局仅在一名真人时可用'},409
        old_ready=player['ready']; player['ready']=True
        if len(STATE['players'])==1 and STATE['mode']!='ddz': add_local_bot()
        result=_bot_action_base(self,player,'start',data)
        if result[1]!=200: player['ready']=old_ready
        return result
    return _bot_action_base(self,player,action,data)
Handler.handle_action=_bot_room_action

# Tiny drawing library for actual offline drawing practice, no pretend image recognition.
# Coordinates use a 0..100 square, scaled into the shared canvas.
def _circle(x,y,r,n=32):
    import math
    return [(x+r*math.cos(i*2*math.pi/n),y+r*math.sin(i*2*math.pi/n)) for i in range(n+1)]

