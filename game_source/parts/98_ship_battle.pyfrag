# The naval mode is an adapter over the existing Siege v24 turn engine.
# No independent projectile solver, buff inventory, damage rules or replay loop.
import math

_NAVAL_MOVE_RADIUS=110.
_NAVAL_PICKUPS=('big','splitshot','repeat','bounce','through','homing','pierce','bounceblast','shield','armor','heal','blackhole','push')

def _naval_world(r):
    """Replace only the fortress geometry with a fixed top-down sea layout."""
    r.update(naval=True,theme='classic',field='naval',fieldLabel='海上对射',mode='classic',wind=0.,windPair=0.,
             windLevel='off',rise=0,offset=0,gunShift=0,terrain=[(0,2500),(960,2500)],
             reflectors=[],gunMotion=[],motionEpoch=time.time(),
             respawns=[],nextItemId=1000,negativePending=[{},{}],armed=[{},{}],
             clones=[],mines=[],gunGravity=[False,False],gunFallV=[0.,0.],
             launchers=[[205.,235.],[755.,235.]],navalMove=None,
             moveRadius=_NAVAL_MOVE_RADIUS,ammo=0,buffMode='auto')
    def body(ident,kind,side,x,y,w,h,hp,**extra):
        return dict(id=ident,kind=kind,side=side,x=float(x),y=float(y),w=w,h=h,
                    hp=float(hp),max=float(hp),vx=0.,vy=0.,fixed=True,**extra)
    r['bodies']=[
        body(0,'core',0,78,235,70,72,100),
        body(1,'core',1,882,235,70,72,100),
        body(2,'cannon',0,205,259,44,48,75),
        body(3,'cannon',1,755,259,44,48,75),
        body(4,'stone',-1,483,91,76,44,110),
        body(5,'stone',-1,477,383,68,48,110)]
    r['nextBodyId']=100
    r['buffs']=_siege_buffs(2);r['compoundRecipes']=[[],[]]
    r['allowedBuffs']=list(_NAVAL_PICKUPS)
    r['items']=_siege_items(13,field={'offset':0,'rise':0,'pool':('big','splitshot','repeat','bounce','through','homing')},allowed=_siege_allowed(r))
    # The center supply sits on the direct sea lane; every other slot is mirrored.
    if r['items']:r['items'][-1].update(x=480.,y=235.)
    return r

def _naval_new(seats):
    bot=bool(seats[1].get('isBot'))
    r=_siege_new(seats[0]['name'],seats[0]['id'],bot,
                 item_count=13,mode='classic',wind_level='off',ammo=0,
                 buff_mode='auto',allowed_buffs=list(_NAVAL_PICKUPS))
    _siege_v24_setup(r,'classic')
    r['naval']=True
    _naval_world(r)
    r.update(code=_ROOM_ACTIVE['code'],
             players=[{'name':p['name'],'key':p['id']} for p in seats],
             phase='play',combatMode='turn',reloadSeconds=0)
    return r

def _naval_move(r,seat,x,y,rev,now):
    if r.get('phase')!='play' or r['turn']!=seat or now<r['until'] or rev!=r['rev']:
        raise ValueError('当前不是你的行动回合')
    if type(x) not in (int,float) or type(y) not in (int,float) or not math.isfinite(x) or not math.isfinite(y):
        raise ValueError('移动位置无效')
    gun=_siege_cannon(r,seat)
    if gun is None:raise ValueError('船只不存在')
    x=float(x);y=float(y);ox,oy=_siege_launcher(seat,r)
    distance=math.hypot(x-ox,y-oy)
    if not 8.<=distance<=_NAVAL_MOVE_RADIUS+1e-6:raise ValueError('只能移动到圆圈内的其他位置')
    if not 45<=x<=915 or not 52<=y<=365:raise ValueError('目标超出可航行水域')
    new_center_y=y+24
    for b in r['bodies']:
        if b is gun or b['hp']<=0:continue
        if abs(x-b['x'])<(gun['w']+b['w'])/2+7 and abs(new_center_y-b['y'])<(gun['h']+b['h'])/2+7:
            raise ValueError('目标位置被船只、礁石或基地占据')
    gun.update(x=x,y=new_center_y,vx=0.,vy=0.)
    r['launchers'][seat]=[x,y]
    r['rev']+=1;r['turn']=1-seat;r['event']=None
    r['navalMove']={'id':r['rev'],'seat':seat,'from':[ox,oy],'to':[x,y],'at':now,'duration':.72}
    r['until']=now+.72
    r['wind']=0.
    return r

def _naval_bot(r):
    """Use Siege's authoritative firing and pickup simulation for the bot too."""
    side=1;gun=_siege_cannon(r,side)
    if not gun or r['phase']!='play' or r['turn']!=side:return
    sx,sy=_siege_launcher(side,r)
    if sum(r['shots'])>1 and (sum(r['shots'])%5==0):
        for dx,dy in ((-68,-44),(-68,44),(-55,0)):
            try:_naval_move(r,side,sx+dx,sy+dy,r['rev'],time.time());return
            except ValueError:pass
    target=_siege_core_body(r['bodies'],0)
    # In Siege's coordinate convention the right side uses negative X for angle 0.
    aim=math.degrees(math.atan2(sy-target['y'],sx-target['x']))%360
    aim=(aim+random.uniform(-7,7))%360
    _siege_fire(r,aim,random.choice((46,55,65)),None,
                config={'simple':True,'unified':True,'delayedSplit':True})

def _ship_request(data):
    """Compatibility endpoint: forward to the existing room Siege handler."""
    if STATE['mode']!='ship' or STATE['phase']!='siege_play':
        return {'ok':False,'error':'海战已结束','roomEnded':True}
    return _room_siege(data)
