                edge=max(b['w']/2,min(960-b['w']/2,b['x']))
                if v24 and edge!=b['x']:
                    outward=(b['x']<edge and b['vx']<0) or (b['x']>edge and b['vx']>0)
                    if outward:
                        hurt(b,_siege_wall_damage(abs(b['vx'])) if b['kind']=='core' else max(0.,abs(b['vx'])-115)*.08,b.get('impactSource'))
                        b['vx']*=-.12
