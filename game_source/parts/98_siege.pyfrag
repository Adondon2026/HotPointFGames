    engineering_done=False;material_done=False
    def schedule_drops(x,y,t,refund=False):
        nonlocal engineering_done,material_done,last_hit,settled
        if unified:return
        if material_done:return
        material_done=True
        if engineering:
            if engineering_done:return
            engineering_done=True
            for kind in (k for k in ('wooddrop','stonedrop') for _ in range(attack_counts.get(k,0))):
                stone=kind=='stonedrop';w=36;h=44 if stone else 38;placed=False
                if sum(bool(b.get('generated')) and b['hp']>0 for b in bodies)<60:
                    desired=max(19,min(941,x))
                    candidates=sorted(set(max(19,min(941,desired+d)) for d in range(-100,101,10)),key=lambda xx:(abs(xx-desired),xx))
                    for xx in candidates:
                        supports=[b for b in bodies if b['hp']>0 and abs(b['x']-xx)<(b['w']+w)/2]
                        floor=min(_siege_floor(r,z) for z in (xx-w/2,xx,xx+w/2))
                        top=min([floor]+[b['y']-b['h']/2 for b in supports])
                        if any(b['kind']=='core' and abs(b['y']-b['h']/2-top)<1 for b in supports):continue
                        yy=top-h/2
                        if yy-h/2<0:continue
                        if any(b['hp']>0 and abs(b['x']-xx)<(b['w']+w)/2-.01 and abs(b['y']-yy)<(b['h']+h)/2-.01 for b in bodies):continue
                        if any(abs(_siege_launcher(i,r,motion_start+t)[0]-xx)<(w+52)/2 and abs(_siege_launcher(i,r,motion_start+t)[1]-yy)<(h+96)/2 for i in (0,1)):continue
                        hp=75 if stone else 42;ident=r.get('nextBodyId',100);r['nextBodyId']=ident+1
                        bodies.append(dict(id=ident,side=side,x=xx,y=yy,w=w,h=h,kind='stone' if stone else 'wood',hp=hp,max=hp,vx=0.,vy=0.,generated=True))
                        drop_events.append([ident,round(xx,1),round(yy,1),round(t,3)]);placed=True;last_hit=t;settled=0;break
                if not placed:r['buffs'][side][kind]+=1
            return
        kinds=[k for k in ('wooddrop','stonedrop') for _ in range(attack_counts.get(k,0))]
        free=max(0,60-sum(b.get('generated',False) and b['hp']>0 for b in bodies)-(sum(map(len,live['dropQueues'].values())) if live is not None else len(drop_queue)))
        for k in kinds[free:]:r['buffs'][side][k]+=1
        for j,k in enumerate(kinds[:free]):drop_queue.append((t+.15+j*.52,k,max(19,min(941,x)),min(-100,y-250)))
        drop_queue.sort()
    def child_deadline(born,parent=None):
        if not child_counts.get('fuse') or fuse_mode=='delay':return None
        if config['childFuseTime']:return born+config['childFuseTime']
        if fuse:return fuse_time if parent is None else parent.get('fuseAt',parent.get('bornAt',0)+fuse_time)
        return born+fuse_time
    copy_rng=random.Random((r['rev']+1)*100003+side*997+int(angle*100)+int(power*100))
    def spawn_children(x,y,svx,svy,count,pattern='fan',parent=None,terminal=False,unified_split=False):
        nonlocal next_child
        born=0
        for j in range(count):
            if len(fragments)>=120:break
            a=(j-(count-1)/2)*100
            if unified_split and pattern=='fan':
                ang=math.atan2(svy,svx)+(j-(count-1)/2)*.19;vel=max(220.,math.hypot(svx,svy));ux,uy=vel*math.cos(ang),vel*math.sin(ang)
            elif pattern=='fan':ux,uy=svx+direction*a,svy+a*.35
            elif pattern=='down':ux,uy=svx*.15+a*.25,220.
            elif pattern=='trail':ux,uy=-svx*.28,120.
            elif pattern in ('radial','chaos'):
                ang=2*math.pi*j/max(1,count) if pattern=='radial' else copy_rng.uniform(-math.pi,math.pi)
                ux,uy=math.cos(ang)*260,math.sin(ang)*260
            else:ux,uy=svx,svy
            if unified_split:
                x0=max(radius+.2,min(960-radius-.2,x));y0=min(_siege_floor(r,x0)-radius-.2,y)
            else:x0,y0=x,y
            f=dict(id=next_child,x=x0,y=y0,vx=ux,vy=uy,live=True,groundLeft=child_counts.get('bounce',0),passed=set(),bornAt=t+dt,scale=(parent.get('scale',1.) if parent else 1.)/count if unified_split else .25 if terminal else .42 if pattern=='fan' else .28,kind='split' if unified_split else 'terminal' if terminal else 'larpa',travel=0.,splitDone=True,fuseAt=(t+dt+fuse_time if child_counts.get('fuse') and fuse_mode!='delay' else None) if unified_split else child_deadline(t+dt,parent))
            if v24 and unified_split:
                root_index=parent.get('rootIndex',parent['id']-99) if parent else 0
                f['landingRank']=root_index*count+j
            if pattern=='orbit':
                f['orbit']=2*math.pi*j/max(1,count);f['x']=max(radius,min(960-radius,x+math.cos(f['orbit'])*(radius+22)));f['y']=y+math.sin(f['orbit'])*(radius+22)
            fragments.append(f)
            next_child+=1;born+=1
        if born:behavior_events.append(['spawn',round(t,3),round(x,1),round(y,1),born,'secondary' if terminal else pattern])
        return born
    arc_buddies_pending=attack_counts.get('firearc',0) if not unified and config.get('simple') and not any(attack_counts.get(k) for k in ('splitshot','repeat','larpa','downpour')) else 0
    def split_now(event,x,y,svx,svy,parent=None):
        nonlocal split_done
        if unified:return False
        rule=next((rule for rule in spec['events'] if rule['effect']=='split' and rule['event']==event),None)
        if not rule or (split_done if parent is None else parent.get('splitDone',False)):return False
        if parent is None:split_done=True
        else:parent['splitDone']=True
        spawn_children(x,y,svx,svy,rule['count'],'fan',parent)
        return True
    def bounce_effect(x,y,svx,svy,parent=None,target=None,incident=None):
        nonlocal larpa_left,bounce_blast_left,last_hit,settled
        if unified:
            evx,evy=incident if v24 and incident is not None else (svx,svy)
            # Ricochets transfer kinetic damage to the contacted body, without
            # consuming the shell or creating the separate blast buff's AoE.
            if v24 and target and target['hp']>0 and not target.get('platform') and not engineering:
                counts=root_counts if parent is None or parent.get('kind') in ('repeat','clone') else child_counts
                scale=parent.get('scale',1.) if parent else 1.
                travel=parent.get('travel',0.) if parent else flight_distance
                damage=28*damage_for(counts)*scale*_siege_v20_vanish(travel,negatives)
                if target['kind']=='stone' or (target['kind']=='zombie' and target.get('zombieType') in ('shield','heavy','giant')):damage*=1+1.5*counts.get('pierce',0)
                if target['kind']=='core':damage*=.83
                if target['kind'] not in _SIEGE_TNT_KINDS:
                    hurt(target,damage);last_hit=t;settled=0
                    behavior_events.append(['bounceHit',round(t,3),round(x,1),round(y,1),target['id']])
            dispatch_event('bounce',x,y,evx,evy,parent,target);return
        # Only source shells trigger replication; a copied shell cannot recurse.
        if parent is not None:
            parent.pop('orbit',None)
            if parent.get('kind') not in ('repeat','clone'):return
        if bounce_blast_left:
            bounce_blast_left-=1;blast(x,y,None,.23,min(28,blast_radius),extras=False)
            fragment_hits.append([round(x,1),round(y,1),round(t,3)]);last_hit=t
            behavior_events.append(['bounceBlast',round(t,3),round(x,1),round(y,1)])
        if larpa_left and copy_mode=='bounce':
            n=spawn_children(x,y,svx,svy,min(2,larpa_left),'fan',parent);larpa_left-=n
        if (split_now('bounce',x,y,svx,svy,parent) or split_now('hit',x,y,svx,svy,parent)) and config['parentEnd']!='continue':
            if parent is None:finish_main(x,y,explode=config['parentEnd']=='explode')
            else:finish_fragment(parent,x,y,explode=config['parentEnd']=='explode')
    def deploy_mines(x,y):
        nonlocal mine_left
        if unified:return
        if not mine_left:return
        current=sum(r['shots'])+(0 if live is not None else 1)
        count=min(mine_left,max(0,12-sum(m['side']==side for m in r['mines'])))
        r['buffs'][side]['mine']+=mine_left-count;mine_left=0
        for j in range(count):
            mx=max(10,min(950,x+(j-(count-1)/2)*19));my=min(_siege_floor(r,mx)-8,y)
            ident=r.get('nextMineId',1);r['nextMineId']=ident+1
            m=dict(id=ident,x=round(mx,1),y=round(my,1),side=side,armedAfter=current,expiresAfter=current+8)
            r['mines'].append(m);mine_events.append(['place',round(t,3),dict(m)])
    def trigger_mines(x,y,rr):
        nonlocal last_hit
        if engineering:return
        current=sum(r['shots'])+(0 if live is not None else 1)
        for m in list(r['mines']):
            if current>m['expiresAfter']:
                r['mines'].remove(m);mine_events.append(['remove',round(t,3),m['id']]);continue
            if current<=m['armedAfter'] or math.hypot(x-m['x'],y-m['y'])>26+rr:continue
            r['mines'].remove(m);mine_events.append(['detonate',round(t,3),m['id']])
            for b in bodies:
                if b['hp']<=0:continue
                dx=b['x']-m['x'];dy=b['y']-m['y'];d=math.hypot(dx,dy)
                if d<46:
                    hurt(b,16*(1-d/46))
                    if not b.get('fixed'):b['vx']+=dx/max(8,d)*60;b['vy']-=45
            fragment_hits.append([m['x'],m['y'],round(t,3)]);last_hit=t
    def deflect(x,y,svx,svy,rr):
        if live is None:return x,y,svx,svy
        fields=list(live.get('shellShields',{}).get(1-side,{}).values())
        legacy=live.get('shotShields',{}).get(1-side)
        if legacy:fields.append(legacy)
        fields=[sh for sh in fields if sh['left']>0 and math.hypot(x-sh['x'],y-sh['y'])<sh['radius']+rr]
        if not fields:return x,y,svx,svy
        sh=min(fields,key=lambda sh:math.hypot(x-sh['x'],y-sh['y']))
        dx=x-sh['x'];dy=y-sh['y'];d=math.hypot(dx,dy);reach=sh['radius']+rr
        if d>=reach:return x,y,svx,svy
        if d<.01:dx,dy=-direction,0.;d=1.
        nx,ny=dx/d,dy/d;v=svx*nx+svy*ny
        sh['left']-=1
        behavior_events.append(['shieldDeflect',round(t,3),round(x,1),round(y,1)])
        return sh['x']+nx*(reach+1),sh['y']+ny*(reach+1),svx+nx*(80-2*min(0,v)),svy+ny*(80-2*min(0,v))
    # Shared payload dispatch. Event counts are independent of the object budget;
    # a full budget never prevents a later valid event from contributing to refunds.
    event_counts={k:0 for k in _SIEGE_PAYLOADS};generated_counts={k:0 for k in _SIEGE_OBJECT_LIMITS}
    triggered=set();main_apex=False;main_rising=False;main_launched=False;main_split_at=None
    def generate_payload(k,n,x,y,target=None,scale=1.):
        nonlocal last_hit,settled
        event_counts[k]+=1
        limit=_SIEGE_OBJECT_LIMITS[k]
        for j in range(n):
            if generated_counts[k]>=limit:break
            if k in ('wooddrop','stonedrop'):
                stone=k=='stonedrop';w=36;h=44 if stone else 38
                if sum(bool(b.get('generated')) and b['hp']>0 and b['kind'] in ('wood','stone') for b in bodies)+sum(q[1] in ('wooddrop','stonedrop') for qs in (live['dropQueues'].values() if live is not None else [drop_queue]) for q in qs)>=60:break
                xx=max(19,min(941,x+(j-(n-1)/2)*37))
                if engineering:
                    placed=False
                    for dx in sorted(range(-100,101,10),key=abs):
                        xx=max(19,min(941,x+(j-(n-1)/2)*37+dx))
                        supports=[b for b in bodies if b['hp']>0 and abs(b['x']-xx)<(b['w']+w)/2]
                        top=min([_siege_floor(r,xx-w/2),_siege_floor(r,xx),_siege_floor(r,xx+w/2)]+[b['y']-b['h']/2 for b in supports])
                        yy=top-h/2
                        if yy-h/2<0 or any(b['kind']=='core' and abs(b['y']-b['h']/2-top)<1 for b in supports):continue
                        if any(abs(_siege_launcher(i,r,motion_start+t)[0]-xx)<(w+52)/2 and abs(_siege_launcher(i,r,motion_start+t)[1]-yy)<(h+96)/2 for i in (0,1)):continue
                        hp=75 if stone else 42;ident=r.get('nextBodyId',100);r['nextBodyId']=ident+1
                        bodies.append(dict(id=ident,side=side,x=xx,y=yy,w=w,h=h,kind='stone' if stone else 'wood',hp=hp,max=hp,vx=0.,vy=0.,generated=True))
                        drop_events.append([ident,round(xx,1),round(yy,1),round(t,3)]);placed=True;last_hit=t;settled=0;break
                    if not placed:continue
                else:
                    drop_queue.append((t+.12+j*.07,k,xx,min(y-30,_siege_floor(r,xx)-h-5)));drop_queue.sort()
            elif v24 and k in _SIEGE_TNT_KEYS:
                if sum(generated_counts[q] for q in _SIEGE_TNT_KEYS)>=_SIEGE_TNT_SHOT_CAP:break
                if k=='tntwait' and sum(b['hp']>0 and b['kind']=='tnt_wait' and b['side']==side for b in bodies)+sum(q[1]=='tntwait' for q in drop_queue)>=_SIEGE_TNT_WAIT_CAP:break
                xx=max(15,min(945,x+(j-(n-1)/2)*28))
                drop_queue.append((t+.12+j*.07,k,xx,min(y-30,_siege_floor(r,xx)-29)));drop_queue.sort()
            elif k=='mine':
                if sum(m['side']==side for m in r['mines'])>=12:break
                current=sum(r['shots'])+(0 if live is not None else 1)
                mx=max(10,min(950,x+(j-(n-1)/2)*19));my=min(_siege_floor(r,mx)-8,y)
                ident=r.get('nextMineId',1);r['nextMineId']=ident+1
                m=dict(id=ident,x=round(mx,1),y=round(my,1),side=side,armedAfter=current,expiresAfter=current+8)
                r['mines'].append(m);mine_events.append(['place',round(t,3),dict(m)])
            elif k=='clone':
                if sum(c['side']==side for c in r['clones'])>=20:break
                ident=r.get('nextCloneId',0);r['nextCloneId']=ident+1
                xx=max(45,min(915,x+(j-(n-1)/2)*24));r['clones'].append(dict(id=ident,side=side,x=xx,y=min(_siege_floor(r,xx)-24,y),remaining=2))
            elif k=='blackhole':
                # One field per event, with level determining intensity, not overlapping identical fields.
                if len(holes)>=12:break
                holes.append([round(x,1),round(y,1),round(t,3),n]+([scale] if v24 else []))
                if v24:behavior_events.append(['blackholeStart',round(t,3),round(x,1),round(y,1),120+22*n])
                if config['blackholeMode']=='attached' and target and target['hp']>0:hole_anchors[len(holes)-1]=(target['id'],x-target['x'],y-target['y'])
                generated_counts[k]+=1;break
            generated_counts[k]+=1
        if k in _SIEGE_OBJECT_LIMITS and generated_counts[k]:triggered.add(k)
    def dispatch_event(event,x,y,svx,svy,parent=None,target=None):
        nonlocal split_done,impact,hit_at,last_hit,px,py,teleport_target,main_split_at,settled
        if not unified:return False
        counts=root_counts if parent is None or parent.get('kind') in ('repeat','clone') else child_counts
        scale=parent.get('scale',1.) if parent else 1.
        kind=parent.get('kind','split') if parent else 'main'
        if v24 and event in ('bounce','through','end') and target:
            if attack_counts.get('salvage') and 'salvage' not in elite_used and target['kind'] in ('wood','stone'):recover_material(x,y)
            if target['kind'] in _SIEGE_TNT_KINDS:_siege_tnt_arm(target,world_now(),side)
            if counts.get('push'):
                _siege_v24_push(target,svx,svy,counts['push'],scale)
                if target.get('pushTime',0)>0:
                    target['impactSource']=side;settled=0
                    behavior_events.append(['pushHit',round(t,3),round(x,1),round(y,1),target['id']])
        for k in _SIEGE_PAYLOADS:
            if v24 and k in ('wooddrop','stonedrop',*_SIEGE_TNT_KEYS):continue
            if k=='splitshot' or not counts.get(k) or (event not in ('bounce','through','end') if v24 else _siege_event_for(config,k)!=event):continue
            if k in _SIEGE_OBJECT_LIMITS:
                if k=='clone' and kind=='clone':continue
                generate_payload(k,counts[k],x,y,target,scale)
            elif k=='bounceblast':
                # Explicit blast payload is extra attack, scaled by shell's allocated strength.
                event_counts[k]+=1;n=counts[k];br=38+9*n+(0 if v24 else 12*counts.get('big',0))
                if v24:
                    physical_blast(x,y,br,8+3*n,8+3*n,170+75*n,scale)
                else:
                    blast(x,y,None,scale*(.45+.12*n),br,shell_kind=kind,extras=False)
                    behavior_events.append(['bounceBlast',round(t,3),round(x,1),round(y,1),br]);last_hit=t
                triggered.add(k)
            elif k=='ignite':
                event_counts[k]+=1;ignite_at(x,y,55+12*counts[k],counts[k]);triggered.add(k)
        n=counts.get('splitshot',0)
        split_event=config['triggers'].get('splitshot','launch') if v24 else _siege_event_for(config,'splitshot')
        if v24 and n:n=2**n
        if not n or (split_event!=event and not (event=='bounceRelease' and split_event=='bounce')) or (split_done if parent is None else parent.get('splitDone',False)):return False
        if event=='bounce' and config['delayedSplit']:
            if parent is None:
                if main_split_at is None:main_split_at=t+.10
            elif 'splitAt' not in parent:parent['splitAt']=t+.10
            return False
        if event=='bounceRelease':event='bounce'
        if len(fragments)+n>120:return False
        if parent is None:split_done=True
        else:parent['splitDone']=True
        # Terminal children start at the contact, moving into the target when
        # through is available, otherwise away from an obstructing surface.
        if event=='end' and not v24:
            if target is None:
                if x<=radius+1:svx=abs(svx)
                elif x>=960-radius-1:svx=-abs(svx)
                elif y>=_siege_floor(r,x)-radius-1:svy=-max(180,abs(svy)*.8)
            elif not counts.get('through'):
                x,y,svx,svy=_siege_box_bounce(target,x-svx*dt,y-svy*dt,x,y,svx,svy,radius)
            elif math.hypot(svx,svy)<1:svx=direction*220.
        if spawn_children(x,y,svx,svy,n,config['splitPattern'],parent,unified_split=True)!=n:return False
        triggered.add('splitshot');event_counts['splitshot']+=1
        behavior_events.append(['split',round(t,3),round(x,1),round(y,1),n,scale/n,event])
        if parent is None:
            px,py=x,y;impact=[round(x,1),round(y,1)];hit_at=t;last_hit=t;teleport_target=(x,y)
            behavior_events.append(['finish',round(t,3),round(x,1),round(y,1),False])
            if live is not None:live.get('shotShields',{}).pop(side,None)
            frames.append(snap(t,None))
        else:parent['live']=False;last_hit=t
        return True
    own_landings=[];elite_used=set()
    def recover_material(x,y):
        if attack_counts.get('salvage') and 'salvage' not in elite_used:
            recovered=set()
            for b in bodies:
                if b['hp']<=0 or b.get('platform') or b['kind'] not in ('wood','stone'):continue
                # Recycle real material on either side, including original fortifications.
                dist=math.hypot(max(0.,abs(b['x']-x)-b['w']/2),max(0.,abs(b['y']-y)-b['h']/2))
                if dist<=110:
                    recovered.add('wooddrop' if b['kind']=='wood' else 'stonedrop');b['hp']=0.;b['vx']=b['vy']=0.
            if recovered:
                elite_used.add('salvage');behavior_events.append(['salvage',round(t,3),round(x,1),round(y,1),110])
                for k in recovered:r['buffs'][side][k]=min(_siege_cap(r,k),r['buffs'][side][k]+1)
    def landing_payloads(x,y,parent=None):
        if not v24:return
        # Each elite charge triggers at most once per shot, not per fragment.
        if attack_counts.get('demolish') and 'demolish' not in elite_used:
            elite_used.add('demolish');level=attack_counts['demolish'];reach=100+30*(level-1);behavior_events.append(['bounceBlast',round(t,3),round(x,1),round(y,1),reach])
            in_range=[]
            for b in bodies:
                if b['hp']<=0 or b.get('platform'):continue
                dist=math.hypot(max(0.,abs(b['x']-x)-b['w']/2),max(0.,abs(b['y']-y)-b['h']/2))
                if dist>=reach:continue
                if b['kind'] in ('wood','stone') and b['side']!=side:
                    hurt(b,125*level*(1-dist/(reach+25)),side)
                if r.get('theme')=='zombie' and b['kind']=='zombie':
                    in_range.append((b,dist))
            if in_range:
                # Structural demolition strips the shield-carrier redirect and
                # heavy armor BEFORE applying its specialized breaching damage.
                for b,_ in in_range:b['sunderRounds']=max(2,b.get('sunderRounds',0))
                for b,dist in in_range:
                    if b['hp']<=0:continue
                    reinforced=b.get('zombieType') in ('guard','shield','heavy','giant','siegecar','engineer')
                    damage=(38+28*level)*(1-dist/(reach+25))*(1.75 if reinforced else .65)
                    hurt(b,damage,side)
                behavior_events.append(['sunder',round(t,3),round(x,1),round(y,1),reach])
        recover_material(x,y)
        if 0<=x<=960:own_landings.append((x,y))
        counts=root_counts if parent is None or parent.get('kind')=='repeat' else child_counts
        for k in ('wooddrop','stonedrop'):
            if counts.get(k):generate_payload(k,counts[k],x,y)
        rank=0 if parent is None else parent.get('landingRank',parent['id']-99)
        if 0<=rank<len(tnt_alloc):
            for k,n in tnt_alloc[rank].items():generate_payload(k,n,x,y)
    def finish_main(x,y,target=None,explode=True):
        nonlocal impact,hit_at,last_hit,teleport_target,px,py,larpa_left
        if impact is not None:return
        if unified and dispatch_event('end',x,y,vx,vy,target=target):return
        if larpa_left and copy_mode=='expire':larpa_left-=spawn_children(x,y,vx,vy,larpa_left,'radial')
        if split_now('expire',x,y,vx,vy) and config['parentEnd']=='vanish':explode=False
        px,py=x,y;impact=[round(x,1),round(y,1)];hit_at=t;last_hit=t;teleport_target=(x,y)
        if explode:blast(x,y,target,_siege_v20_vanish(flight_distance,negatives),dive_strike=bool(config.get('simple') and main_dived and (vy>0 or main_stop is not None)))
        landing_payloads(x,y)
        schedule_drops(x,y,t,True)
        deploy_mines(x,y)
        if live is not None:live.get('shotShields',{}).pop(side,None)
        frames.append(snap(t,[round(x,1),round(y,1)]))
        behavior_events.append(['finish',round(t,3),round(x,1),round(y,1),explode])
    def finish_fragment(f,x,y,target=None,explode=True):
        nonlocal last_hit
        if not f['live']:return
        if unified and dispatch_event('end',x,y,f['vx'],f['vy'],f,target):return
        if f.get('kind')=='repeat' and split_now('expire',x,y,f['vx'],f['vy'],f) and config['parentEnd']=='vanish':explode=False
        f['live']=False;last_hit=t
        if explode:
            dmg=f.get('scale',.42)*_siege_v20_vanish(f.get('travel',0),negatives)
            blast(x,y,target,dmg,blast_radius,(f['vx'],f['vy']),f.get('kind','split'),extras=True,dive_strike=bool(config.get('simple') and f.get('dived') and (f['vy']>0 or f.get('stop'))))
            extra_blasts.append([round(x,1),round(y,1)]);fragment_hits.append([round(x,1),round(y,1),round(t,3)])
        landing_payloads(x,y,f)
        schedule_drops(x,y,t)
    def attach(x,y,target):
        return (target['id'] if target else None,x-(target['x'] if target else 0),y-(target['y'] if target else 0),t)
    def attached_pos(stop,x,y):
        ident,dx,dy,_=stop
        if ident is None:return dx,dy
        target=next((b for b in bodies if b['id']==ident and b['hp']>0),None)
        return (target['x']+dx,target['y']+dy) if target else (x,y)
    def collide():
        live=[b for b in bodies if b['hp']>0]
        for _ in range(4):
            for b in live:
                if b['hp']<=0 or b.get('fixed'):continue
                floor=_siege_floor_body(r,b['x'],b['w'])-b['h']/2
                if b['y']>floor:
                    if b['vy']>115:hurt(b,(b['vy']-115)*.08,b.get('impactSource'))
                    b['y']=floor;b['vy']=0
