                                hurt(z,(closing-95)*.10*min(1.7,other/(z['w']*z['h'])))
    def collect(x,y,radius,t):
        for item in list(r['items']):
            ix,iy=_siege_item_pos(item,motion_start+t)
            if math.hypot(x-ix,y-iy)<=item['r']+radius:
                pickups.append({**item,'x':ix,'y':iy,'at':round(t,3),'side':side});r['items'].remove(item)
                if item['kind']=='heal':
                    core=next(b for b in bodies if b['side']==side and b['kind']=='core')
                    gain=min(18*item.get('amount',1),max(0,core['max']-core['hp'])) if core['hp']>0 else 0
                    core['hp']+=gain;pickups[-1]['healed']=gain
                else:r['buffs'][side][item['kind']]+=item.get('amount',1)
                if 'slot' in item:r.setdefault('respawns',[]).append({**item,'readyAt':sum(r['shots'])+5})
    for step in range(1,1081):
        t=step*dt
        _siege_motion(r,motion_start+t)
        if impact is None and t>=10:
            impact=[round(px,1),round(py,1)];hit_at=t;last_hit=t
        if impact is None:
            # The two child shells branch in the air, not at an invented impact point.
            if 'splitshot' in attacks and not split_done and (t>=.45 or (t>=.20 and vy>=0)):
                split_done=True
                for i,delta in enumerate([v for j in range(1,attack_counts['splitshot']+1) for v in (-100*j,100*j)]):
                    fragments.append({'id':i,'x':px,'y':py,'vx':vx+direction*delta,'vy':vy+delta*.35,'live':True,'groundLeft':attack_counts.get('bounce',0),'passed':set()})
            oldx,oldy=px,py;px+=vx*dt;py+=vy*dt;vy+=_SIEGE_GRAV*dt;vx+=wind*dt
            target=None
            # Sweep small segments to prevent tunneling through thin beams.
            for k in range(1,5):
                x=oldx+(px-oldx)*k/4;y=oldy+(py-oldy)*k/4
                contact=_siege_reflect(r,oldx,oldy,x,y,vy-_SIEGE_GRAV*dt,radius)
                if contact:
                    px,py=contact;vy=-vy*.88;vx*=.97;bounces.append([round(px,1),round(py,1),round(t,3),-1]);frames.append(snap(t,[round(px,1),round(py,1)]));break
                collect(x,y,radius,t)
                target=next((b for b in bodies if b['hp']>0 and b['id'] not in passed and abs(x-b['x'])<=b['w']/2+radius and abs(y-b['y'])<=b['h']/2+radius),None)
                if target and 'through' in attacks and len(passed)<attack_counts['through'] and target['kind']!='core' and not target.get('platform'):
                    hurt(target,24*damage_scale);passed.add(target['id']);target=None
                if target and ground_left>0:
                    ground_left-=1;px,py,vx,vy=_siege_box_bounce(target,oldx,oldy,x,y,vx,vy,radius);bounces.append([round(px,1),round(py,1),round(t,3),-1]);frames.append(snap(t,[round(px,1),round(py,1)]));break
                if not target and 0<=x<=960 and y>=_siege_floor(r,x)-radius and vy>0 and ground_left>0:
                    ground_left-=1;px=x;py=_siege_floor(r,x)-radius-.2;vy=-max(135,vy*.76);vx*=.86;bounces.append([round(px,1),round(py,1),round(t,3),-1]);frames.append(snap(t,[round(px,1),round(py,1)]));break
                if target or y>=_siege_floor(r,x)-radius or x<0 or x>960:
                    px,py=x,y;impact=[round(x,1),round(y,1)];hit_at=t;last_hit=t
                    if target or y>=_siege_floor(r,x)-radius:
                        blast(x,y,target)
                        schedule_drops(x,y,t,True)
                        teleport_target=(x,y)
                    frames.append(snap(t,[round(x,1),round(y,1)]));break
        for f in fragments:
            if not f['live']:continue
            if t>=10:f['live']=False;continue
            ox,oy=f['x'],f['y'];f['x']+=f['vx']*dt;f['y']+=f['vy']*dt;f['vy']+=_SIEGE_GRAV*dt;f['vx']+=wind*dt
            for k in range(1,5):
                x=ox+(f['x']-ox)*k/4;y=oy+(f['y']-oy)*k/4
                contact=_siege_reflect(r,ox,oy,x,y,f['vy']-_SIEGE_GRAV*dt,fragment_radius)
                if contact:
                    f['x'],f['y']=contact;f['vy']=-f['vy']*.88;f['vx']*=.97;bounces.append([round(contact[0],1),round(contact[1],1),round(t,3),f['id']]);break
                collect(x,y,fragment_radius,t)
                target=next((b for b in bodies if b['hp']>0 and b['id'] not in f['passed'] and abs(x-b['x'])<=b['w']/2+fragment_radius and abs(y-b['y'])<=b['h']/2+fragment_radius),None)
                if target and 'through' in attacks and len(f['passed'])<attack_counts['through'] and target['kind']!='core' and not target.get('platform'):
                    hurt(target,24*damage_scale*.42);f['passed'].add(target['id']);target=None
                if target and f['groundLeft']>0:
                    f['groundLeft']-=1;f['x'],f['y'],f['vx'],f['vy']=_siege_box_bounce(target,ox,oy,x,y,f['vx'],f['vy'],fragment_radius);bounces.append([round(f['x'],1),round(f['y'],1),round(t,3),f['id']]);break
                if not target and 0<=x<=960 and y>=_siege_floor(r,x)-fragment_radius and f['vy']>0 and f['groundLeft']>0:
                    f['groundLeft']-=1;f['x']=x;f['y']=_siege_floor(r,x)-fragment_radius-.2;f['vy']=-max(135,f['vy']*.76);f['vx']*=.86;bounces.append([round(x,1),round(f['y'],1),round(t,3),f['id']]);break
                if target or y>=_siege_floor(r,x)-fragment_radius or x<0 or x>960:
                    f['live']=False;last_hit=t
                    if target or (0<=x<=960 and y>=_siege_floor(r,x)-fragment_radius):
                        blast(x,y,target,.42,blast_radius);schedule_drops(x,y,t);extra_blasts.append([round(x,1),round(y,1)]);fragment_hits.append([round(x,1),round(y,1),round(t,3)])
                    break
        while drop_queue and t>=drop_queue[0][0]:
            _,kind,x,y=drop_queue.pop(0);stone=kind=='stonedrop';hp=75 if stone else 42
            ident=r.get('nextBodyId',100);r['nextBodyId']=ident+1
            bodies.append(dict(id=ident,side=side,x=x,y=y,w=36,h=44 if stone else 38,kind='stone' if stone else 'wood',hp=hp,max=hp,vx=0.,vy=0.,generated=True,falling=True))
            drop_events.append([ident,round(x,1),round(y,1),round(t,3)]);last_hit=t;settled=0
        if last_hit is not None:
            # A finite, softened pull. Nothing is deleted by the black hole.
            for hx,hy,ht,level in holes:
                if not ht<=t<ht+2:continue
                for b in bodies:
                    if b['hp']<=0 or b.get('platform'):continue
                    dx=hx-b['x'];dy=hy-b['y'];dist=math.hypot(dx,dy)
                    if dist>120+22*level or dist<14:continue
                    if b.get('fixed'):
                        if b['kind']=='core' or not b.get('floatFort'):continue
                        b.pop('fixed',None);b.pop('motionY',None);b.pop('floatFort',None)
                    accel=(130+105*level)*(1-dist/(120+22*level))
                    b['vx']+=dx/dist*accel*dt;b['vy']+=(dy/dist*accel-350)*dt
                    b['vx']=max(-350,min(350,b['vx']));b['vy']=max(-350,min(350,b['vy']))
            for b in bodies:
                if not b.get('falling') or b['hp']<=0:continue
                bottom=b['y']+b['h']/2;next_bottom=bottom+(b['vy']+_SIEGE_GRAV*dt)*dt
                contacts=[c for c in bodies if c is not b and c['hp']>0 and abs(c['x']-b['x'])<(c['w']+b['w'])/2 and bottom<=c['y']-c['h']/2+1 and next_bottom>=c['y']-c['h']/2]
                c=min(contacts,key=lambda c:c['y']-c['h']/2) if contacts else None
                floor=_siege_floor(r,b['x'])
                if c or next_bottom>=floor:
                    b['y']=(c['y']-c['h']/2 if c else floor)-b['h']/2;b['vy']=0.;b['falling']=False;last_hit=t
                    if c and not c.get('generated'):hurt(c,(22 if b['kind']=='stone' else 12) if c['kind']=='core' else (8 if b['kind']=='stone' else 4))
            for b in bodies:
                if b['hp']<=0 or b.get('fixed'):continue
                b['vy']+=_SIEGE_GRAV*dt;b['x']+=b['vx']*dt;b['y']+=b['vy']*dt;b['vx']*=.994
            collide()
            active=max((abs(b['vx'])+abs(b['vy']) for b in bodies if b['hp']>0),default=0)
            settled=settled+1 if active<14 else 0
        if step%4==0:frames.append(snap(t,[round(px,1),round(py,1)] if impact is None else None))
        if impact is not None and not drop_queue and not any(b.get('falling') and b['hp']>0 for b in bodies) and not any(f['live'] for f in fragments) and not any(t<h[2]+2 for h in holes) and t-last_hit>1.1 and (settled>=18 or t-last_hit>=2.7):break
    # Relocate one entity once at the final main-shell impact, never heal or overlap.
    for kind in _SIEGE_ONE_SHOT:
        if not attack_counts.get(kind):continue
        core=next(b for b in bodies if b['side']==side and b['kind']=='core')
        old=_siege_launcher(side,r,motion_start+t) if kind=='gunteleport' else (core['x'],core['y'])
        if teleport_target is None or core['hp']<=0:
            r['buffs'][side][kind]+=1;continue
        desired=teleport_target[0];lo,hi=(45,430) if side==0 else (530,915)
        w,h=(90,96) if kind=='gunteleport' else (core['w'],core['h'])
        for x in sorted(range(lo,hi+1,5),key=lambda x:abs(x-desired)):
            y=_siege_floor(r,x)-(48 if kind=='gunteleport' else h/2)
            if any(b['hp']>0 and (kind=='gunteleport' or b is not core) and abs(x-b['x'])<(w+b['w'])/2+3 and abs(y-b['y'])<(h+b['h'])/2+3 for b in bodies):continue
            if kind=='coreteleport' and abs(x-_siege_launcher(side,r,motion_start+t)[0])<50:continue
            if kind=='gunteleport':
                r.setdefault('launchers',[list(_siege_launcher(i,r,motion_start+t)) for i in (0,1)])
                r['launchers'][side]=[x,y]
                if r.get('gunMotion'):r['gunMotion'][side]={'amplitude':0,'phase':0}
            else:
                core.update(x=x,y=y,vx=0.,vy=0.);core.pop('fixed',None);core.pop('motionY',None);core.pop('floatFort',None)
            teleports.append([kind,side,*old,x,y,round(t,3)]);break
        else:r['buffs'][side][kind]+=1
    for b in bodies:b['vx']=b['vy']=0.
    frames.append(snap(t,None));r['shots'][side]+=1;r['rev']+=1
    refreshed=_siege_refill(r)
    cores=[_siege_core(bodies,i) for i in (0,1)]
    ammo=r.get("ammo",_SIEGE_MAX_SHOTS)
    if min(cores)<=0 or (ammo and all(n>=ammo for n in r['shots'])):
        r['phase']='over';r['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0])
    else:
        r['turn']=1-side
        if r['turn']==0:r['windPair']=_siege_weather(r.get('windLevel','off'))
        r['wind']=r.get('windPair',0)*(1 if r['turn']==0 else -1)
    r['event']={'id':r['rev'],'side':side,'frames':frames,'impact':impact,'hitAt':hit_at,'hitId':hit_id,'duration':t,'cores':cores,'itemsBefore':items_before,'buffsBefore':buffs_before,'pickups':pickups,'attacks':attacks,'defenses':defenses,'attackCounts':attack_counts,'defenseCounts':defense_counts,'armedBefore':armed_before,'selected':chosen,'radius':radius,'blastRadius':blast_radius,'wind':wind,'motionStart':motion_start,'extraBlasts':extra_blasts,'fragmentHits':fragment_hits,'passed':list(passed),'refreshed':refreshed,'bounces':bounces,'drops':drop_events,'holes':holes,'teleports':teleports,'angle':angle,'fragmentRadius':fragment_radius,'launchersBefore':launchers_before,'gunMotionBefore':gun_motion_before,'launchersBase':[list(x) for x in r.get('launchers',[])],'gunMotion':r.get('gunMotion',[])}
    r['until']=time.time()+t+.35

def _siege_bot_fire(r,a,p):
    selection={k:min(1 if k in _SIEGE_ONE_SHOT else 2,n) for k,n in r['buffs'][1].items() if n>0 and k in _SIEGE_SELECTABLE} if r.get('buffMode')=='stock' else None
    for angle in (a,45,25,5,75,90,115,145,175):
        try:_siege_fire(r,angle,p,selection);return
        except ValueError:continue
    # A fort can physically surround the gun; fire an ordinary round if blocked.
    if selection is not None:selection.pop('big',None);_siege_fire(r,a,p,selection)
    else:
        n=r['buffs'][1]['big'];r['buffs'][1]['big']=0
        try:_siege_fire(r,a,p)
        finally:r['buffs'][1]['big']+=n

def _siege_bot(r):
    # For unusual layouts, choose a trajectory that clears our own fort and any platforms.
    if r.get('field') in _SIEGE_NEW_FIELDS:
        sx,sy=_siege_launcher(1,r);wind=r.get('wind',0);now=max(0,time.time()-r.get('motionEpoch',time.time()));choices=[]
        for a in range(25,86,5):
            for p in range(40,101,5):
                rad=math.radians(a);v=p*8;score=-1
                for j in range(1,121):
                    t=j*.04;x=sx-(43+v*t)*math.cos(rad)+.5*wind*t*t;y=sy-(43+v*t)*math.sin(rad)+.5*_SIEGE_GRAV*t*t
                    if x<0 or x>960 or y>_siege_floor(r,x)-6:break
                    hit=next((b for b in r['bodies'] if b['hp']>0 and abs(x-b['x'])<=b['w']/2+6 and abs(y-(b['baseY']+b['motionY']*math.sin((now+t)*.8+b.get('phase',0)) if b.get('motionY') else b['y']))<=b['h']/2+6),None)
                    if hit:
                        score=(3 if hit['kind']=='core' else 2) if hit['side']==0 else (0 if hit['side']==-1 else -2);break
                if score>=2:choices.append((score,a,p))
        if choices:
            _,a,p=random.choice([x for x in choices if x[0]==max(y[0] for y in choices)])
            _siege_bot_fire(r,a,p);return
    # Invert the same ballistic equations, then add small aiming error.
    targets=[b for b in r['bodies'] if b['side']==0 and b['hp']>0]
    target=random.choice(targets) if targets else None
    a=random.uniform(30,65);x,y=_siege_muzzle(1,r,a);tx=target['x'] if target else 122;ty=target['y'] if target else 380
    rad=math.radians(a);wind=r.get('wind',0);dx=tx-x;dy=ty-y
    # x = -v cos(a)t + .5 wind t², y = -v sin(a)t + .5 g t².
    den=.5*(_SIEGE_GRAV-wind*math.tan(rad));t=math.sqrt(max(.01,(dy-dx*math.tan(rad))/den))
    v=(.5*wind*t*t-dx)/(math.cos(rad)*t)
    _siege_bot_fire(r,a,max(15,min(100,v/8+random.uniform(-2.5,2.5))))

def _siege_public(r,key,last):
    _siege_normalize_buffs(r)
    seat=next(i for i,p in enumerate(r['players']) if p['key']==key)
    return {'ok':True,'code':r['code'],'seat':seat,'players':[p['name'] for p in r['players']],'phase':r['phase'],'turn':r['turn'],'shots':r['shots'],'winner':r['winner'],'rev':r['rev'],'bodies':[{k:v for k,v in b.items() if k not in ('vx','vy')} for b in r['bodies']],'cores':[_siege_core(r['bodies'],i) for i in (0,1)],'event':r['event'] if last!=r['rev'] else None,'busy':time.time()<r['until'],'bot':r['bot'],'items':r['items'],'buffs':r['buffs'],'ammo':r.get('ammo',_SIEGE_MAX_SHOTS),'offset':r.get('offset',0),'layout':r.get('layout','tower'),'mode':r.get('mode','classic'),'wind':r.get('wind',0),'windLevel':r.get('windLevel','off'),'launchers':[_siege_launcher(i,r,0) if not r.get('gunMotion') else list(r['launchers'][i]) for i in (0,1)],'gunMotion':r.get('gunMotion',[]),'rise':r.get('rise',0),'field':r.get('field',r.get('mode','classic')),'fieldLabel':r.get('fieldLabel','战场'),'respawns':r.get('respawns',[]),'motionTime':max(0,time.time()-r.get('motionEpoch',time.time())),'buffMode':r.get('buffMode','auto'),'armed':r.get('armed',[{},{}]),'stackMax':_SIEGE_STACK_MAX,'reflectors':r.get('reflectors',[])}

def siege_request(data):
    key=str(data.get('key',''));kind=data.get('type');code=str(data.get('code','')).upper();now=time.time()
    if len(key)!=48 or any(c not in '0123456789abcdef' for c in key):return {'ok':False,'error':'会话无效，请刷新'}
    for k in list(_SIEGE_ROOMS):
        if now-_SIEGE_ROOMS[k]['touched']>86400:del _SIEGE_ROOMS[k]
    if kind=='create':
        if len(_SIEGE_ROOMS)>=64:return {'ok':False,'error':'房间已满'}
        code=secrets.token_hex(3).upper()
        while code in _SIEGE_ROOMS:code=secrets.token_hex(3).upper()
        name=str(data.get('name','玩家')).strip()[:12] or '玩家';r=_siege_new(name,key,data.get('bot') is True);r['code']=code;_SIEGE_ROOMS[code]=r;return _siege_public(r,key,-1)
    r=_SIEGE_ROOMS.get(code)
    if not r:return {'ok':False,'error':'房间不存在或已关闭'}
    seat=next((i for i,p in enumerate(r['players']) if p['key']==key),None)
    if kind=='join' and seat is None:
        if r['phase']!='wait' or len(r['players'])>=2:return {'ok':False,'error':'房间已满'}
        r['players'].append({'name':str(data.get('name','玩家')).strip()[:12] or '玩家','key':key});r['phase']='play';seat=1
    if seat is None:return {'ok':False,'error':'不在这个房间'}
    r['touched']=now
    if kind=='fire':
        if r['phase']!='play' or r['turn']!=seat or now<r['until'] or data.get('rev')!=r['rev']:return {'ok':False,'error':'当前不能发射，请等待回合'}
        a,p=data.get('angle'),data.get('power')
        if type(a) not in (int,float) or type(p) not in (int,float) or not (5<=a<=175 and 15<=p<=100):return {'ok':False,'error':'角度或力度无效'}
        try:_siege_fire(r,a,p,data.get("selection"))
        except ValueError as e:return {"ok":False,"error":str(e)}
    elif kind=='rematch':
        if r['phase']!='over' or now<r['until']:return {'ok':False,'error':'本局尚未结束'}
        _siege_rematch(r)
    elif kind not in ('state','join'):return {'ok':False,'error':'未知操作'}
    if r['bot'] and r['phase']=='play' and r['turn']==1 and now>=r['until']+.65:_siege_bot(r)
    return _siege_public(r,key,data.get('last',-1))

_siege_get_base=Handler.do_GET
_siege_post_base=Handler.do_POST
def _siege_get(self):
    if urlparse(self.path).path=='/siege':return self.reply(SIEGE_PAGE,200,'text/html; charset=utf-8')
    return _siege_get_base(self)
def _siege_post(self):
    if urlparse(self.path).path!='/api/siege':return _siege_post_base(self)
    try:
        if not 0<int(self.headers.get('Content-Length','0'))<=4096:raise ValueError('length')
        data=self.read_json()
        if not isinstance(data,dict):raise ValueError('data')
        with LOCK:response=siege_request(data)
        return self.reply(response)
    except (ValueError,TypeError,KeyError):return self.reply({'ok':False,'error':'请求无效'},400)
Handler.do_GET=_siege_get
Handler.do_POST=_siege_post
