        r['nextCloneId']=r.get('nextCloneId',0)+min(attack_counts['clone'],3)
        r['clones'][:]=r['clones'][-6:]
    # Teleport to the actual impact column anywhere on the battlefield. The descent is
    # kinematic and collision-safe; gravity gives its timing, not impact damage.
    for kind in _SIEGE_ONE_SHOT:
        if not attack_counts.get(kind):continue
        core=next(b for b in bodies if b['side']==side and b['kind']=='core')
        old=_siege_launcher(side,r,motion_start+t) if kind=='gunteleport' else (core['x'],core['y'])
        if teleport_target is None or core['hp']<=0:
            r['buffs'][side][kind]=1;continue
        desired=max(45,min(915,teleport_target[0]));w,h=(52,96) if kind=='gunteleport' else (core['w'],core['h'])
        other_guns=[_siege_launcher(i,r,motion_start+t) for i in (0,1) if i!=side or kind=='coreteleport']
        x=next((v for v in sorted(range(45,916,5),key=lambda v:abs(v-desired)) if all(abs(v-gx)>w/2+24 for gx,gy in other_guns)),desired)
        def support():
            return min([_siege_floor(r,x)]+[b['y']-b['h']/2 for b in bodies if (kind=='gunteleport' or b is not core) and b['hp']>0 and abs(x-b['x'])<(w+b['w'])/2+1]) - h/2
        start_y=min(-100,teleport_target[1]-h/2-30,support()-60);y=start_y;v=0.;begin=t
        if kind=='gunteleport':
            r.setdefault('launchers',[list(_siege_launcher(i,r,motion_start+t)) for i in (0,1)])
            if r.get('gunMotion'):r['gunMotion'][side]={'amplitude':0,'phase':0}
            r['launchers'][side]=[x,y]
        else:
            core.update(x=x,y=y,vx=0.,vy=0.,fixed=True,teleportFall=True);core.pop('motionY',None);core.pop('floatFort',None)
        record=[kind,side,*old,x,y,round(begin,3),start_y,round(begin,3)];teleports.append(record)
        for j in range(1,241):
            t=begin+j*dt;_siege_motion(r,motion_start+t);v+=_SIEGE_GRAV*dt;y=min(y+v*dt,support())
            if kind=='gunteleport':r['launchers'][side]=[x,y]
            else:core.update(x=x,y=y,vx=0.,vy=0.)
            record[5]=y;record[8]=round(t,3)
            if live is None and j%4==0:frames.append(snap(t,None))
            if live is not None:yield sample(t,None)
            if y>=support()-.01:break
        if kind=='coreteleport':
            core.pop('fixed',None);core.pop('teleportFall',None)
        record[5]=y;record[8]=round(t,3)
    if live is None:
        for b in bodies:b['vx']=b['vy']=0.
    frames.append(snap(t,None))
    if live is None:r['shots'][side]+=1;r['rev']+=1
    refreshed=_siege_refill(r)
    cores=[_siege_core(bodies,i) for i in (0,1)]
    ammo=r.get("ammo",_SIEGE_MAX_SHOTS)
    if live is not None:return
    if min(cores)<=0 or (ammo and all(n>=ammo for n in r['shots'])):
        r['phase']='over';r['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0])
    else:
        r['turn']=1-side
        if r['turn']==0:r['windPair']=_siege_weather(r.get('windLevel','off'))
        r['wind']=r.get('windPair',0)*(1 if r['turn']==0 else -1)
    r['event']={'id':r['rev'],'side':side,'frames':frames,'impact':impact,'hitAt':hit_at,'hitId':hit_id,'duration':t,'cores':cores,'itemsBefore':items_before,'buffsBefore':buffs_before,'pickups':pickups,'attacks':attacks,'defenses':defenses,'attackCounts':attack_counts,'defenseCounts':defense_counts,'armedBefore':armed_before,'selected':chosen,'radius':radius,'blastRadius':blast_radius,'wind':wind,'motionStart':motion_start,'extraBlasts':extra_blasts,'fragmentHits':fragment_hits,'passed':list(passed),'refreshed':refreshed,'bounces':bounces,'drops':drop_events,'holes':holes,'teleports':teleports,'angle':angle,'fragmentRadius':fragment_radius,'negativeActive':list(negatives),'puffs':puffs,'clones':r['clones'],'launchersBefore':launchers_before,'gunMotionBefore':gun_motion_before,'launchersBase':[list(x) for x in r.get('launchers',[])],'gunMotion':r.get('gunMotion',[])}
    r['until']=time.time()+t+.35

_SIEGE_LIVE_DT=1/60

def _siege_live_runtime(r,now=None):
    now=time.time() if now is None else now
    # A restarted server has no resumable Python generators. Recover a falling core safely.
    for b in r['bodies']:
        if b.pop('teleportFall',False):
            b.pop('fixed',None);b['y']=min(b['y'],_siege_floor(r,b['x'])-b['h']/2);b['vy']=0.
    return {'room':r,'clock':now,'active':{},'ready':[now,now],'physicsFns':{},'dropQueues':{}}

def _siege_live_can_fire(r,rt,side,now):
    return (r['phase']=='play' and min(_siege_core(r['bodies'],i) for i in (0,1))>0 and side not in rt['active'] and now>=rt['ready'][side] and (not r.get('ammo') or r['shots'][side]<r['ammo']))

def _siege_live_start(r,rt,side,angle,power,selection=None,now=None,force=False):
    now=time.time() if now is None else now
    if not _siege_live_can_fire(r,rt,side,now):raise ValueError('上一发尚未结束、正在装填或弹药耗尽')
    gen=_siege_fire_steps(r,angle,power,selection,side,rt,force)
    sample=next(gen) # validates and reserves buffs before exposing shot
    r['shots'][side]+=1;r['rev']+=1
    rt['active'][side]={'gen':gen,'sample':sample};rt['ready'][side]=float('inf')

def _siege_live_tick(r,rt,now=None):
    now=time.time() if now is None else now;changed=False
    # Both shots share bodies/items and advance on the same fixed timestep.
    # Limit catch-up after a device sleeps; no huge CPU burst under the room lock.
    if not rt['active']:rt['clock']=now;_siege_motion(r,max(0,now-r['motionEpoch']))
    else:
        steps=min(180,max(0,int((now-rt['clock'])/_SIEGE_LIVE_DT)))
        for _ in range(steps):
            rt['clock']+=_SIEGE_LIVE_DT
            sides=list(rt['active'])
            for side in sides:
                entry=rt['active'][side]
                try:entry['sample']=next(entry['gen'])
                except StopIteration:
                    del rt['active'][side];rt['physicsFns'].pop(side,None);rt['dropQueues'].pop(side,None);rt['ready'][side]=max(rt['clock'],now)+r.get('reloadSeconds',5);r['rev']+=1;changed=True
            if not rt['active']:break
            # Shared rigid-body world advances once, even if a shot is in teleport descent.
            rt['physicsFns'][next(iter(rt['active']))]()
    cores=[_siege_core(r['bodies'],i) for i in (0,1)];ammo=r.get('ammo',0)
    if r['phase']=='play' and not rt['active'] and (min(cores)<=0 or (ammo and all(n>=ammo for n in r['shots']))):
        r['phase']='over';r['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0]);r['rev']+=1;changed=True
    return changed

def _siege_live_public(r,rt,key):
    v=_siege_public(r,key,r['rev']);now=time.time();seat=v['seat'];v.update(combatMode='live',event=None,busy=seat in rt['active'],liveShots=[e['sample'] for e in rt['active'].values()],reload=[0 if i in rt['active'] else max(0,round(rt['ready'][i]-now,2)) for i in (0,1)],canFire=_siege_live_can_fire(r,rt,seat,now),liveActive=bool(rt['active']),motionTime=max(0,rt['clock']-r['motionEpoch']),wind=r.get('windPair',0)*(1 if seat==0 else -1))
    return v

def _siege_sync_runtime(r,now=None):
    now=time.time() if now is None else now
    return {'room':r,'round':1,'deadline':_siege_prep_deadline(r,now),'plans':[None,None],'force':[False,False],'locked':[False,False],'replay':None,'until':0.,'notice':['','']}

def _siege_prep_seconds(r):
    n=r.get('reloadSeconds',15);return n if n in (0,5,10,15) else 15

def _siege_prep_deadline(r,now):
    seconds=_siege_prep_seconds(r)
    return now+seconds if seconds else None

def _siege_sync_plan(r,rt,side,data,lock=False):
    if r['phase']!='play' or rt['replay'] or rt['locked'][side]:raise ValueError('当前不能调整炮击')
    if data.get('round')!=rt['round']:raise ValueError('准备阶段已切换')
    a,p=data.get('angle'),data.get('power')
    if type(a) not in (int,float) or type(p) not in (int,float) or not (5<=a<=175 and 15<=p<=100):raise ValueError('角度或力度无效')
    chosen=_siege_selection(r,data.get('selection'),side)
    force=data.get('force') is True
    if lock:_siege_launch_check(r,side,a,chosen,max(0,time.time()-r.get('motionEpoch',time.time())),force)
    rt['plans'][side]=(a,p,chosen);rt['force'][side]=force
    if lock:rt['locked'][side]=True

def _siege_sync_compute(r,rt,now):
    # Atomic round: validate/compute on a copy; the two generators share the same world.
    import copy
    w=copy.deepcopy(r);engine=_siege_live_runtime(w,now);w['reloadSeconds']=0
    plans=[x or (42,65,{}) for x in rt['plans']];notices=['','']
    # Both stock defenses are armed before either shot consumes the opposing defense.
    if w.get('buffMode')=='stock':
        for side in (0,1):
            a,p,sel=plans[side];sel=dict(sel);armed=w.setdefault('armed',[{},{}])[side]
            for k in _SIEGE_DEFENSE:
                n=sel.pop(k,0)
                if n:armed[k]=min(_SIEGE_STACK_MAX,armed.get(k,0)+n);w['buffs'][side][k]-=n
            plans[side]=(a,p,sel)
    for side,(a,p,sel) in enumerate(plans):
        if w.get('ammo') and w['shots'][side]>=w['ammo']:continue
        try:_siege_live_start(w,engine,side,a,p,sel,now,rt['force'][side])
        except ValueError:
            # Moving terrain may obstruct a prepared giant shell at the deadline.
            if w.get('buffMode')=='stock':
                sel=dict(sel);sel.pop('big',None);_siege_live_start(w,engine,side,a,p,sel,now)
            else:
                n=w['buffs'][side]['big'];w['buffs'][side]['big']=0
                try:_siege_live_start(w,engine,side,a,p,None,now)
                finally:w['buffs'][side]['big']+=n
            notices[side]='巨型弹炮口受阻，本轮未消耗巨型弹'
    frames=[];meta={};items={};step=0
    def capture():
        t=step*_SIEGE_LIVE_DT
        for b in w['bodies']:meta[b['id']]={k:v for k,v in b.items() if k not in ('vx','vy','motionY','baseY','phase')}
        for it in w['items']:items[it['id']]=dict(it)
        frames.append([round(t,3),[_siege_pos(b) for b in w['bodies']],copy.deepcopy([e['sample'] for e in engine['active'].values()]),[list(_siege_launcher(i,w,max(0,now-w['motionEpoch'])+t)) for i in (0,1)],[it['id'] for it in w['items']]])
    capture()
    while engine['active']:
        step+=1;engine['clock']=now+step*_SIEGE_LIVE_DT
        # Alternate iteration order by tick to avoid systematically favoring one player.
        for side in sorted(engine['active'],reverse=bool(step%2)):
            entry=engine['active'][side]
            try:entry['sample']=next(entry['gen'])
            except StopIteration:
                del engine['active'][side];engine['physicsFns'].pop(side,None);engine['dropQueues'].pop(side,None)
        if engine['active']:engine['physicsFns'][next(iter(engine['active']))]()
        if step%6==0 or not engine['active']:capture()
    for b in w['bodies']:b['vx']=b['vy']=0.
    cores=[_siege_core(w['bodies'],i) for i in (0,1)];ammo=w.get('ammo',0)
    if min(cores)<=0 or (ammo and all(n>=ammo for n in w['shots'])):
        w['phase']='over';w['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0])
    w['rev']+=1;w['reloadSeconds']=r.get('reloadSeconds',15);w['event']=None
    duration=frames[-1][0];w['until']=time.time()+duration+.35
    r.clear();r.update(w)
    rt.update(replay={'id':r['rev'],'duration':duration,'frames':frames,'meta':list(meta.values()),'items':list(items.values()),'motionStart':max(0,now-w['motionEpoch'])},until=r['until'],notice=notices)

def _siege_sync_tick(r,rt,now=None):
    now=time.time() if now is None else now
    if rt['replay']:
        if now<rt['until']:return False
        rt.update(round=rt['round']+1,deadline=_siege_prep_deadline(r,now),plans=[None,None],force=[False,False],locked=[False,False],replay=None,notice=['',''])
        if r['phase']=='play':r['windPair']=_siege_weather(r.get('windLevel','off'))
        return False
    if r['phase']!='play':return False
    if r['bot'] and not rt['locked'][1]:
        plan={'planOnly':True};_siege_bot(r,plan);rt['plans'][1]=plan['plan'];rt['locked'][1]=True
    if all(rt['locked']) or (rt['deadline'] is not None and now>=rt['deadline']):
        _siege_sync_compute(r,rt,now);return True
    return False

def _siege_sync_public(r,rt,key,last=-1):
    v=_siege_public(r,key,r['rev']);seat=v['seat'];replay=rt['replay'];busy=bool(replay)
    v.update(combatMode='sync',event=None,busy=busy,round=rt['round'],ready=list(rt['locked']),remaining=(None if rt['deadline'] is None else max(0,round(rt['deadline']-time.time(),2))) if not busy else 0,canFire=r['phase']=='play' and not busy,liveShots=[],wind=r.get('windPair',0)*(1 if seat==0 else -1),syncNotice=rt['notice'][seat],myPlan=rt['plans'][seat],replayId=replay['id'] if replay else None)
    if replay and last!=replay['id']:v['replay']=replay;v['replayElapsed']=max(0,replay['duration']+.35-(rt['until']-time.time()))
    return v

def _siege_bot_fire(r,a,p,live=None):
    selection={k:min(1 if k in _SIEGE_ONE_SHOT else 2,n) for k,n in r['buffs'][1].items() if n>0 and k in _SIEGE_SELECTABLE and k not in _SIEGE_ONE_SHOT} if r.get('buffMode')=='stock' else None
    if live is not None and live.get('planOnly'):
        live['plan']=(a,p,selection or {});return
    if live is not None and selection is not None:
        for k in _SIEGE_DEFENSE:
            if k in selection:
                selection[k]=min(selection[k],max(0,_SIEGE_STACK_MAX-r.get('armed',[{},{}])[1].get(k,0)))
                if not selection[k]:selection.pop(k)
    def shoot(angle,selection):
        if live is not None:_siege_live_start(r,live,1,angle,p,selection)
        else:_siege_fire(r,angle,p,selection)
    for angle in ((a,135,155,175,105,90,75,45,5) if a>90 else (a,45,25,5,75,90,115,145,175)):
        try:shoot(angle,selection);return
        except ValueError:continue
    # A fort can physically surround the gun; fire an ordinary round if blocked.
    if selection is not None:selection.pop('big',None);shoot(a,selection)
    else:
        n=r['buffs'][1]['big'];r['buffs'][1]['big']=0
        try:shoot(a,None)
        finally:r['buffs'][1]['big']+=n

def _siege_bot(r,live=None):
    # For unusual layouts, choose a trajectory that clears our own fort and any platforms.
    if r.get('field') in _SIEGE_NEW_FIELDS:
        sx,sy=_siege_launcher(1,r);wind=-r.get('windPair',0) if live is not None else r.get('wind',0);now=max(0,time.time()-r.get('motionEpoch',time.time()));choices=[]
        for a in range(5,176,5):
            for p in range(40,101,5):
                rad=math.radians(a);v=p*8;score=-1
                for j in range(1,121):
                    t=j*.04;x=sx-(43+v*t)*math.cos(rad)+.5*wind*t*t;y=sy-(43+v*t)*math.sin(rad)+.5*_SIEGE_GRAV*t*t
                    if x<0 or x>960 or y>_siege_floor(r,x)-6:break
                    hit=next((b for b in r['bodies'] if b['hp']>0 and abs(x-b['x'])<=b['w']/2+6 and abs(y-(b['baseY']+b['motionY']*math.sin((now+t)*.8+b.get('phase',0)) if b.get('motionY') else b['y']))<=b['h']/2+6),None)
                    if hit:
                        score=(3 if hit['kind']=='core' else 2) if hit['side']==0 else (0 if hit['side']==-1 else -2);break
                if score>=2:choices.append((score,a,p))
        if choices:
            _,a,p=random.choice([x for x in choices if x[0]==max(y[0] for y in choices)])
            _siege_bot_fire(r,a,p,live);return
    # Invert the same ballistic equations, then add small aiming error.
    targets=[b for b in r['bodies'] if b['side']==0 and b['hp']>0]
    core=next((b for b in targets if b['kind']=='core'),None)
    target=core if core and core['x']>_siege_launcher(1,r)[0] else random.choice(targets) if targets else None
    tx=target['x'] if target else 122;ty=target['y'] if target else 380
    sx,sy=_siege_launcher(1,r);wind=-r.get('windPair',0) if live is not None else r.get('wind',0)
    # Select the correct hemisphere using actual target position, not the seat index.
    # Search reachable launch solutions using the true muzzle and ballistic equations.
    candidates=[];right=tx>sx
    for a in (range(95,176,5) if right else range(5,86,5)):
        rad=math.radians(a);x,y=_siege_muzzle(1,r,a);dx=tx-x;dy=ty-y
        den=.5*(_SIEGE_GRAV-wind*math.tan(rad))
        if abs(den)<1e-6:continue
        q=(dy-dx*math.tan(rad))/den
        if q<=0:continue
        t=math.sqrt(q);v=(.5*wind*t*t-dx)/(math.cos(rad)*t)
        if 15<=v/8<=100:candidates.append((a,v/8))
    if candidates:a,p=random.choice(candidates);_siege_bot_fire(r,a,max(15,min(100,p+random.uniform(-2.5,2.5))),live)
    else:_siege_bot_fire(r,135 if right else 45,65,live)

def _siege_public(r,key,last):
    _siege_normalize_buffs(r)
    seat=next(i for i,p in enumerate(r['players']) if p['key']==key)
    return {'ok':True,'code':r['code'],'seat':seat,'players':[p['name'] for p in r['players']],'phase':r['phase'],'turn':r['turn'],'shots':r['shots'],'winner':r['winner'],'rev':r['rev'],'bodies':[{k:v for k,v in b.items() if k not in ('vx','vy')} for b in r['bodies']],'cores':[_siege_core(r['bodies'],i) for i in (0,1)],'event':r['event'] if last!=r['rev'] else None,'busy':time.time()<r['until'],'bot':r['bot'],'items':r['items'],'buffs':r['buffs'],'ammo':r.get('ammo',_SIEGE_MAX_SHOTS),'offset':r.get('offset',0),'layout':r.get('layout','tower'),'mode':r.get('mode','classic'),'wind':r.get('wind',0),'windLevel':r.get('windLevel','off'),'launchers':[_siege_launcher(i,r,0) if not r.get('gunMotion') else list(r['launchers'][i]) for i in (0,1)],'gunMotion':r.get('gunMotion',[]),'rise':r.get('rise',0),'field':r.get('field',r.get('mode','classic')),'fieldLabel':r.get('fieldLabel','战场'),'respawns':r.get('respawns',[]),'motionTime':max(0,time.time()-r.get('motionEpoch',time.time())),'buffMode':r.get('buffMode','auto'),'combatMode':r.get('combatMode','turn'),'reloadSeconds':r.get('reloadSeconds',5),'armed':r.get('armed',[{},{}]),'negativePending':r.get('negativePending',[{},{}]),'clones':r.get('clones',[]),'stackMax':_SIEGE_STACK_MAX,'reflectors':r.get('reflectors',[]),'allowedBuffs':list(_siege_allowed(r))}

def siege_request(data):
    key=str(data.get('key',''));kind=data.get('type');code=str(data.get('code','')).upper();now=time.time()
    if len(key)!=48 or any(c not in '0123456789abcdef' for c in key):return {'ok':False,'error':'会话无效，请刷新'}
    for k in list(_SIEGE_ROOMS):
        if now-_SIEGE_ROOMS[k]['touched']>86400:del _SIEGE_ROOMS[k]
    if kind=='create':
        if len(_SIEGE_ROOMS)>=64:return {'ok':False,'error':'房间已满'}
        code=secrets.token_hex(3).upper()
        while code in _SIEGE_ROOMS:code=secrets.token_hex(3).upper()
        name=str(data.get('name','玩家')).strip()[:12] or '玩家'
        allowed=data.get('allowedBuffs')
        if allowed is not None and (not isinstance(allowed,list) or len(allowed)>len(_SIEGE_ITEMS) or len(set(map(str,allowed)))!=len(allowed) or any(type(x) is not str or x not in _SIEGE_ITEMS for x in allowed)):
            return {'ok':False,'error':'增益选择无效'}
        r=_siege_new(name,key,data.get('bot') is True,allowed_buffs=allowed);r['code']=code;_SIEGE_ROOMS[code]=r;return _siege_public(r,key,-1)
    r=_SIEGE_ROOMS.get(code)
    if not r:return {'ok':False,'error':'房间不存在或已关闭'}
    seat=next((i for i,p in enumerate(r['players']) if p['key']==key),None)
    if kind=='join' and seat is None:
        if r['phase']!='wait' or len(r['players'])>=2:return {'ok':False,'error':'房间已满'}
        r['players'].append({'name':str(data.get('name','玩家')).strip()[:12] or '玩家','key':key});r['phase']='play';seat=1
    if seat is None:return {'ok':False,'error':'不在这个房间'}
    r['touched']=now
    if kind=='fire':
        if r['phase']!='play' or r['turn']!=seat or now<r['until'] or data.get('rev')!=r['rev']:return {'ok':False,'error':'当前不能发射，请等待回合'}
        a,p=data.get('angle'),data.get('power')
        if type(a) not in (int,float) or type(p) not in (int,float) or not (5<=a<=175 and 15<=p<=100):return {'ok':False,'error':'角度或力度无效'}
        try:_siege_fire(r,a,p,data.get("selection"),data.get("force") is True)
        except ValueError as e:return {"ok":False,"error":str(e)}
    elif kind=='rematch':
        if r['phase']!='over' or now<r['until']:return {'ok':False,'error':'本局尚未结束'}
        _siege_rematch(r)
    elif kind not in ('state','join'):return {'ok':False,'error':'未知操作'}
    if r['bot'] and r['phase']=='play' and r['turn']==1 and now>=r['until']+.65:_siege_bot(r)
    return _siege_public(r,key,data.get('last',-1))

_siege_get_base=Handler.do_GET
_siege_post_base=Handler.do_POST
def _siege_get(self):
    if urlparse(self.path).path=='/siege':return self.reply(SIEGE_PAGE,200,'text/html; charset=utf-8')
    return _siege_get_base(self)
def _siege_post(self):
    if urlparse(self.path).path!='/api/siege':return _siege_post_base(self)
    try:
        if not 0<int(self.headers.get('Content-Length','0'))<=4096:raise ValueError('length')
        data=self.read_json()
        if not isinstance(data,dict):raise ValueError('data')
        with LOCK:response=siege_request(data)
        return self.reply(response)
    except (ValueError,TypeError,KeyError):return self.reply({'ok':False,'error':'请求无效'},400)
Handler.do_GET=_siege_get
Handler.do_POST=_siege_post
