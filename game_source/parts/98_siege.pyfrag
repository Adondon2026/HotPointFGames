                if b.get('fixed') or b['hp']<=0:continue
                force=math.hypot(ax,ay)
                if force>1050:ax*=1050/force;ay*=1050/force
                if b.get('pushTime',0)>0:
                    forces=b.get('pushForces')
                    if forces is None:
                        oldvx=b.get('pushVX',0.);oldvy=b.get('pushVY',0.);m=max(1.,math.hypot(oldvx,oldvy))
                        forces=[[oldvx/m*240.,oldvy/m*240.,b['pushTime']]]
                    pax=sum(f[0] for f in forces);pay=sum(f[1] for f in forces);pcap=max(1.,math.hypot(pax,pay)/540.)
                    ax+=pax/pcap/_siege_body_mass(b);ay+=pay/pcap/_siege_body_mass(b)
                    b['pushForces']=[[fx,fy,left-dt] for fx,fy,left in forces if left>dt]
                    b['pushTime']=max((f[2] for f in b['pushForces']),default=0.)
                b['vx']+=ax*dt;b['vy']+=(ay+_SIEGE_GRAV)*dt
