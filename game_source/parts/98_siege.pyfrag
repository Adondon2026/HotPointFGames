                            if crush>0.:
                                hurt(fixed,crush,moving.get('impactSource',side))
                                behavior_events.append(['crush',round(t,3),round(moving['x'],1),round(moving['y'],1),round(crush,1)])
                        moving[axis]+=sg*depth
                        if moving[v]*sg<0:
                            if abs(moving[v])>115:hurt(moving,_siege_wall_damage(abs(moving[v])) if v24 and moving['kind']=='core' else (abs(moving[v])-115)*.08,moving.get('impactSource'))
                            moving[v]=0.
