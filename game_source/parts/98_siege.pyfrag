def _siege_trial_stock(r):
    # Trial inventory is refilled after each shot; ordinary rooms never enter here.
    r['buffs'][0]={k:_SIEGE_V24_CAPS.get(k,0) if _siege_v24(r) else max(1,_SIEGE_HARD_CAPS[k]) if k in _SIEGE_ACTIVE_ITEMS else 0 for k in _SIEGE_ITEMS}
    r['buffs'][1]={k:0 for k in _SIEGE_ITEMS}

def _siege_trial_reset(r,mode=None):
    if mode is not None:
        if mode not in (*_SIEGE_FIELDS,*_SIEGE_NEW_FIELDS,'classic'):raise ValueError('试验地图无效')
        r['mode']=mode
    r.update(turn=0,shots=[0,0],phase='play',winner=None,rev=r['rev']+1,event=None,until=0.,ammo=0,itemCount=0,buffMode='stock',combatMode='turn',trial=True,trialDamage=0.)
    rng=random.getstate()
    try:
        random.seed('siege-trial-'+r['mode']);_siege_field(r)
    finally:random.setstate(rng)
    _siege_trial_stock(r)

def _siege_trial_steps(r,angle,power,selection,force=False,config=None,control=None):
    if not isinstance(selection,dict):raise ValueError('增益选择无效')
    selected={}
    for k,n in selection.items():
        if k not in _SIEGE_ITEMS or type(n) is not int or not 0<=n<=_siege_cap(r,k):raise ValueError('增益数量无效')
        if n:selected[k]=n
    config=_siege_config(config)
    # Validate before modifying any state. Negatives and heal are trial-only direct choices.
    chosen={k:n for k,n in selected.items() if k in _SIEGE_SELECTABLE}
    _siege_launch_check(r,0,angle,chosen,force=force)
    r['negativePending'][0]={k:1 for k in _SIEGE_NEGATIVE if selected.get(k)}
    if selected.get('heal'):
        core=next(b for b in r['bodies'] if b['kind']=='core' and b['side']==0);core['hp']=min(core['max'],core['hp']+18)
    # Target defense enables real damage-reduction comparisons without enemy fire.
    if not _siege_v24(r):r['armed'][1]={k:selected[k] for k in _SIEGE_DEFENSE if k in selected}
    chosen={k:n for k,n in chosen.items() if k not in _SIEGE_DEFENSE}
    yield from _siege_fire_steps(r,angle,power,chosen,force=force,config=config,control=control)
    _siege_trial_stock(r)
    r['armed']=[{},{}]
    r['negativePending'][0]={}

def _siege_trial_fire(r,angle,power,selection,force=False,config=None):
    for _ in _siege_trial_steps(r,angle,power,selection,force,config):pass

def _siege_fire(r,angle,power,selection=None,force=False,config=None):
    if r.get('trial'):return _siege_trial_fire(r,angle,power,selection or {},force,config)
    for _ in _siege_fire_steps(r,angle,power,selection,force=force,config=config):pass

