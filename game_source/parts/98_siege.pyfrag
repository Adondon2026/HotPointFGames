            for i,b in enumerate(live):
                if b['hp']<=0:continue
                for c in live[i+1:]:
                    if c['hp']<=0:continue
                    if r.get('zombiePhasePhysics') and (b['kind']=='zombie' or c['kind']=='zombie'):continue
                    # Zombies phase through cannons at all times, including after
                    # a push/blackhole releases them into rigid-body simulation.
                    # Cannons retain gravity and collisions against all other bodies.
                    if (b['kind']=='zombie' and c['kind']=='cannon') or (b['kind']=='cannon' and c['kind']=='zombie'):continue
                    dx=c['x']-b['x'];dy=c['y']-b['y'];ox=(b['w']+c['w'])/2-abs(dx);oy=(b['h']+c['h'])/2-abs(dy)
                    if ox<=0 or oy<=0:continue
                    axis='x' if ox<oy else 'y';v='v'+axis;delta=dx if axis=='x' else dy;sign=1 if delta>=0 else -1;depth=ox if axis=='x' else oy
                    if b.get('fixed') and c.get('fixed'):continue
                    if b.get('fixed') or c.get('fixed'):
                        fixed=b if b.get('fixed') else c
                        moving,sg=(c,sign) if b.get('fixed') else (b,-sign)
                        # Falling debris can crush a fixed, pathfinding zombie.
                        # This must happen before contact resolution clears vy;
                        # the resulting zero velocity prevents duplicate hits.
                        if (v24 and fixed['kind']=='zombie' and axis=='y'
                                and moving['y']<fixed['y'] and moving['vy']>120.):
