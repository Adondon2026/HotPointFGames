        if r['turn']==0:r['windPair']=_siege_weather(r.get('windLevel','off'))
        r['wind']=r.get('windPair',0)*(1 if r['turn']==0 else -1)
    r['event']={'id':r['rev'],'side':side,'emberEvents':ember_events,'generatedCounts':generated_counts if unified else {},'payloadEvents':event_counts if unified else {},'trialDamage':round(trial_damage,1),'frames':frames,'impact':impact,'hitAt':hit_at,'hitId':hit_id,'duration':t,'cores':cores,'itemsBefore':items_before,'buffsBefore':buffs_before,'pickups':pickups,'attacks':attacks,'defenses':defenses,'attackCounts':attack_counts,'defenseCounts':defense_counts,'armedBefore':armed_before,'selected':chosen,'radius':radius,'blastRadius':blast_radius,'wind':wind,'motionStart':motion_start,'extraBlasts':extra_blasts,'fragmentHits':fragment_hits,'passed':list(passed),'refreshed':refreshed,'bounces':bounces,'drops':drop_events,'holes':holes,'teleports':teleports,'angle':actual_angle,'requestedAngle':angle,'angleOffset':angle_offset,'fragmentRadius':fragment_radius,'negativeActive':list(negatives),'engineering':engineering,'behaviorEvents':behavior_events,'fireArcs':arc_events,'minesBefore':mines_before,'mineEvents':mine_events,'holePaths':hole_paths,'puffs':puffs,'clones':r['clones'],'launchersBefore':launchers_before,'gunMotionBefore':gun_motion_before,'launchersBase':[list(_siege_launcher(i,r,motion_start+t)) for i in range(r.get('zombiePlayerCount',2) if r.get('theme')=='zombie' else 2)],'gunMotion':r.get('gunMotion',[])}
    if v24 and control is None:
        r['event'].update(_siege_replay_timing(frames,t,hit_at,bodies=bodies,events=behavior_events),compoundRecipe=compound_recipe,compoundRecipesUsed=compound_selected,compoundEffects=compound_effects)
        if r.get('theme')=='zombie':
            phase=next((e[1] for e in behavior_events if e[0]=='zombiePhase'),None)
            if phase is not None:
                # The zombie camera returns to the active cannon WITHIN the
                # final action/settling interval. The generic projectile
                # handoff must not add a second, inactive camera wait.
                r['event'].update(zombiePhase=phase,visualEnd=t,playbackDuration=round(t+.18,3))
        r['until']=time.time()+_SIEGE_REPLAY_PREROLL+r['event']['playbackDuration']+.10
    else:r['until']=time.time()+(.35 if control is not None else t+.35)

_SIEGE_MANUAL_KEYS=('pingpong','dive','antigrav')
_SIEGE_LIVE_DT=1/60
_SIEGE_MANUAL_ROUNDS={}
_SIEGE_SLOW=(.9,.8,.7,.6,.5)
def _siege_has_controls(r,selection,side,config):
    return bool(config and config.get('manual') and not _siege_robot(r,side) and any((selection if isinstance(selection,dict) else {}).get(k) if r.get('buffMode')=='stock' else r['buffs'][side].get(k) for k in (() if _siege_v24(r) else _SIEGE_MANUAL_KEYS)))

def _siege_control_clock(rt,now):
    # Fixed simulation ticks; bullet time affects the authoritative whole world.
    old=rt.get('wall',now);rt['wall']=now
    elapsed=max(0.,min(1.,now-old))
    slow=max(0.,min(elapsed,rt.get('slowUntil',0)-old))
    rt['credit']=rt.get('credit',0.)+elapsed-slow*(1-rt.get('slowRate',1.))
    steps=min(60,int((rt['credit']+1e-9)/_SIEGE_LIVE_DT))
    rt['credit']-=steps*_SIEGE_LIVE_DT
    return steps

def _siege_command(rt,side,k,shot,now,target=None):
    entry=rt['active'].get(side);c=entry and entry.get('control');sample=entry and entry['sample']
    if not c or not sample or shot!=sample['shotNo'] or k not in _SIEGE_MANUAL_KEYS or not sample.get('controls',{}).get(k) or not c['left'].get(k):
        raise ValueError('当前没有可用操纵次数')
    if c.get('pending'):raise ValueError('上一项操纵正在执行')
    c['left'][k]-=1;c['pending'].append(k)
    rate=_SIEGE_SLOW[min(5,c['levels'][k])-1]
    rt['slowRate']=min(rate,rt.get('slowRate',1.) if now<rt.get('slowUntil',0.) else 1.)
    rt['slowUntil']=now+1.2
    sample['controls'][k]=c['left'][k]

def _siege_v24_skill(r,side,k,target,now):
    # No immediate-consumption action in v24; all choices travel in shot selection.
    raise ValueError('请在增益面板选择数量，开炮时生效')

def _siege_manual_start(r,side,a,p,selection,force,config,now):
    if id(r) in _SIEGE_MANUAL_ROUNDS:raise ValueError('上一炮尚未结束')
    control={}
    gen=_siege_trial_steps(r,a,p,selection or {},force,config,control) if r.get('trial') else _siege_fire_steps(r,a,p,selection,side=side,force=force,config=config,control=control)
    sample=next(gen)
    _SIEGE_MANUAL_ROUNDS[id(r)]={'room':r,'wall':now,'credit':0.,'active':{side:{'gen':gen,'sample':sample,'control':control}},'side':side,'slowUntil':0.,'slowRate':1.}
    r['event']=None

def _siege_manual_tick(r,now):
    rt=_SIEGE_MANUAL_ROUNDS.get(id(r))
    if not rt:return False
    entry=rt['active'][rt['side']]
    for _ in range(_siege_control_clock(rt,now)):
        try:entry['sample']=next(entry['gen'])
        except StopIteration:
            _SIEGE_MANUAL_ROUNDS.pop(id(r),None)
            r['event']=None;r['until']=now+.35
            return True
    return False

def _siege_manual_view(r,v,now):
    rt=_SIEGE_MANUAL_ROUNDS.get(id(r))
    if rt:
        v.update(busy=True,event=None,manualFlight=True,liveShots=[e['sample'] for e in rt['active'].values()],slowRate=rt['slowRate'] if now<rt['slowUntil'] else 1.,motionTime=rt['active'][rt['side']]['sample']['motionTime'])
    return v

def _siege_live_runtime(r,now=None):
    now=time.time() if now is None else now
    # A restarted server has no resumable Python generators. Recover a falling core safely.
    for b in r['bodies']:
        if b.pop('teleportFall',False):
            b.pop('fixed',None);b['y']=min(b['y'],_siege_floor(r,b['x'])-b['h']/2);b['vy']=0.
    return {'room':r,'clock':now,'active':{},'ready':[now,now],'physicsFns':{},'dropQueues':{}}

def _siege_live_can_fire(r,rt,side,now):
    return (r['phase']=='play' and min(_siege_core(r['bodies'],i) for i in (0,1))>0 and side not in rt['active'] and now>=rt['ready'][side] and (not r.get('ammo') or r['shots'][side]<r['ammo']))

def _siege_live_start(r,rt,side,angle,power,selection=None,now=None,force=False,config=None):
    now=time.time() if now is None else now
    if not _siege_live_can_fire(r,rt,side,now):raise ValueError('上一发尚未结束、正在装填或弹药耗尽')
    control={} if rt.get('interactive') and _siege_has_controls(r,selection,side,config) else None
    gen=_siege_fire_steps(r,angle,power,selection,side,rt,force,config,control)
    sample=next(gen) # validates and reserves buffs before exposing shot
    r['shots'][side]+=1;r['rev']+=1
    rt['active'][side]={'gen':gen,'sample':sample,'control':control};rt['ready'][side]=float('inf')

def _siege_live_tick(r,rt,now=None):
    now=time.time() if now is None else now;changed=False
    # Both shots share bodies/items and advance on the same fixed timestep.
    # Limit catch-up after a device sleeps; no huge CPU burst under the room lock.
    if not rt['active']:rt['clock']=now;_siege_motion(r,max(0,now-r['motionEpoch']))
    else:
        steps=_siege_control_clock(rt,now) if rt.get('interactive') else min(180,max(0,int((now-rt['clock'])/_SIEGE_LIVE_DT)))
        for _ in range(steps):
            rt['clock']+=_SIEGE_LIVE_DT
            sides=list(rt['active']);
            if rt.get('interactive'):
                rt['step']=rt.get('step',0)+1
                if rt['step']%2:sides.reverse()
            for side in sides:
                entry=rt['active'][side]
                try:entry['sample']=next(entry['gen'])
                except StopIteration:
                    del rt['active'][side];rt['physicsFns'].pop(side,None);rt['dropQueues'].pop(side,None);rt.get('shellShields',{}).pop(side,None);rt.get('shotShields',{}).pop(side,None);rt['ready'][side]=max(rt['clock'],now)+r.get('reloadSeconds',5);r['rev']+=1;changed=True
            if not rt['active']:break
            # Shared rigid-body world advances once, even if a shot is in teleport descent.
            rt['physicsFns'][next(iter(rt['active']))]()
    cores=[_siege_core(r['bodies'],i) for i in (0,1)];ammo=r.get('ammo',0)
    if r['phase']=='play' and not rt['active'] and (min(cores)<=0 or (ammo and all(n>=ammo for n in r['shots']))):
        r['phase']='over';r['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0]);r['rev']+=1;changed=True
    return changed

def _siege_live_public(r,rt,key):
    v=_siege_public(r,key,r['rev']);now=time.time();seat=v['seat'];v.update(combatMode='live',event=None,busy=seat in rt['active'],liveShots=[e['sample'] for e in rt['active'].values()],reload=[0 if i in rt['active'] else max(0,round(rt['ready'][i]-now,2)) for i in (0,1)],canFire=_siege_live_can_fire(r,rt,seat,now),liveActive=bool(rt['active']),motionTime=max(0,rt['clock']-r['motionEpoch']),wind=r.get('windPair',0)*(1 if seat==0 else -1))
    return v

def _siege_sync_runtime(r,now=None):
    now=time.time() if now is None else now
    return {'room':r,'round':1,'deadline':_siege_prep_deadline(r,now),'plans':[None,None],'configs':[None,None],'force':[False,False],'locked':[False,False],'replay':None,'until':0.,'notice':['','']}

def _siege_prep_seconds(r):
    n=r.get('reloadSeconds',15);return n if type(n) is int and 0<=n<=120 else 15

def _siege_prep_deadline(r,now):
    seconds=_siege_prep_seconds(r)
    return now+seconds if seconds else None

def _siege_sync_plan(r,rt,side,data,lock=False):
    if r['phase']!='play' or rt['replay'] or rt.get('activeEngine') or rt['locked'][side]:raise ValueError('当前不能调整炮击')
    if data.get('round')!=rt['round']:raise ValueError('准备阶段已切换')
    a,p=data.get('angle'),data.get('power')
    if type(a) not in (int,float) or type(p) not in (int,float) or not (0<=a<360 and 15<=p<=100):raise ValueError('角度或力度无效')
    chosen=_siege_selection(r,data.get('selection'),side)
    force=data.get('force') is True
    if lock:_siege_launch_check(r,side,a,chosen,max(0,time.time()-r.get('motionEpoch',time.time())),force)
    cfg=_siege_public_config(data.get('config'))
    rt['plans'][side]=(a,p,chosen);rt['force'][side]=force;rt.setdefault('configs',[None,None])[side]=cfg
    if lock:rt['locked'][side]=True

def _siege_sync_compute(r,rt,now):
    # Atomic round: validate/compute on a copy; the two generators share the same world.
    import copy
    w=copy.deepcopy(r);engine=_siege_live_runtime(w,now);w['reloadSeconds']=0
    interactive=any(_siege_has_controls(w,(rt['plans'][side] or (42,65,{}))[2],side,rt.get('configs',[None,None])[side]) for side in (0,1))
    if interactive:engine.update(interactive=True,wall=now,credit=0.,slowUntil=0.,slowRate=1.)
    plans=[x or (42,65,{}) for x in rt['plans']];notices=['','']
    # Both stock defenses are armed before either shot consumes the opposing defense.
    if w.get('buffMode')=='stock':
        for side in (0,1):
            a,p,sel=plans[side];sel=dict(sel);armed=w.setdefault('armed',[{},{}])[side]
            for k in _SIEGE_DEFENSE:
                n=sel.pop(k,0)
                if n:armed[k]=min(_siege_cap(w,k),armed.get(k,0)+n);w['buffs'][side][k]-=n
            plans[side]=(a,p,sel)
    for side,(a,p,sel) in enumerate(plans):
        if w.get('ammo') and w['shots'][side]>=w['ammo']:continue
        try:_siege_live_start(w,engine,side,a,p,sel,now,rt['force'][side],rt.get('configs',[None,None])[side])
        except ValueError:
            # Moving terrain may obstruct a prepared giant shell at the deadline.
            if w.get('buffMode')=='stock':
                sel=dict(sel);sel.pop('big',None);_siege_live_start(w,engine,side,a,p,sel,now,config=rt.get('configs',[None,None])[side])
            else:
                n=w['buffs'][side]['big'];w['buffs'][side]['big']=0
                try:_siege_live_start(w,engine,side,a,p,None,now,config=rt.get('configs',[None,None])[side])
                finally:w['buffs'][side]['big']+=n
            notices[side]='巨型弹炮口受阻，本轮未消耗巨型弹'
    if interactive:
        rt.update(activeEngine=engine,notice=notices,settleFn=next(iter(engine['physicsFns'].values()),None));r['event']=None;return
    frames=[];meta={};items={};step=0
    def capture():
        t=step*_SIEGE_LIVE_DT
        for b in w['bodies']:meta[b['id']]={k:v for k,v in b.items() if k not in ('vx','vy','motionY','baseY','phase')}
        for it in w['items']:items[it['id']]=dict(it)
        frames.append([round(t,3),[_siege_pos(b) for b in w['bodies']],copy.deepcopy([e['sample'] for e in engine['active'].values()]),[list(_siege_launcher(i,w,max(0,now-w['motionEpoch'])+t)) for i in (0,1)],[it['id'] for it in w['items']],[dict(m) for m in w.get('mines',[])],[b['id'] for b in w['bodies'] if b.get('burnRounds',0)>0 and b['hp']>0]])
    capture()
    settle_fn=next(iter(engine['physicsFns'].values()),None)
    while engine['active']:
        step+=1;engine['clock']=now+step*_SIEGE_LIVE_DT
        # Alternate iteration order by tick to avoid systematically favoring one player.
        for side in sorted(engine['active'],reverse=bool(step%2)):
            entry=engine['active'][side]
            try:entry['sample']=next(entry['gen'])
            except StopIteration:
                del engine['active'][side];engine['physicsFns'].pop(side,None);engine['dropQueues'].pop(side,None);engine.get('shotShields',{}).pop(side,None);engine.get('shellShields',{}).pop(side,None)
        if engine['active']:engine['physicsFns'][next(iter(engine['active']))]()
        if step%6==0 or not engine['active']:capture()
    if _siege_burn_round(w) and settle_fn:
        # Reuse the same rigid-body integrator after the final shot, so burning
        # supports collapse identically in turn and simultaneous modes.
        for j in range(120):
            step+=1;settle_fn()
            if j%6==0:capture()
        capture()
    for b in w['bodies']:b['vx']=b['vy']=0.
    cores=[_siege_core(w['bodies'],i) for i in (0,1)];ammo=w.get('ammo',0)
    if min(cores)<=0 or (ammo and all(n>=ammo for n in w['shots'])):
        w['phase']='over';w['winner']=None if abs(cores[0]-cores[1])<.01 else int(cores[1]>cores[0])
    w['rev']+=1;w['reloadSeconds']=r.get('reloadSeconds',15);w['event']=None
    duration=frames[-1][0];timing=_siege_replay_timing(frames,duration,sync=True,bodies=meta.values()) if _siege_v24(w) else {}
    w['until']=time.time()+(_SIEGE_REPLAY_PREROLL+timing['playbackDuration']+.10 if timing else duration+.35)
    r.clear();r.update(w)
    rt.update(replay={'id':r['rev'],'duration':duration,'frames':frames,'meta':list(meta.values()),'items':list(items.values()),'motionStart':max(0,now-w['motionEpoch']),**timing},until=r['until'],notice=notices)

def _siege_sync_tick(r,rt,now=None):
    now=time.time() if now is None else now
    engine=rt.get('activeEngine')
    if engine:
        w=engine['room'];_siege_live_tick(w,engine,now)
        if engine['active']:return False
        if _siege_burn_round(w) and rt.get('settleFn'):
            for _ in range(120):rt['settleFn']()
        for b in w['bodies']:b['vx']=b['vy']=0.
        w['reloadSeconds']=r.get('reloadSeconds',15);w['until']=now+.35;w['event']=None;w['rev']+=1
        r.clear();r.update(w);rt.pop('activeEngine');rt.pop('settleFn',None)
        rt.update(round=rt['round']+1,deadline=_siege_prep_deadline(r,now),plans=[None,None],configs=[None,None],force=[False,False],locked=[False,False],replay=None,notice=['',''])
        if r['phase']=='play':r['windPair']=_siege_weather(r.get('windLevel','off'))
        return True
    if rt['replay']:
        if now<rt['until']:return False
        rt.update(round=rt['round']+1,deadline=_siege_prep_deadline(r,now),plans=[None,None],configs=[None,None],force=[False,False],locked=[False,False],replay=None,notice=['',''])
        if r['phase']=='play':r['windPair']=_siege_weather(r.get('windLevel','off'))
        return False
    if r['phase']!='play':return False
    if r['bot'] and not rt['locked'][1]:
        plan={'planOnly':True};_siege_bot(r,plan);rt['plans'][1]=plan['plan'];rt['configs'][1]=_siege_config({'simple':True,'unified':True,'delayedSplit':True});rt['locked'][1]=True
    if all(rt['locked']) or (rt['deadline'] is not None and now>=rt['deadline']):
        _siege_sync_compute(r,rt,now);return True
    return False

def _siege_sync_public(r,rt,key,last=-1):
    engine=rt.get('activeEngine');world=engine['room'] if engine else r
    v=_siege_public(world,key,world['rev']);seat=v['seat'];replay=rt['replay'];busy=bool(replay or engine)
    v.update(combatMode='sync',event=None,busy=busy,round=rt['round'],ready=list(rt['locked']),remaining=(None if rt['deadline'] is None else max(0,round(rt['deadline']-time.time(),2))) if not busy else 0,canFire=r['phase']=='play' and not busy,liveShots=[],wind=r.get('windPair',0)*(1 if seat==0 else -1),syncNotice=rt['notice'][seat],myPlan=rt['plans'][seat],myConfig=rt.get('configs',[None,None])[seat],replayId=replay['id'] if replay else None)
    if engine:v.update(manualFlight=True,liveShots=[e['sample'] for e in engine['active'].values()],slowRate=engine['slowRate'] if time.time()<engine['slowUntil'] else 1.,motionTime=max(0,engine['clock']-world['motionEpoch']))
    if replay and last!=replay['id']:
        v['replay']=replay;v['replayElapsed']=(replay['playbackDuration']+.10-(rt['until']-time.time())) if 'playbackDuration' in replay else max(0,replay['duration']+.35-(rt['until']-time.time()))
    return v

def _siege_bot_fire(r,a,p,live=None,planned=None):
    selection={k:min(_siege_cap(r,k),2,n) for k,n in r['buffs'][1].items() if n>0 and (k in _SIEGE_SELECTABLE or (_siege_v24(r) and k=='heal')) and k not in _SIEGE_ONE_SHOT} if r.get('buffMode')=='stock' else None
    if planned is not None:selection=planned
    if live is not None and live.get('planOnly'):
        live['plan']=(a,p,selection or {});return
    if live is not None and selection is not None:
        for k in _SIEGE_DEFENSE:
            if k in selection:
                selection[k]=min(selection[k],max(0,_siege_cap(r,k)-r.get('armed',[{},{}])[1].get(k,0)))
                if not selection[k]:selection.pop(k)
    def shoot(angle,selection):
        if live is not None:_siege_live_start(r,live,1,angle,p,selection,config={'simple':True,'unified':True,'delayedSplit':True})
        else:_siege_fire(r,angle,p,selection,config={'simple':True,'unified':True,'delayedSplit':True})
    if planned is not None:
        # Never silently redirect a building shot to another angle or use a different payload.
        try:shoot(a,selection);return
        except ValueError:
            safe={k:n for k,n in selection.items() if k not in ('wooddrop','stonedrop','big','splitshot','repeat','through')}
            shoot(a,safe);return
    for angle in ((a,135,155,175,105,90,75,45,5) if a>90 else (a,45,25,5,75,90,115,145,175)):
        try:shoot(angle,selection);return
        except ValueError:continue
    # A fort can physically surround the gun; fire an ordinary round if blocked.
    if selection is not None:selection.pop('big',None);shoot(a,selection)
    else:
        n=r['buffs'][1]['big'];r['buffs'][1]['big']=0
        try:shoot(a,None)
        finally:r['buffs'][1]['big']+=n

def _siege_bot(r,live=None):
    if r.get('theme')=='zombie':
        bodies=r['bodies'];core=_siege_core_body(bodies,0);sx,sy=_siege_launcher(1,r)
        targets=[b for b in bodies if b['kind']=='zombie' and b['hp']>0]
        inv=r['buffs'][1];direction=_siege_direction(r,1)
        selection={k:1 for k in ('shield','armor') if inv.get(k,0)>0 and r['armed'][1].get(k,0)<_siege_cap(r,k)}
        if inv.get('heal',0)>0 and core['hp']<=82:selection['heal']=1
        target=min(targets,key=lambda b:abs(b['x']-core['x'])/max(1,_SIEGE_ZOMBIE_TYPES[b['zombieType']][3]),default=None)
        build=None
        if target:
            d=1 if target['x']>core['x'] else -1
            # A barricade must be between the advancing enemy and the core, ahead of the gun
            # only if there is enough distance for safe projectile clearance.
            near=abs(target['x']-core['x'])
            gun_xs=[_siege_launcher(i,r)[0] for i in (0,1)]
            candidates=[xx for xx in range(45,916,10)
                if 65<d*(xx-core['x'])<near-50
                and all(abs(xx-gx)>85 for gx in gun_xs)
                and not any(b['hp']>0 and b['kind'] in ('wood','stone') and abs(b['x']-xx)<55 for b in bodies)]
            if candidates:
                # Prefer a forward position that intercepts a wave before it reaches a gun.
                x=min(candidates,key=lambda xx:abs(d*(xx-core['x'])-min(near-55,max(130,near*.56))))
                build=next((k for k in ('stonedrop','wooddrop') if inv.get(k,0)>0),None)
        best_attack=None;best_build=None
        for a in range(0,360,6):
            rad=math.radians(a)
            for power in range(20,101,5):
                px,py=_siege_muzzle(1,r,a);vx=direction*power*8*math.cos(rad);vy=-power*8*math.sin(rad)
                hit=None
                for j in range(1,181):
                    px+=vx/60;py+=vy/60;vy+=_SIEGE_GRAV/60
                    if px<=6 or px>=954 or py>=_siege_floor(r,px)-6:break
                    hit=next((b for b in bodies if b['hp']>0 and not (b.get('kind')=='cannon' and b['side']==1 and j<8) and abs(px-b['x'])<=b['w']/2+6 and abs(py-b['y'])<=b['h']/2+6),None)
                    if hit:break
                if hit and hit['kind']=='zombie':
                    score=abs(hit['x']-core['x'])/max(1,_SIEGE_ZOMBIE_TYPES[hit['zombieType']][3])
                    if hit.get('zombieType') in ('priest','dancer','guard','bomber'):score*=.75
                else:
                    score=1000+min((math.hypot(px-b['x'],py-b['y']) for b in targets),default=500)+(300 if hit and hit['side'] in (0,1) else 0)
                candidate=(score,a,power)
                if best_attack is None or candidate<best_attack:best_attack=candidate
                if build and hit is None and 20<px<940 and py>=_siege_floor(r,px)-12:
                    candidate=(abs(px-x),a,power)
                    if best_build is None or candidate<best_build:best_build=candidate
        if build and best_build and best_build[0]<35 and (best_attack[0]>=1000 or r['zombie']['round']%3==0):
            selection[build]=min(2,inv[build]);_,a,p=best_build
        else:
            _,a,p=best_attack
            # Offensive rounds do not spend building materials or random trajectory modifiers.
            for k in ('pierce','through'):
                if inv.get(k,0)>0:selection[k]=1
            if best_attack[0]<1000 and inv.get('big',0)>0 and 15<a<165:
                try:_siege_launch_check(r,1,a,{'big':1});selection['big']=1
                except ValueError:pass
        _siege_bot_fire(r,a,p,live,selection);return
    # For unusual layouts, choose a trajectory that clears our own fort and any platforms.
    if r.get('field') in _SIEGE_NEW_FIELDS:
        sx,sy=_siege_launcher(1,r);wind=-r.get('windPair',0) if live is not None else r.get('wind',0);now=max(0,time.time()-r.get('motionEpoch',time.time()));choices=[]
        for a in range(5,176,5):
            for p in range(40,101,5):
                rad=math.radians(a);v=p*8;score=-1
                for j in range(1,121):
                    t=j*.04;x=sx-(43+v*t)*math.cos(rad)+.5*wind*t*t;y=sy-(43+v*t)*math.sin(rad)+.5*_SIEGE_GRAV*t*t
                    if x<0 or x>960 or y>_siege_floor(r,x)-6:break
                    hit=next((b for b in r['bodies'] if b['hp']>0 and abs(x-b['x'])<=b['w']/2+6 and abs(y-(b['baseY']+b['motionY']*math.sin((now+t)*.8+b.get('phase',0)) if b.get('motionY') else b['y']))<=b['h']/2+6),None)
                    if hit:
                        score=(3 if hit['kind']=='core' else 2) if hit['side']==0 else (0 if hit['side']==-1 else -2);break
                if score>=2:choices.append((score,a,p))
        if choices:
            _,a,p=random.choice([x for x in choices if x[0]==max(y[0] for y in choices)])
            _siege_bot_fire(r,a,p,live);return
    # Invert the same ballistic equations, then add small aiming error.
    targets=[b for b in r['bodies'] if b['side']==0 and b['hp']>0]
    core=next((b for b in targets if b['kind']=='core'),None)
    target=core if core and core['x']>_siege_launcher(1,r)[0] else random.choice(targets) if targets else None
    tx=target['x'] if target else 122;ty=target['y'] if target else 380
    sx,sy=_siege_launcher(1,r);wind=-r.get('windPair',0) if live is not None else r.get('wind',0)
    # Select the correct hemisphere using actual target position, not the seat index.
    # Search reachable launch solutions using the true muzzle and ballistic equations.
    candidates=[];right=tx>sx
    for a in (range(95,176,5) if right else range(5,86,5)):
        rad=math.radians(a);x,y=_siege_muzzle(1,r,a);dx=tx-x;dy=ty-y
        den=.5*(_SIEGE_GRAV-wind*math.tan(rad))
        if abs(den)<1e-6:continue
        q=(dy-dx*math.tan(rad))/den
        if q<=0:continue
        t=math.sqrt(q);v=(.5*wind*t*t-dx)/(math.cos(rad)*t)
        if 15<=v/8<=100:candidates.append((a,v/8))
    if candidates:a,p=random.choice(candidates);_siege_bot_fire(r,a,max(15,min(100,p+random.uniform(-2.5,2.5))),live)
    else:_siege_bot_fire(r,135 if right else 45,65,live)

def _siege_public(r,key,last):
    _siege_migrate_catalog(r)
    seat=next(i for i,p in enumerate(r['players']) if p['key']==key)
    v={'rulesVersion':r.get('rulesVersion',23),'theme':r.get('theme','classic'),'ok':True,'code':r['code'],'seat':seat,'players':[p['name'] for p in r['players']],'phase':r['phase'],'turn':r['turn'],'shots':r['shots'],'winner':r['winner'],'rev':r['rev'],'bodies':[{k:v for k,v in b.items() if k not in ('vx','vy')} for b in r['bodies']],'cores':[_siege_core(r['bodies'],i) for i in (0,1)],'event':r['event'] if last!=r['rev'] else None,'busy':time.time()<r['until'],'bot':r['bot'],'trial':bool(r.get('trial')),'trialDamage':r.get('trialDamage',0),'items':r['items'],'buffs':r['buffs'],'compoundRecipes':r.get('compoundRecipes',[None,None]),'ammo':r.get('ammo',_SIEGE_MAX_SHOTS),'offset':r.get('offset',0),'layout':r.get('layout','tower'),'mode':r.get('mode','classic'),'wind':r.get('wind',0),'windLevel':r.get('windLevel','off'),'launchers':[_siege_launcher(i,r,0) if not r.get('gunMotion') else list(r['launchers'][i]) for i in range(r.get('zombiePlayerCount',2) if r.get('theme')=='zombie' else 2)],'gunMotion':r.get('gunMotion',[]),'rise':r.get('rise',0),'field':r.get('field',r.get('mode','classic')),'fieldLabel':r.get('fieldLabel','战场'),'respawns':r.get('respawns',[]),'motionTime':max(0,time.time()-r.get('motionEpoch',time.time())),'buffMode':r.get('buffMode','auto'),'combatMode':r.get('combatMode','turn'),'reloadSeconds':r.get('reloadSeconds',5),'armed':r.get('armed',[{},{}]),'negativePending':r.get('negativePending',[{},{}]),'clones':r.get('clones',[]),'mines':r.get('mines',[]),'stackMax':_SIEGE_STACK_MAX,'stackCaps':_siege_caps(r),'fortStrength':r.get('fortStrength','normal'),'reflectors':r.get('reflectors',[]),'allowedBuffs':list(_siege_allowed(r))}
    if r.get('terrain'):v['terrain']=r['terrain']
    if r.get('theme')=='zombie':v['zombie']={**r['zombie'],'solo':bool(r.get('zombieSolo')),'bothSides':bool(r.get('zombieBothSides')),'remaining':sum(b['kind']=='zombie' and b['hp']>0 for b in r['bodies'])}
    if r.get('trial'):v['zombieCatalog']={k:dict(hp=stats[2],speed=stats[3],damage=stats[4]) for k,stats in _SIEGE_ZOMBIE_TYPES.items() if k!='engineer'};v['trialZombieLimit']=_SIEGE_TRIAL_ZOMBIE_LIMIT
    return _siege_manual_view(r,v,time.time())

def siege_request(data):
    key=str(data.get('key',''));kind=data.get('type');code=str(data.get('code','')).upper();now=time.time()
    if len(key)!=48 or any(c not in '0123456789abcdef' for c in key):return {'ok':False,'error':'会话无效，请刷新'}
    for k in list(_SIEGE_ROOMS):
        if now-_SIEGE_ROOMS[k]['touched']>86400:
            _SIEGE_MANUAL_ROUNDS.pop(id(_SIEGE_ROOMS[k]),None);del _SIEGE_ROOMS[k]
    if kind=='create':
        if len(_SIEGE_ROOMS)>=64:return {'ok':False,'error':'房间已满'}
        code=secrets.token_hex(3).upper()
        while code in _SIEGE_ROOMS:code=secrets.token_hex(3).upper()
        name=str(data.get('name','玩家')).strip()[:12] or '玩家'
        allowed=data.get('allowedBuffs')
        if allowed is not None and (not isinstance(allowed,list) or len(allowed)>len(_SIEGE_ITEMS) or len(set(map(str,allowed)))!=len(allowed) or any(type(x) is not str or x not in _SIEGE_ITEMS for x in allowed)):
            return {'ok':False,'error':'增益选择无效'}
        trial=data.get('trial') is True
        r=_siege_new(name,key,trial or data.get('bot') is True,allowed_buffs=None if trial else allowed);r['code']=code
        if data.get('rulesVersion')==24:
            r['allowedBuffs']=list(_SIEGE_V24_KEYS) if trial or allowed is None else allowed
            difficulty=data.get('zombieDifficulty','medium')
            if not isinstance(difficulty,str) or difficulty not in _SIEGE_ZOMBIE_DIFFICULTIES:return {'ok':False,'error':'难度无效'}
            r['zombieDifficulty']=difficulty
            map_key=data.get('zombieMap','front')
            if not isinstance(map_key,str) or map_key not in (*_SIEGE_ZOMBIE_MAPS,'random'):return {'ok':False,'error':'地图无效'}
            r['zombieMap']=map_key
            _siege_v24_setup(r,data.get('theme','classic'),data.get('rarities') if isinstance(data.get('rarities'),dict) else {});_siege_field(r)
        if trial:
            r['players'][1]['name']='不毁靶场';r['stackCaps']=dict(_SIEGE_HARD_CAPS);_siege_trial_reset(r,'standard')
        _SIEGE_ROOMS[code]=r;return _siege_public(r,key,-1)
    r=_SIEGE_ROOMS.get(code)
    if not r:return {'ok':False,'error':'房间不存在或已关闭'}
    seat=next((i for i,p in enumerate(r['players']) if p['key']==key),None)
    if kind=='join' and seat is None:
        if r['phase']!='wait' or len(r['players'])>=2:return {'ok':False,'error':'房间已满'}
        r['players'].append({'name':str(data.get('name','玩家')).strip()[:12] or '玩家','key':key});r['phase']='play';seat=1
    if seat is None:return {'ok':False,'error':'不在这个房间'}
    r['touched']=now;_siege_migrate_catalog(r);_siege_manual_tick(r,now)
    if kind=='skill':
        try:_siege_v24_skill(r,seat,data.get('action'),data.get('target'),now)
        except ValueError as e:return {'ok':False,'error':str(e)}
    elif kind=='maneuver':
        try:_siege_command(_SIEGE_MANUAL_ROUNDS.get(id(r),{'active':{}}),seat,data.get('action'),data.get('shotNo'),now,data.get('target'))
        except ValueError as e:return {'ok':False,'error':str(e)}
    elif id(r) in _SIEGE_MANUAL_ROUNDS and kind!='state':return {'ok':False,'error':'请等待本炮结束'}
    elif kind=='fire':
        if r['phase']!='play' or r['turn']!=seat or now<r['until'] or data.get('rev')!=r['rev']:return {'ok':False,'error':'当前不能发射，请等待回合'}
        a,p=data.get('angle'),data.get('power')
        if type(a) not in (int,float) or type(p) not in (int,float) or not (0<=a<360 and 15<=p<=100):return {'ok':False,'error':'角度或力度无效'}
        try:
            cfg=_siege_public_config(data.get('config'));sel=data.get('selection');force=data.get('force') is True
            if _siege_has_controls(r,sel,seat,cfg):_siege_manual_start(r,seat,a,p,sel,force,cfg,now)
            else:_siege_fire(r,a,p,sel,force,cfg)
        except ValueError as e:return {"ok":False,"error":str(e)}
    elif kind=='trialPreview' and r.get('trial') and seat==0:
        if now<r['until']:return {'ok':False,'error':'请等待本炮结束'}
        a,p=data.get('angle'),data.get('power')
        if type(a) not in (int,float) or type(p) not in (int,float) or not (0<=a<360 and 15<=p<=100):return {'ok':False,'error':'角度或力度无效'}
        import copy
        shadow=copy.deepcopy(r);rng=random.getstate()
        try:
            _siege_trial_fire(shadow,a,p,data.get('selection') or {},False,_siege_public_config(data.get('config')))
            ev=shadow['event'];paths={-1:[]}
            for f in ev['frames']:
                if f[1]:paths[-1].append(f[1])
                for ident,x,y in f[3]:paths.setdefault(ident,[]).append([x,y])
            return {'ok':True,'paths':[v for v in paths.values() if len(v)>1],'impact':ev['impact'],'damage':ev['trialDamage'],'duration':ev['duration']}
        except ValueError as e:return {'ok':False,'error':str(e)}
        finally:random.setstate(rng)
    elif kind=='trialSummon' and r.get('trial') and seat==0:
        if now<r['until']:return {'ok':False,'error':'请等待当前炮击结束'}
        try:_siege_trial_summon(r,data.get('zombieType'),data.get('count',1))
        except ValueError as e:return {'ok':False,'error':str(e)}
    elif kind=='trialClearZombies' and r.get('trial') and seat==0:
        if now<r['until']:return {'ok':False,'error':'请等待当前炮击结束'}
        r['bodies']=[b for b in r['bodies'] if not (b['kind']=='zombie' and b.get('trialSpecimen'))]
        r['event']=None;r['rev']+=1
    elif kind=='trialReset' and r.get('trial') and seat==0:
        if now<r['until']:return {'ok':False,'error':'请等待本炮结束'}
        try:_siege_trial_reset(r,data.get('mode'))
        except ValueError as e:return {'ok':False,'error':str(e)}
    elif kind=='rematch':
        if r['phase']!='over' or now<r['until']:return {'ok':False,'error':'本局尚未结束'}
        _siege_rematch(r)
    elif kind not in ('state','join'):return {'ok':False,'error':'未知操作'}
    if id(r) not in _SIEGE_MANUAL_ROUNDS and r['bot'] and not r.get('trial') and r['phase']=='play' and r['turn']==1 and now>=r['until']+.65:_siege_bot(r)
    return _siege_public(r,key,data.get('last',-1))

_siege_get_base=Handler.do_GET
_siege_post_base=Handler.do_POST
def _siege_get(self):
    if urlparse(self.path).path=='/siege':return self.reply(SIEGE_PAGE,200,'text/html; charset=utf-8')
    return _siege_get_base(self)
def _siege_post(self):
    if urlparse(self.path).path!='/api/siege':return _siege_post_base(self)
    try:
        if not 0<int(self.headers.get('Content-Length','0'))<=4096:raise ValueError('length')
        data=self.read_json()
        if not isinstance(data,dict):raise ValueError('data')
        with LOCK:response=siege_request(data)
        return self.reply(response)
    except (ValueError,TypeError,KeyError):return self.reply({'ok':False,'error':'请求无效'},400)
Handler.do_GET=_siege_get
Handler.do_POST=_siege_post
