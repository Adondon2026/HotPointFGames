        due=[b for b in bodies if b['hp']>0 and b['kind'] in _SIEGE_TNT_KINDS and b.get('tntDeadline',float('inf'))<=now+1e-8]
        for b in due:b['hp']=0.;b['detonated']=True
        for b in due:physical_blast(b['x'],b['y'],92,32,12,360,source=b.get('tntSource',b.get('side')))
    def tick_barrels():
        nonlocal last_hit,settled
