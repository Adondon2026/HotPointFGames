# Castle duel: isolated transient rooms, server-authoritative 2D block physics.
import math
_SIEGE_ROOMS={}
_SIEGE_W,_SIEGE_H,_SIEGE_G=960,480,416
_SIEGE_GRAV=460.0
_SIEGE_MAX_SHOTS=6
_SIEGE_AMMO=tuple(range(0,101))
_SIEGE_WIND={"off":0,"low":30,"medium":70,"high":125}
_SIEGE_FIELDS={
    'standard': {'label':'标准对射','offset':0,'layout':'tower','rise':0,'pool':('power','big','heal')},
    'close': {'label':'近距突击','offset':55,'layout':'wall','rise':0,'gunShift':45,'pool':('pierce','shield','through')},
    'far': {'label':'远距高抛','offset':-30,'layout':'tower','rise':0,'gunShift':-38,'pool':('big','splitshot','power')},
    'peaks': {'label':'露顶堡垒','offset':0,'layout':'opentop','rise':95,'gunShift':12,'pool':('dive','splitshot','bounceblast','wooddrop')},
    'obstacle': {'label':'双层穿透堡','offset':-8,'layout':'layers','rise':0,'gunShift':-15,'pool':('through','bounceblast','splitshot','pierce')},
    'fragments': {'label':'悬重堡垒','offset':12,'layout':'suspended','rise':0,'gunShift':25,'pool':('ignite','firetrail','firearc','shock')},
}
_SIEGE_NEW_FIELDS={
    'overtop': {'label':'反射要塞','offset':208,'layout':'opentop','rise':0,'gunShift':-368,'gunX':75,'pool':('bounce','bounceblast','splitshot','pingpong')},
    'sky': {'label':'空中城堡','offset':158,'layout':'split','rise':0,'gunShift':-283,'gunX':110,'pool':('bounceblast','splitshot','dive','antigrav')},
    'floating': {'label':'浮岛对决','offset':60,'layout':'split','rise':0,'gunX':300,'gunY':250,'pool':('bounce','wooddrop','stonedrop')},
    'floatingcenter': {'label':'浮空夹击','offset':205,'layout':'wall','rise':0,'gunX':100,'gunY':285,'pool':('bounce','big','wooddrop')},
    'movingwall': {'label':'移动屏障','offset':0,'layout':'wall','rise':0,'gunX':235,'pool':('through','shock','power')},
}
_SIEGE_MAP_POOLS={
    'pool_small': ('close','floating','fragments'),
    'pool_medium': ('standard','peaks','obstacle','movingwall'),
    'pool_large': ('far','overtop','sky','floatingcenter'),
}
_SIEGE_MODES=('classic','dynamic','random',*_SIEGE_MAP_POOLS,*_SIEGE_FIELDS,*_SIEGE_NEW_FIELDS)
_SIEGE_STACK_MAX=5
_SIEGE_NEGATIVE=('heavy','vanish','wobble','fart')
_SIEGE_TNT_KEYS=('tntdrop','tntwait')
_SIEGE_ELITE_KEYS=('demolish','salvage','compound')
# Curated, synergistic recipes. One pickup stores one recipe; no roll on fire.
_SIEGE_COMPOUND_RECIPES={
    'breach':('through','pierce'),
    'ricochet':('bounce','bounceblast'),
    'burst':('through','bounceblast'),
    'seek':('homing','pierce'),
    'siegebreak':('through','pierce','bounceblast'),
}
def _siege_compound_recipe(value=None):
    return value if value in _SIEGE_COMPOUND_RECIPES else random.choices(tuple(_SIEGE_COMPOUND_RECIPES),weights=(24,24,24,23,5))[0]

# Simulation is authoritative and fully computed before publishing the replay.
# Presentation time is independent of the lengthy rigid-body settling tail.
_SIEGE_REPLAY_PREROLL=.38
_SIEGE_REPLAY_HANDOFF=.48
def _siege_replay_timing(frames,duration,hit_at=None,sync=False,bodies=(),events=()):
    if not frames:return dict(shellEnd=0.,handoffAt=1.,visualEnd=0.,playbackDuration=1.48)
    # Never accelerate simulation time. Trim only a visually quiet tail.
    last=0.;action=0.;effect_end=0.;prev=None;meta={b['id']:b for b in bodies}
    for i,f in enumerate(frames):
        visible=any(s.get('p') or s.get('fragments') for s in f[2]) if sync else bool((f[1] and (hit_at is None or f[0]<hit_at)) or f[3])
        if visible:last=frames[min(i+1,len(frames)-1)][0]
        if sync:
            for s in f[2]:
                for e in s.get('behaviorEvents',()):
                    if e[0] in ('bounceBlast','salvage','teleport','pushHit','blackholeHit'):action=max(action,f[0]-s.get('age',f[0])+e[1]+.5)
                    if e[0] in ('blackholeStart','pushHit'):effect_end=max(effect_end,f[0]-s.get('age',f[0])+e[1]+(2. if e[0]=='blackholeStart' else 1.3))
        positions=f[1] if sync else f[2]
        if prev is None:prev=(f[0],{b[0]:b for b in positions})
        if f[0]-prev[0]>=.19:
            dt=f[0]-prev[0];old=prev[1]
            for b in positions:
                a=old.get(b[0]);m=meta.get(b[0],{})
                if m.get('motionY') or (m.get('platform') and m.get('fixed')):continue
                if a and (a[3]-b[3]>=1 or (b[3]>0 and math.hypot(b[1]-a[1],b[2]-a[2])>=max(3. if m.get('kind')=='core' else 7.,dt*(18 if m.get('kind')=='core' else 38)))):action=max(action,f[0]+.15)
                elif not a and b[3]>0:action=max(action,f[0]+.15)
            prev=(f[0],{b[0]:b for b in positions})
    for e in events:
        if e[0] in ('bounceBlast','salvage','teleport','pushHit','blackholeHit'):action=max(action,e[1]+.5)
        elif e[0]=='blackholeStart':action=max(action,e[1]+2.)
        if e[0] in ('blackholeStart','pushHit'):effect_end=max(effect_end,e[1]+(2. if e[0]=='blackholeStart' else 1.3))
    end=min(duration,max(last,hit_at or 0.))
    hold=max(1.,end+.18,min(duration,effect_end))
    # Only cut a tail if the final state differs by at most a tiny drift. This
    # prevents accumulating slow movement from becoming a visible snap.
    final={b[0]:b for b in (frames[-1][1] if sync else frames[-1][2])}
    for i in range(len(frames)-1,-1,-1):
        f=frames[i];positions=f[1] if sync else f[2];changed=False
        for b in positions:
            z=final.get(b[0]);m=meta.get(b[0],{})
            if (m.get('platform') and m.get('fixed')) or m.get('motionY'):continue
            if z is None:changed|=b[3]>0;continue
            if abs(z[3]-b[3])>=1 or (z[3]>0 and math.hypot(z[1]-b[1],z[2]-b[2])>(3. if m.get('kind')=='core' else 7.)):changed=True;break
        if changed:action=max(action,frames[min(i+1,len(frames)-1)][0]);break
    visual_end=min(duration,max(end,action))
    return dict(shellEnd=round(end,3),handoffAt=round(hold,3),visualEnd=round(visual_end,3),playbackDuration=round(max(hold+_SIEGE_REPLAY_HANDOFF,visual_end),3))

_SIEGE_TNT_KINDS=('tnt','tnt_wait')
_SIEGE_TNT_SHOT_CAP=8
_SIEGE_TNT_WAIT_CAP=12
_SIEGE_NEW_ATTACK=('spiral','repeat','push','clone','fuse','larpa','bounceblast','downpour','ignite','firetrail','snake','dive','antigrav','homing','pingpong','firearc','shotshield','mine')
_SIEGE_SELECTABLE=(*('big','power','shock','pierce','splitshot','through','bounce','wooddrop','stonedrop','blackhole','gunteleport','coreteleport',*_SIEGE_NEW_ATTACK),*('shield','armor','buffer'),*_SIEGE_TNT_KEYS,*_SIEGE_ELITE_KEYS)


# Each match has a randomized, mirrored field. Charges are consumed per type, never multiplied by count.
_SIEGE_ITEMS={'big':{'label':'巨型弹','color':'#ecc06d'},'power':{'label':'强力弹','color':'#ee8469'},'shock':{'label':'冲击波','color':'#b2a2ed'},'shield':{'label':'护盾','color':'#7bd2e0'},'pierce':{'label':'破甲弹','color':'#f3a4d2'},'armor':{'label':'加固','color':'#a9d693'},'splitshot':{'label':'分裂弹','color':'#f9d19b'},'through':{'label':'穿透弹','color':'#f5a0a5'},'buffer':{'label':'缓冲层','color':'#a9c1ff'},'heal':{'label':'修复','color':'#77dc9e'},'bounce':{'label':'弹跳弹','color':'#83e0c5'},'wooddrop':{'label':'木块生成','color':'#d9a66a'},'stonedrop':{'label':'石块生成','color':'#c2cad8'},'blackhole':{'label':'黑洞弹','color':'#b69bea'},'gunteleport':{'label':'炮台瞬移','color':'#71c9f5'},'coreteleport':{'label':'子刊瞬移','color':'#f5b2eb'},'spiral':{'label':'螺旋弹','color':'#ffabcf'},'repeat':{'label':'连续弹','color':'#fbe199'},'push':{'label':'推进弹','color':'#7ce1d6'},'clone':{'label':'克隆增益','color':'#a4baff'},'heavy':{'label':'重重子弹','color':'#c09d83'},'vanish':{'label':'湮灭子弹','color':'#a6acb7'},'wobble':{'label':'不稳定子弹','color':'#ea8fe3'},'fart':{'label':'屁屁子弹','color':'#9ae3a8'},'fuse':{'label':'定时引信','color':'#f5cc73'},'larpa':{'label':'反弹复制','color':'#8fe0d3'},'bounceblast':{'label':'反弹爆破','color':'#ff9e74'},'downpour':{'label':'向下投弹','color':'#a6c7ff'},'ignite':{'label':'点火弹','color':'#ff965d'},'firetrail':{'label':'燃烧拖尾','color':'#f9b46d'},'snake':{'label':'蛇形弹','color':'#84ded0'},'dive':{'label':'俯冲弹','color':'#a8d7fa'},'antigrav':{'label':'反重力','color':'#c7adf5'},'homing':{'label':'近距追踪','color':'#f8cd88'},'pingpong':{'label':'折返弹','color':'#b3e6ae'},'firearc':{'label':'火焰连线','color':'#f7a15d'},'shotshield':{'label':'弹体护盾','color':'#91e6ed'},'mine':{'label':'待爆地雷','color':'#d8b27a'}}
_SIEGE_ITEMS.update(tntdrop={'label':'TNT生成','color':'#ed8b74'},tntwait={'label':'待爆TNT生成','color':'#dfb66e'},demolish={'label':'拆迁弹','color':'#ffb568'},salvage={'label':'材料回收','color':'#78d9be'},compound={'label':'复合弹','color':'#d5adff'})
_SIEGE_ATTACK=('big','power','shock','pierce')
_SIEGE_DEFENSE=('shield','armor','buffer')
_SIEGE_EXTRA_ATTACK=('splitshot','through','bounce','wooddrop','stonedrop','blackhole','gunteleport','coreteleport',*_SIEGE_NEW_ATTACK)
_SIEGE_ONE_SHOT=('gunteleport','coreteleport')
_SIEGE_SINGLE_ITEMS=('heal',*_SIEGE_ONE_SHOT)
_SIEGE_BARREL=35
_SIEGE_MAX_RADIUS=36

# v0.20.1 upstream: independent room-configured per-projectile stack caps.
# Negative pickups are forced on the next shot and are not inventory buffs.
_SIEGE_HARD_CAPS={k:(1 if k in (*_SIEGE_SINGLE_ITEMS,*_SIEGE_NEGATIVE,'fuse') else 20 if k=='bounce' else 10 if k=='through' else 5) for k in _SIEGE_ITEMS}
_SIEGE_V24_KEYS=('splitshot','repeat','bounce','through','homing','shield','armor','heal','wooddrop','stonedrop','coreteleport','gunteleport','blackhole','bounceblast','pierce','big','push',*_SIEGE_TNT_KEYS,*_SIEGE_ELITE_KEYS,*_SIEGE_NEGATIVE)
_SIEGE_V24_CAPS={k:3 if k in ('splitshot','repeat','shield','demolish','compound') else 1 if k in ('homing','heal','coreteleport','gunteleport','salvage') else 5 for k in _SIEGE_V24_KEYS}
_SIEGE_V24_SKILLS=('shield','armor','heal','coreteleport','gunteleport','wooddrop','stonedrop',*_SIEGE_TNT_KEYS,'salvage')
_SIEGE_V24_LEVELS={k:('precious' if k in ('homing','heal','coreteleport','gunteleport',*_SIEGE_ELITE_KEYS) else 'rare' if k in ('repeat','blackhole','shield') else 'uncommon' if k in ('splitshot','through','bounceblast','pierce','armor',*_SIEGE_TNT_KEYS) else 'common') for k in _SIEGE_V24_KEYS}
_SIEGE_V24_WEIGHTS={'common':8,'uncommon':4,'rare':2,'precious':1}
_SIEGE_V24_ART={'splitshot':16,'repeat':24,'bounce':16,'bounceblast':22,'through':5,'big':5,'homing':1,'blackhole':2,'push':3,'pierce':3,'shield':2,'armor':2,'tntdrop':4,'tntwait':3,'demolish':3,'salvage':3,'compound':3}
_SIEGE_V24_LOCATION={'air':{'common':1.5,'uncommon':1.,'rare':.4,'precious':.15},'side':{'common':.7,'uncommon':1.3,'rare':2.,'precious':2.5},'center':{'common':.25,'uncommon':1.,'rare':3.,'precious':6.}}
def _siege_v24(r):return r.get('rulesVersion')==24
def _siege_v24_setup(r,theme='classic',levels=None):
    # Legacy default-all rooms gain the new v24 items, explicit subsets stay intact.
    if set(r.get('allowedBuffs') or ())==set(_SIEGE_ACTIVE_ITEMS):r['allowedBuffs']=list(_SIEGE_V24_KEYS)
    r.update(rulesVersion=24,theme=theme if theme in ('classic','art','zombie') else 'classic',rarities={k:v for k,v in (levels or {}).items() if k in _SIEGE_V24_KEYS and k not in _SIEGE_NEGATIVE and v in _SIEGE_V24_WEIGHTS},buffMode='stock')
    r['allowedBuffs']=list(_siege_allowed(r));r['stackCaps']=dict(_SIEGE_V24_CAPS)
def _siege_v24_draw(r,zone='air'):
    keys=tuple(k for k in _siege_allowed(r) if (k in ('demolish','compound') if zone in ('center','side') else k not in ('demolish','compound')))
    if not keys:return None
    levels={**_SIEGE_V24_LEVELS,**{k:v for k,v in r.get('rarities',{}).items() if k not in _SIEGE_NEGATIVE}}
    weights=[(2 if zone=='air' and r.get('theme')!='art' else 0) if k in _SIEGE_NEGATIVE else (_SIEGE_V24_ART.get(k,0) if r.get('theme')=='art' else _SIEGE_V24_WEIGHTS[levels[k]])*_SIEGE_V24_LOCATION.get(zone,_SIEGE_V24_LOCATION['air'])[levels[k]] for k in keys]
    if zone in ('center','side'):
        weights=[max(w,18. if zone=='center' else 12.) if k in _SIEGE_ELITE_KEYS else w for k,w in zip(keys,weights)]
    return random.choices(keys,weights=weights,k=1)[0] if sum(weights)>0 else None
def _siege_v24_amount(r,k):
    cap=_SIEGE_V24_CAPS[k]
    if cap==1 or k=='compound':return 1
    return min(cap,random.choices((1,2,3),weights=(40,40,20) if r.get('theme')=='art' and k in ('splitshot','repeat','bounce','bounceblast') else (75,20,5))[0])
def _siege_caps(r):
    if _siege_v24(r):return {k:_SIEGE_V24_CAPS.get(k,0) for k in _SIEGE_ITEMS}
    raw=r.get('stackCaps') or {}
    if not isinstance(raw,dict):raw={}
    return {k:min(n,max(1,raw[k])) if type(raw.get(k)) is int else min(n,5) for k,n in _SIEGE_HARD_CAPS.items()}
def _siege_cap(r,k):return _siege_caps(r)[k]


def _siege_amount():return random.choices((1,2,3,5),weights=(66,20,10,4))[0]
_SIEGE_DEFAULT_ITEMS=13
_SIEGE_MAX_ITEMS=25

def _siege_allowed(r):
    """Room-authoritative whitelist. None means all (including legacy saved rooms)."""
    allowed=r.get('allowedBuffs')
    if _siege_v24(r):return tuple(k for k in _SIEGE_V24_KEYS if (k not in _SIEGE_NEGATIVE and (allowed is None or k in allowed) if r.get('theme')=='zombie' else k in _SIEGE_V24_ART if r.get('theme')=='art' else allowed is None or k in allowed))
    if allowed is None:return _SIEGE_ACTIVE_ITEMS
    return tuple(k for k in _SIEGE_ACTIVE_ITEMS if k in allowed or any(old in allowed and replacement==k for old,replacement in _SIEGE_REPLACEMENT.items()))

def _siege_items(count=_SIEGE_DEFAULT_ITEMS,field=None,bodies=None,allowed=None):
    count=max(0,min(_SIEGE_MAX_ITEMS,int(count)))
    allowed_set=set(_SIEGE_ITEMS if allowed is None else allowed)
    kinds=[k for k in (list(_SIEGE_ITEMS) if field else list(_SIEGE_ITEMS)[:6]) if k in allowed_set]
    if not count or not kinds:return []
    random.shuffle(kinds)
    if field:
        featured=[k for k in field['pool'] if k in allowed_set]
        random.shuffle(featured)
        # Each non-empty map starts with a usable reflection resource when enabled.
        if 'bounce' in allowed_set:featured=['bounce']+[k for k in featured if k!='bounce']
        # Mix the new pickups with old featured ones, keeping both discoverable.
        others=[k for k in kinds if k not in featured];random.shuffle(others)
        kinds=featured+others
    # Each game samples a new formation, rather than perturbing the same grid.
    # Sample the actual ballistic envelope above the left fort, mirrored for fairness.
    if field:
        sx=field.get('gunX',235+field['offset']+field.get('gunShift',0));sy=min(field.get('gunY',390-field['rise']),368-field['rise'])
        candidates=[]
        for _ in range(1800):
            a=math.radians(random.uniform(28,152));v=random.uniform(380,760);t=random.uniform(.22,1.65)
            x=sx+(43+v*t)*math.cos(a);y=sy-(43+v*t)*math.sin(a)+230*t*t
            if 35<x<448 and (-35 if 'gunY' in field else 65)<y<min(315,sy-35 if 'gunY' in field else sy-70) and (x>235+field['offset'] or y<225-field['rise'] or 'gunX' in field):
                if bodies:
                    # Sample a viable trajectory, not a point hidden inside a castle.
                    if any(abs(sx+(43+v*u)*math.cos(a)-b['x'])<b['w']/2+7 and abs(sy-(43+v*u)*math.sin(a)+230*u*u-b['y'])<b['h']/2+7 for b in bodies if b['side']==0 or b.get('platform') for u in (t*j/12 for j in range(1,13))):continue
                candidates.append((round(x),round(y)))
        slots=[]
        # Guarantee a rear target and a forward target for the ordinary 13-item game.
        for group in ( [p for p in candidates if p[0]<sx-55], [p for p in candidates if p[0]>sx+35], candidates):
            random.shuffle(group)
            for x,y in group:
                if all(math.hypot(x-a,y-b)>49 for a,b in slots):
                    slots.append((x,y))
                    if len(slots) in (1,2,12):break
            if len(slots)>=12:break
        # Fill densely only when necessary; the launch envelope remains the same.
        for gap in (42,34,25,0):
            for x,y in candidates:
                if len(slots)>=12:break
                if all(math.hypot(x-a,y-b)>gap for a,b in slots):slots.append((x,y))
    else:
        slots=[(145,205),(195,215),(285,268),(325,178),(390,310),(420,135),(110,155),(215,150),(270,345),(350,245),(400,210),(445,320)]
        if count//2<6:slots=[slots[i] for i in (2,4,0,3,1,5)]+slots[6:]
        slots=[(x+random.randint(-8,8),y+random.randint(-9,9)) for x,y in slots]
    items=[]
    for index,(x,y) in enumerate(slots[:count//2]):
        kind=kinds[index%len(kinds)]
        for sign,xx in ((1,x),(-1,960-x)):
            it={'id':len(items),'kind':kind,'x':xx,'y':y,'r':15,'slot':len(items)}
            if field and index%3==1:it.update(mx=sign*12,my=9,phase=random.uniform(0,6) if sign==1 else items[-1]['phase'])
            items.append(it)
    if count%2:items.append({'id':len(items),'kind':kinds[(count//2)%len(kinds)],'x':480,'y':random.randint(105,175),'r':15,'slot':len(items)})
    if field:
        for i in range(0,len(items),2):
            amount=_siege_amount()
            for it in items[i:i+2]:it['amount']=1 if it['kind'] in (*_SIEGE_SINGLE_ITEMS,*_SIEGE_NEGATIVE) else amount
    return items

def _siege_refill(r):
    # A collected slot becomes available after four more shots (two full rounds).
    turn=sum(r['shots']);waiting=r.setdefault('respawns',[]);new=[]
    allowed=_siege_allowed(r)
    if not allowed:
        waiting.clear()
        return new
    for item in waiting[:]:
        if turn<item['readyAt']:continue
        waiting.remove(item);it={k:v for k,v in item.items() if k not in ('readyAt','kind','id')}
        if _siege_v24(r):
            k=_siege_zombie_draw(r) if r.get('theme')=='zombie' else _siege_v24_draw(r,it.get('zone','air'))
            if k is None:
                if r.get('theme')=='zombie':item['readyAt']=turn+2;waiting.append(item)
                continue
            it.pop('recipe',None)
            it.update(kind=k,amount=_siege_v24_amount(r,k),id=r.get('nextItemId',1000));
            if k=='compound':it['recipe']=_siege_compound_recipe()
            r['nextItemId']=it['id']+1;r['items'].append(it);new.append(it);continue
        field=(_SIEGE_FIELDS|_SIEGE_NEW_FIELDS).get(r.get('field'),{})
        featured=[k for k in field.get('pool',()) if k in allowed]
        if 'bounce' in allowed and not any(i['kind']=='bounce' for i in r['items']) and not any(b.get('bounce',0) for b in r['buffs']):it['kind']='bounce'
        else:it['kind']=random.choice(featured if featured and random.random()<.6 else allowed)
        it['amount']=1 if it['kind'] in (*_SIEGE_SINGLE_ITEMS,*_SIEGE_NEGATIVE) else _siege_amount();it['id']=r.get('nextItemId',1000);r['nextItemId']=it['id']+1
        r['items'].append(it);new.append(it)
    return new

def _siege_item_pos(item,t):
    phase=t*1.35+item.get('phase',0)
    return item['x']+item.get('mx',0)*math.sin(phase),item['y']+item.get('my',0)*math.cos(phase)

def _siege_floor(r,x):
    terrain=r.get('terrain')
    if terrain:
        x=max(0.,min(960.,x))
        for (x0,y0),(x1,y1) in zip(terrain,terrain[1:]):
            if x<=x1:return y0+(y1-y0)*(x-x0)/(x1-x0)
        return terrain[-1][1]
    return _SIEGE_G-r.get('rise',0) if x<=300 or x>=660 else _SIEGE_G

def _siege_floor_body(r,x,width=0):
    # Rectangles must clear the highest point under their feet on a slope.
    half=max(0.,width/2)
    return min(_siege_floor(r,xx) for xx in (x-half,x,x+half))

def _siege_buffs(count=2):return [{k:0 for k in _SIEGE_ITEMS} for _ in range(count)]
def _siege_normalize_buffs(r):
    # Existing v0.6 saved matches remain playable; preserve their pending single charges.
    for i,b in enumerate(r['buffs']):
        if 'attack' in b:
            new={k:0 for k in _SIEGE_ITEMS}
            if b['attack'] in _SIEGE_ATTACK:new[b['attack']]=1
            new['shield']=int(bool(b.get('shield')));r['buffs'][i]=new
        else:
            for k in _SIEGE_ITEMS:b.setdefault(k,0)
            # Retire legacy vision charges without losing collected resources.
            b['power']+=b.pop('vision',0)
        if _siege_v24(r):
            for k in _SIEGE_ITEMS:r['buffs'][i][k]=min(_SIEGE_V24_CAPS.get(k,0),max(0,r['buffs'][i][k]))
        for k in _SIEGE_ONE_SHOT:r['buffs'][i][k]=0 if r.get('bot') and i==1 else min(1,max(0,r['buffs'][i][k]))
    if _siege_v24(r):
        recipes=r.setdefault('compoundRecipes',[[],[]])
        for i,b in enumerate(r['buffs']):
            raw=recipes[i];raw=[raw] if isinstance(raw,str) else raw if isinstance(raw,list) else []
            raw=[k for k in raw if k in _SIEGE_COMPOUND_RECIPES];n=b.get('compound',0)
            recipes[i]=[k for k in _SIEGE_COMPOUND_RECIPES for _ in range(3)] if r.get('trial') and i==0 else (raw+['burst']*n)[:n]
    for it in (*r.get('items',[]),*r.get('respawns',[])):
        if it.get('kind')=='vision':it['kind']='power'
        if it.get('kind') in (*_SIEGE_SINGLE_ITEMS,*_SIEGE_NEGATIVE):it['amount']=1

def _siege_fort(offset=0,layout="tower",rise=0):
    bodies=[]
    def add(side,x,y,w,h,kind):
        hp={'wood':42,'stone':75,'core':100}[kind]
        bodies.append({'id':len(bodies),'side':side,'x':x+offset if side==0 else 960-x-offset,'y':y-rise,'w':w,'h':h,'kind':kind,'hp':hp,'max':hp,'vx':0.,'vy':0.})
    for side in (0,1):
        if layout=='suspended':
            for x in (87,157):add(side,x,378,22,76,'wood')
            for x in (87,122,157):add(side,x,328,35,24,'stone')
            for x in (105,139):add(side,x,302,34,28,'stone')
            add(side,122,272,40,32,'stone');add(side,122,394,36,44,'core')
        elif layout=='opentop':
            for x,h in ((72,56),(172,112)):
                add(side,x,416-h/2,30,h,'stone')
            add(side,122,394,36,44,'core')
        elif layout=='layers':
            for x,h in ((72,54),(160,86),(196,104)):
                for j in range(2):add(side,x,416-h/4-j*h/2,18,h/2,'stone')
            add(side,122,394,36,44,'core')
        elif layout=='wall':
            for x in (72,172):add(side,x,384,32,64,'stone')
            add(side,122,344,132,16,'wood')
            for x in (88,156):add(side,x,316,30,40,'stone')
            add(side,122,288,112,16,'wood')
            add(side,122,384,36,44,'core')
            add(side,122,265,36,30,'wood')
        elif layout=='split':
            for x in (77,167):
                add(side,x,386,30,60,'stone');add(side,x,346,46,20,'wood');add(side,x,321,24,30,'wood')
            add(side,122,384,36,44,'core');add(side,122,352,42,20,'stone')
        else:
            for x in (77,167):add(side,x,386,24,60,'stone')
            add(side,122,348,114,16,'wood')
            for x in (91,153):add(side,x,316,22,48,'wood')
            add(side,122,284,96,16,'wood')
            add(side,122,384,36,44,'core')
            add(side,122,257,30,38,'stone')
    return bodies

def _siege_weather(level):
    limit=_SIEGE_WIND[level]
    return random.choice((-1,1))*random.randint(limit//2,limit) if limit else 0

def _siege_field(r):
    dynamic=r.get('mode','classic')=='dynamic'
    offset=random.randint(-30,55) if dynamic else 0
    layout=random.choice(('tower','wall','split')) if dynamic else 'tower'
    seats=max(2,r.get('zombiePlayerCount',2)) if r.get('theme')=='zombie' else 2
    r['compoundRecipes']=[[] for _ in range(seats)]
    r.update(offset=offset,layout=layout,bodies=_siege_fort(offset,layout),items=_siege_items(r['itemCount'],allowed=_siege_allowed(r)),buffs=_siege_buffs(seats),windPair=_siege_weather(r.get('windLevel','off')))
    mode=r.get('mode','classic')
    pool=_SIEGE_MAP_POOLS.get(mode)
    field_key=random.choice(pool) if pool else random.choice(tuple((*_SIEGE_FIELDS,*_SIEGE_NEW_FIELDS))) if mode=='random' else mode
    field=(_SIEGE_FIELDS|_SIEGE_NEW_FIELDS).get(field_key)
    r.pop('terrain',None);r.pop('launchers',None);r['armed']=[{} for _ in range(seats)];r['reflectors']=[];r['gunMotion']=[];r['nextBodyId']=100;r['mines']=[];r['nextMineId']=1
    if field:
        offset=field['offset']+random.randint(-5,5);layout=field['layout'];rise=field['rise']
        r.update(offset=offset,gunShift=field.get('gunShift',0),layout=layout,rise=rise,field=field_key,fieldLabel=field['label'],bodies=_siege_fort(offset,layout,rise),items=_siege_items(r['itemCount'],field,allowed=_siege_allowed(r)))
        if field_key in _SIEGE_NEW_FIELDS:
            x=field['gunX'];r['launchers']=[(x,390),(960-x,390)]
            if field_key=='sky':
                # Independent elevated platforms; rigid-body fort remains destructible.
                r['bodies']=_siege_fort(offset,'split',216)
                for side in (0,1):
                    cx=122+offset if side==0 else 838-offset
                    r['bodies'].append(dict(id=len(r['bodies']),side=-1,x=cx,y=211,w=174,h=22,kind='stone',hp=100,max=100,vx=0.,vy=0.,fixed=True,platform=True))
            elif field_key in ('floating','floatingcenter'):
                elevation=145 if field_key=='floating' else 115
                r['bodies']=_siege_fort(offset,layout,elevation)
                for side in (0,1):
                    cx=122+offset if side==0 else 838-offset
                    r['bodies'].append(dict(id=len(r['bodies']),side=-1,x=cx,y=416-elevation+11,w=174,h=22,kind='stone',hp=100,max=100,vx=0.,vy=0.,fixed=True,platform=True,baseY=416-elevation+11,motionY=46,phase=0))
                for b in r['bodies']:
                    if b['side']>=0:b.update(fixed=True,baseY=b['y'],motionY=46,phase=0,floatFort=True)
                r['launchers']=[(x,250 if field_key=='floating' else 285),(960-x,250 if field_key=='floating' else 285)]
                r['gunMotion']=[dict(amplitude=55,phase=1.6),dict(amplitude=55,phase=1.6)]
            elif field_key=='movingwall':
                r['bodies'].append(dict(id=len(r['bodies']),side=-1,x=480,y=210,w=42,h=112,kind='stone',hp=125,max=125,vx=0.,vy=0.,fixed=True,motionY=105,baseY=210,phase=0))
            r['items']=_siege_items(r['itemCount'],field,r['bodies'],allowed=_siege_allowed(r))
            if field_key in ('sky','floating','floatingcenter'):r['reflectors']=[dict(x1=0,x2=960,y=-55)]
            elif field_key=='movingwall':r['reflectors']=[dict(x1=300,x2=660,y=-55)]
            elif field_key=='overtop':r['reflectors']=[dict(x1=275,x2=685,y=105)]
        if field_key=='obstacle':
            r['bodies'].append({'id':len(r['bodies']),'side':-1,'x':480,'y':396,'w':52,'h':40,'kind':'stone','hp':75,'max':75,'vx':0.,'vy':0.})
    else:r.update(rise=0,gunShift=0,field=mode,fieldLabel='经典战场' if mode=='classic' else '动态战场',items=_siege_items(r['itemCount'],{'offset':offset,'rise':0,'pool':('power','big','heal')},allowed=_siege_allowed(r)))
    r['motionEpoch']=time.time();r['respawns']=[];r['nextItemId']=1000;r['negativePending']=[{} for _ in range(seats)];r['clones']=[];r['gunGravity']=[False]*seats;r['gunFallV']=[0.]*seats
    r['wind']=r['windPair'] # world +x; reverse for right shooter for equal relative wind
    if _siege_v24(r):
        if r.get('theme')=='zombie':_siege_zombie_world(r)
        else:_siege_v24_world(r)
        _siege_install_cannons(r)

# Cooperative theme: one authoritative shared core, both guns point right,
# and zombies only act after both players have fired.
_SIEGE_ZOMBIE_WAVES=(
    ('walker','walker','walker'),
    ('walker','runner','shield','pole'),
    ('heavy','bomber','priest','flyer'),
    ('guard','heavy','dancer','flyer','runner','climber'),
    ('giant','siegecar','guard','priest','bomber'),
    ('giant','siegecar','guard','pole','dancer','runner'),
)
_SIEGE_ZOMBIE_TYPES={
    'walker':(32,42,44,104,9),
    'shield':(36,44,68,82,11),
    'heavy':(42,52,100,60,15),
    'flyer':(30,34,38,128,10),
    'climber':(30,40,52,116,10),
    'giant':(58,78,190,52,24),
    'runner':(26,38,32,180,8),
    'pole':(30,44,48,135,10),
    'bomber':(30,40,42,145,30),
    'priest':(32,46,65,72,7),
    'dancer':(34,46,75,65,9),
    'guard':(44,54,150,65,13),
    'siegecar':(62,44,135,76,13),
    'engineer':(62,44,135,76,13), # compatibility with saved matches
}
# Progression is shared by field pickups, resupply, and enemy drops.
_SIEGE_ZOMBIE_DIFFICULTIES={
    'easy':(.8,.85,.8,1),
    'medium':(1.,1.,1.,1),
    'hard':(1.25,1.15,1.25,2),
    'hell':(1.55,1.3,1.5,2),
}
_SIEGE_ZOMBIE_RARITIES=('common','uncommon','rare','precious')
_SIEGE_ZOMBIE_DROP_LEVEL={'walker':0,'climber':0,'flyer':1,'shield':1,'heavy':2,'giant':3,'runner':0,'pole':1,'bomber':1,'priest':2,'dancer':2,'guard':3,'engineer':3,'siegecar':3}
def _siege_zombie_difficulty(r):
    return _SIEGE_ZOMBIE_DIFFICULTIES.get(r.get('zombieDifficulty','medium'),_SIEGE_ZOMBIE_DIFFICULTIES['medium'])
def _siege_zombie_draw(r,enemy=None):
    wave=r.get('zombie',{}).get('wave',1)
    ceiling=0 if wave==1 else 1 if wave<=2 else 2 if wave<=4 else 3
    if enemy is not None:ceiling=min(ceiling,_SIEGE_ZOMBIE_DROP_LEVEL.get(enemy,0))
    levels={**_SIEGE_V24_LEVELS,**r.get('rarities',{})}
    keys=[k for k in _siege_allowed(r) if _SIEGE_ZOMBIE_RARITIES.index(levels[k])<=ceiling]
    if not keys:return None
    if enemy is not None:
        top=max(_SIEGE_ZOMBIE_RARITIES.index(levels[k]) for k in keys)
        keys=[k for k in keys if _SIEGE_ZOMBIE_RARITIES.index(levels[k])==top]
    # Prefer variety among eligible rewards, without violating selected rarity ceilings.
    history=r.setdefault('zombieRewardHistory',[])
    if enemy is None:
        # Rotate the general supply through eligible categories; reserve occasional
        # draws for newly unlocked rarity tiers instead of flooding it with commons.
        upper=[k for k in keys if _SIEGE_ZOMBIE_RARITIES.index(levels[k])==ceiling]
        if upper and ceiling>0 and not any(k in upper for k in history[-4:]):keys=upper
        fresh=[k for k in keys if k not in history[-min(6,max(0,len(keys)-1)):]] if len(keys)>1 else keys
        if fresh:keys=fresh
    weights=[_SIEGE_V24_WEIGHTS[levels[k]]/(1+3*history[-8:].count(k)) for k in keys]
    k=random.choices(keys,weights=weights,k=1)[0];history.append(k);del history[:-16]
    return k
def _siege_zombie_pickup(r,k,x,y,slot=None,enemy=False):
    if k is None:return
    ident=r.setdefault('nextItemId',1000);r['nextItemId']=ident+1
    amount=min(_siege_cap(r,k),_siege_zombie_difficulty(r)[3] if enemy else 1)
    item=dict(id=ident,kind=k,x=max(15,min(945,x)),y=max(30,min(396,y)),r=15,amount=amount,zone='air')
    if slot is not None:item['slot']=slot
    if k=='compound':item['recipe']=_siege_compound_recipe()
    r['items'].append(item)
    return item
def _siege_zombie_drops(r):
    for b in r['bodies']:
        if b['kind']=='zombie' and b['hp']<=0 and not b.get('rewarded'):
            b['rewarded']=True
            _siege_zombie_pickup(r,_siege_zombie_draw(r,b['zombieType']),b['x'],b['y']-b['h']/2,enemy=True)
def _siege_zombie_supply(r):
    for side,inv in enumerate(r['buffs'][:1] if r.get('zombieSolo') else r['buffs']):
        k=_siege_zombie_draw(r)
        if k is not None and inv[k]<_siege_cap(r,k):
            inv[k]+=1
            if k=='compound':r['compoundRecipes'][side].append(_siege_compound_recipe())
def _siege_zombie_refresh(r):
    # Keep dropped loot; refresh only the original renewable slots.
    slots=[it for it in r['items'] if 'slot' in it]+list(r['respawns'])
    r['items'][:]=[it for it in r['items'] if 'slot' not in it]
    r['respawns']=[]
    for it in slots:
        k=_siege_zombie_draw(r)
        if k is None:
            r['respawns'].append({**it,'readyAt':sum(r['shots'])+2})
        else:_siege_zombie_pickup(r,k,it['x'],it['y'],slot=it['slot'])
# Side-view terrain is a continuous floor profile, not a cosmetic backdrop.
# (label, ground points, core X, cannon Xs, two-sided spawn)
_SIEGE_ZOMBIE_MAPS={
    'front':('最后防线',[(0,416),(960,416)],80,(170,270),False),
    'crossfire':('腹背受敌',[(0,416),(960,416)],480,(370,590),True),
    'ridge':('高地与低谷',[(0,255),(225,255),(385,416),(520,416),(650,295),(755,295),(865,416),(960,416)],100,(185,480),False),
    'basin':('盆地要塞',[(0,270),(130,270),(300,416),(660,416),(830,270),(960,270)],480,(375,585),True),
    'crest':('双峰夹击',[(0,416),(125,416),(270,280),(365,280),(480,390),(595,280),(690,280),(835,416),(960,416)],480,(320,640),True),
}
def _siege_zombie_spawn(r):
    state=r['zombie'];wave=state['wave'];bodies=r['bodies']
    for j,kind in enumerate(_SIEGE_ZOMBIE_WAVES[wave-1]):
        w,h,hp,speed,damage=_SIEGE_ZOMBIE_TYPES[kind]
        hp=round(hp*_siege_zombie_difficulty(r)[0],1)
        left=r.get('zombieBothSides') and j%2==0
        rank=j//2 if r.get('zombieBothSides') else j
        x=30+rank*62 if left else 930-rank*62
        floor=_siege_floor_body(r,x,w)
        y=min(220-j%2*45,floor-h/2-14) if kind=='flyer' else floor-h/2
        ident=r['nextBodyId'];r['nextBodyId']+=1
        bodies.append(dict(id=ident,side=2,kind='zombie',zombieType=kind,x=x,y=y,w=w,h=h,hp=hp,max=hp,vx=0.,vy=0.,fixed=True))
    state['spawned']+=len(_SIEGE_ZOMBIE_WAVES[wave-1])
def _siege_zombie_world(r):
    r.update(field='zombie',fieldLabel='丧尸围城',mode='classic',combatMode='turn',ammo=0,rise=0,offset=0,gunShift=0,wind=0,windPair=0,windLevel='off',reflectors=[],gunMotion=[],launchers=[[170,368],[270,368]],nextBodyId=100)
    map_key=r.get('zombieMap','front')
    if map_key=='random':map_key=random.choice(tuple(_SIEGE_ZOMBIE_MAPS))
    label,terrain,cx,guns,both=_SIEGE_ZOMBIE_MAPS.get(map_key,_SIEGE_ZOMBIE_MAPS['front'])
    r.update(field='zombie_'+map_key if map_key!='front' else 'zombie',fieldLabel=label,terrain=terrain,zombieBothSides=both)
    if r.get('zombiePlayerCount',2)==3:
        third=min(905,guns[-1]+110)
        guns=(*guns,third)
    r['launchers']=[[x,_siege_floor(r,x)-48] for x in guns]
    r['bodies']=[dict(id=0,side=0,kind='core',shared=True,x=cx,y=_siege_floor(r,cx)-26,w=50,h=52,hp=100,max=100,vx=0.,vy=0.)]
    # The ridge has a destructible neutral screen, away from the muzzle.
    if map_key=='ridge':
        x=650;h=72
        r['bodies'].append(dict(id=1,side=-1,kind='stone',x=x,y=_siege_floor(r,x)-h/2,w=28,h=h,hp=75,max=75,vx=0.,vy=0.))
    r['zombieRewardHistory']=[]
    r['zombie']=dict(wave=1,totalWaves=len(_SIEGE_ZOMBIE_WAVES),round=1,kills=0,spawned=0,won=False,difficulty=r.get('zombieDifficulty','medium'))
    r['items']=[];r['respawns']=[]
    slots=[(230,205),(335,140),(430,235),(510,100),(580,190),(665,130),(755,245),(840,110)]
    for j,(x,y) in enumerate(slots[:min(len(slots),r.get('itemCount',8))]):
        y=min(y,_siege_floor(r,x)-35)
        k=_siege_zombie_draw(r)
        if k is None:r['respawns'].append(dict(id=j,slot=j,x=x,y=y,r=15,amount=1,zone='air',readyAt=2))
        else:_siege_zombie_pickup(r,k,x,y,slot=j)
    for inv in r['buffs']:
        for k in ('big','wooddrop'):
            if k in _siege_allowed(r) and r.get('rarities',{}).get(k,_SIEGE_V24_LEVELS[k])=='common':inv[k]=1
    _siege_zombie_spawn(r)

def _siege_zombie_supports(r,core):
    # Trace the load-bearing stack under the shared core, not unrelated scenery.
    bodies=r['bodies'];seen={core['id']};stack=[core];supports=[]
    while stack:
        b=stack.pop();feet=b['y']+b['h']/2
        for c in bodies:
            if c['id'] in seen or c['hp']<=0 or c['kind'] not in ('wood','stone','barrel','tnt','tnt_wait','cannon'):continue
            if abs(c['x']-b['x'])<(c['w']+b['w'])/2 and abs(c['y']-c['h']/2-feet)<=4:
                seen.add(c['id']);supports.append(c);stack.append(c)
    return supports

def _siege_siegecar_ground_hit(r,start,end,radius=5.):
    """First intersection of a shell's swept centre with the terrain profile.

    Evaluate every profile vertex, not a coarse fixed number of samples: on
    each linear terrain segment the difference between trajectory and ground
    is linear, so the first crossing is exact even on narrow steep ridges.
    """
    x0,y0=start;x1,y1=end;dx=x1-x0;dy=y1-y0
    if abs(dx)<1e-9:
        return 0. if y0+radius>=_siege_floor(r,x0) else None
    vertices=r.get('terrain') or [(0.,_siege_floor(r,0.)),(300.,_siege_floor(r,300.)),
                                  (660.,_siege_floor(r,660.)),(960.,_siege_floor(r,960.))]
    cuts=sorted([0.,1.]+[(x-x0)/dx for x,_ in vertices if 0.<(x-x0)/dx<1.])
    for a,b in zip(cuts,cuts[1:]):
        fa=y0+dy*a+radius-_siege_floor(r,x0+dx*a)
        fb=y0+dy*b+radius-_siege_floor(r,x0+dx*b)
        if fa>=-1e-7:return a
        if fb>=-1e-7:
            return a+(b-a)*(-fa)/(fb-fa) if fb>fa else b
    return None

def _siege_siegecar_trace(r,start,end,radius=5.):
    """First physical hit along the shot, returning object or terrain contact.

    A ground impact terminates the shell and never damages a target behind
    the ridge; rectangles use swept AABB entry rather than discrete samples.
    """
    x0,y0=start;x1,y1=end;dx=x1-x0;dy=y1-y0
    ground=_siege_siegecar_ground_hit(r,start,end,radius)
    first=1.01;hit=None
    for b in r['bodies']:
        if b['hp']<=0 or b['kind'] not in ('wood','stone','core'):continue
        lo=0.;hi=1.
        for p,v,minimum,maximum in (
            (x0,dx,b['x']-b['w']/2-radius,b['x']+b['w']/2+radius),
            (y0,dy,b['y']-b['h']/2-radius,b['y']+b['h']/2+radius)
        ):
            if abs(v)<1e-9:
                if p<minimum or p>maximum:hi=-1.;break
            else:
                t0=(minimum-p)/v;t1=(maximum-p)/v
                lo=max(lo,min(t0,t1));hi=min(hi,max(t0,t1))
                if lo>hi:break
        if lo<=hi and lo<first:
            first=lo;hit=b
    if ground is not None and ground<=first+1e-7:
        return None,(x0+dx*ground,y0+dy*ground),True
    if hit is not None:
        return hit,(x0+dx*first,y0+dy*first),False
    return None,end,False

def _siege_siegecar_plan(r,z,core):
    # The breach vehicle fires a visible forward projectile, not an instant hit.
    # Difficulty controls range, fire cadence, target selection and penetration.
    rank=('easy','medium','hard','hell').index(r.get('zombieDifficulty','medium')) if r.get('zombieDifficulty','medium') in ('easy','medium','hard','hell') else 1
    reach=(200,290,390,490)[rank];vertical=(55,100,150,225)[rank]
    if rank<=1 and r['zombie']['round']%2: return None
    d=1 if core['x']>z['x'] else -1
    start=(z['x']+d*(z['w']/2+3),z['y']-9)
    candidates=[b for b in r['bodies'] if b['hp']>0 and b['kind'] in ('wood','stone','core')
                and 15<(b['x']-start[0])*d<reach and abs(b['y']-start[1])<vertical]
    if not candidates:return None
    supports=_siege_zombie_supports(r,core) if rank>=2 else []
    if rank>=3:
        # In hell difficulty destroy load-bearing columns before the paper itself.
        preferred=[b for b in candidates if b in supports]
    elif rank>=2:
        preferred=[b for b in candidates if b is core or b in supports]
    else:preferred=[]
    preferred=preferred or candidates
    if rank>=2:
        goal=min(preferred,key=lambda b:(0 if b in supports else .4 if b is core else 1,abs(b['x']-z['x'])))
    else:goal=min(preferred,key=lambda b:(b['x']-z['x'])*d)
    # All shot effects (visual endpoint, impact, damage and optional armor
    # penetration) must agree with the first real collision, including terrain.
    hit,point,ground=_siege_siegecar_trace(r,start,(goal['x'],goal['y']))
    damage=(12,16,23,28)[rank]*_siege_zombie_difficulty(r)[2]
    if hit is not None and hit['kind']=='stone':damage*=1.1 if rank<2 else 1.5
    # Hell difficulty can pierce an intervening *building*, never the map.
    clear_to_core=_siege_siegecar_ground_hit(r,start,(core['x'],core['y'])) is None
    piercing=rank==3 and goal is core and hit is not None and hit is not core and clear_to_core
    return dict(origin=start,target=hit,point=point,ground=ground,damage=damage,penetration=piercing)

def _siege_zombie_round(r,t,frames,snap,events,physics=None):
    # Fixed one-second enemy action, recorded at normal simulation time.
    # The enemy phase is independent of the previous shot's debris.
    state=r['zombie'];bodies=r['bodies'];core=_siege_core_body(bodies,0)
    state['round']+=1
    # Give the camera time to establish the enemy phase before any movement.
    t=max(t,1.)
    for _ in range(6):t+=.08;frames.append(snap(t,None))
    start=t;events.append(['zombiePhase',round(start,3)])
    if not any(b['kind']=='zombie' and b['hp']>0 for b in bodies):
        r['armed']=[{} for _ in r['buffs']]
        if state['wave']==state['totalWaves']:
            state['won']=True;return t+.5
        state['wave']+=1;_siege_zombie_spawn(r)
        _siege_zombie_refresh(r);_siege_zombie_supply(r)
        events.append(['zombieWave',round(t,3),state['wave']])
        frames.append(snap(t,None))
        return t+.5
    shield=min(_siege_cap(r,'shield'),sum(b.get('shield',0) for b in r['armed']))
    armor=min(_siege_cap(r,'armor'),sum(b.get('armor',0) for b in r['armed']))
    attacked=set()
    r['zombiePhasePhysics']=True
    car_rounds={}
    # Support enemies act once per enemy phase, never once per simulation tick.
    living=[b for b in bodies if b['kind']=='zombie' and b['hp']>0]
    for z in living:
        if z['zombieType']=='priest':
            for ally in living:
                if ally is not z and math.hypot(ally['x']-z['x'],ally['y']-z['y'])<=125:
                    ally['hp']=min(ally['max'],ally['hp']+14)
        if z['zombieType']=='dancer' and not z.get('summoned'):
            d=1 if core['x']>z['x'] else -1
            w,h,hp,_,_=_SIEGE_ZOMBIE_TYPES['walker']
            for offset in (48,88,126,-48,-88):
                x=max(16,min(944,z['x']-d*offset))
                if any(b['hp']>0 and abs(b['x']-x)<(b['w']+w)/2 and abs(b['y']-(_siege_floor_body(r,x,w)-h/2))<(b['h']+h)/2 for b in bodies):continue
                z['summoned']=True
                ident=r['nextBodyId'];r['nextBodyId']+=1;hp=round(hp*_siege_zombie_difficulty(r)[0],1)
                bodies.append(dict(id=ident,side=2,kind='zombie',zombieType='walker',x=x,y=_siege_floor_body(r,x,w)-h/2,w=w,h=h,hp=hp,max=hp,vx=0.,vy=0.,fixed=True))
                state['spawned']+=1;break
    for step in range(1,13):
        t=start+step/12
        alive=sorted((b for b in bodies if b['kind']=='zombie' and b['hp']>0),key=lambda b:abs(b['x']-core['x']))
        for z in alive:
            if z['hp']<=0:continue
            ground=_siege_floor_body(r,z['x'],z['w'])
            # Restore AI after physics settles on *any* real support, not just
            # terrain. Previously zombies standing on a wood/stone roof stayed
            # non-fixed forever because their feet were above terrain level.
            # Flyers can resume powered flight in midair once the impulse fades.
            if not z.get('fixed'):
                feet=z['y']+z['h']/2
                blocks=[b for b in bodies if b is not z and b['hp']>0
                        and b['kind'] in ('wood','stone','barrel','tnt','tnt_wait')
                        and abs(z['x']-b['x'])<(z['w']+b['w'])/2
                        and abs(feet-(b['y']-b['h']/2))<=6]
                on_ground=feet>=ground-6
                flying_recovered=z['zombieType']=='flyer' and z.get('pushTime',0)<=0
                speed_now=math.hypot(z.get('vx',0),z.get('vy',0))
                if speed_now>(85 if flying_recovered else 65):continue
                if not (on_ground or blocks or flying_recovered):
                    continue
                z['fixed']=True;z['vx']=z['vy']=0.
                if on_ground:z['y']=ground-z['h']/2
                elif blocks and not flying_recovered:
                    z['y']=min(b['y']-b['h']/2 for b in blocks)-z['h']/2
            _,_,_,speed,damage=_SIEGE_ZOMBIE_TYPES[z['zombieType']]
            _,speed_scale,damage_scale,_=_siege_zombie_difficulty(r);speed*=speed_scale;damage*=damage_scale
            d=1 if core['x']>z['x'] else -1
            if z['zombieType'] in ('siegecar','engineer'):
                if step==2:
                    plan=_siege_siegecar_plan(r,z,core)
                    if plan:
                        target=plan['target']
                        sx,sy=plan['origin'];hx,hy=plan['point']
                        events.append(['siegeCarShot',round(t,3),round(sx,1),round(sy,1),
                                       round(hx,1),round(hy,1),z['id'],target['id'] if target else -1,
                                       round(plan['damage'],1) if target else 0.])
                        car_rounds[z['id']]=plan
                if step==6 and z['id'] in car_rounds:
                    plan=car_rounds.pop(z['id']);target=plan['target']
                    hx,hy=plan['point']
                    if target is not None and target['hp']>0:
                        amount=plan['damage']*(.35**shield if target is core else .65**armor)
                        target['hp']=max(0.,target['hp']-amount)
                        if plan['penetration'] and core['hp']>0:
                            core['hp']=max(0.,core['hp']-plan['damage']*.4*(.35**shield))
                    events.append(['siegeCarImpact',round(t,3),round(hx,1),round(hy,1),
                                   target['id'] if target else -1])
            flying=z['zombieType']=='flyer'
            nx=z['x']+d*speed/12
            if flying:
                z['y']+=max(-speed/12,min(speed/12,core['y']-z['y']))
                z['y']=min(z['y'],_siege_floor_body(r,nx,z['w'])-z['h']/2-14)
            close=abs(z['x']-core['x'])<=(z['w']+core['w'])/2+8 and abs(z['y']-core['y'])<=(z['h']+core['h'])/2+8
            target=core if close else None
            # Ground enemies that cannot reach an elevated core attack accessible
            # load-bearing blocks. Moving towards a support also handles offset stacks.
            support_target=None
            if not flying and core['y']+core['h']/2<z['y']-z['h']/2+12:
                supports=_siege_zombie_supports(r,core)
                reachable=[b for b in supports if abs(z['y']-b['y'])<=(z['h']+b['h'])/2+12 and b['kind']!='cannon']
                if reachable:
                    support_target=min(reachable,key=lambda b:abs(b['x']-z['x']))
                    target=None  # a core above the head is not a ground-level melee target
                    d=1 if support_target['x']>z['x'] else -1
                    nx=z['x']+d*speed/12
                    if abs(z['x']-support_target['x'])<=(z['w']+support_target['w'])/2+8:target=support_target
            if not flying and not target:
                obstacles=[b for b in bodies if b['hp']>0 and b['kind'] in ('wood','stone','barrel','tnt','tnt_wait')
                           and (b['x']-z['x'])*d>=-3
                           and abs(nx-b['x'])<(z['w']+b['w'])/2+2 and abs(z['y']-b['y'])<(z['h']+b['h'])/2]
                if obstacles:target=min(obstacles,key=lambda b:abs(b['x']-z['x']))
                if target and target is not support_target and (z['zombieType']=='climber' and target['h']<=44 or z['zombieType']=='pole' and target['h']<=82 and not z.get('vaulted')):
                    top=target['y']-target['h']/2-z['h']/2
                    if not any(b is not target and b['hp']>0 and b['kind'] in ('wood','stone') and abs(nx-b['x'])<(z['w']+b['w'])/2 and abs(top-b['y'])<(z['h']+b['h'])/2 for b in bodies):
                        if z['zombieType']=='pole':z['vaulted']=True
                        z['y']=top;target=None
            if target:
                if z['zombieType']=='bomber':
                    for b in bodies:
                        if b['hp']<=0 or b['kind'] in ('zombie','cannon'):continue
                        if math.hypot(max(0,abs(b['x']-z['x'])-b['w']/2),max(0,abs(b['y']-z['y'])-b['h']/2))<=65:
                            b['hp']=max(0,b['hp']-damage*(.35**shield if b is core else .65**armor))
                    z['hp']=0;z['rewarded']=True;events.append(['zombieAttack',round(t,3),z['id'],target['id'],round(damage,1)]);continue
                if z['id'] not in attacked:
                    attacked.add(z['id']);amount=damage*(.35**shield if target is core else .65**armor)
                    if target['kind']!='cannon':target['hp']=max(0.,target['hp']-amount)
                    events.append(['zombieAttack',round(t,3),z['id'],target['id'],round(amount,1)])
                continue
            if not flying:
                # Walk on the ground or on top of a climbed barrier.
                support=min([_siege_floor_body(r,nx,z['w'])]+[b['y']-b['h']/2 for b in bodies if b['hp']>0 and b['kind'] in ('wood','stone') and abs(nx-b['x'])<(z['w']+b['w'])/2 and b['y']-b['h']/2>=z['y']+z['h']/2-2])
                z['y']=support-z['h']/2
            # Zombies are a crowd, not mutually blocking rigid walls. The old
            # no-overlap test froze entire waves when one walker reached a
            # structure, including flyers trapped behind ground units.
            # Solid scenery is still handled above as a destructible obstacle;
            # cannons remain pass-through and dynamic.
            z['x']=max(z['w']/2,min(960-z['w']/2,nx))
        if physics:physics(t)
        frames.append(snap(t,None))
    # Show only the immediate post-attack collapse; the former 24 samples
    # added up to two seconds of waiting even when attacks were finished.
    # Bodies retain their actual position and velocity for the next round.
    if physics:
        for j in range(1,7):
            if not any(b['hp']>0 and not b.get('fixed') and b['kind']!='zombie' and (math.hypot(b['vx'],b['vy'])>20 or not _siege_body_supported(b,bodies,_siege_floor(r,b['x']))) for b in bodies):break
            t=start+1+j/12;physics(t);frames.append(snap(t,None))
    r['zombiePhasePhysics']=False
    for b in bodies:
        if b['kind']=='zombie' and b.get('sunderRounds',0)>0:b['sunderRounds']-=1
    r['armed']=[{} for _ in r['buffs']]
    _siege_zombie_supply(r)
    return t

def _siege_v24_world(r):
    # Stable mirrored templates, randomized within each selected map size.
    art=r.get('theme')=='art';bodies=r['bodies'];count=r['itemCount']
    if art:r['fieldLabel']='艺术就是爆炸'
    if art or (r.get('mode') in ('random',*_SIEGE_MAP_POOLS) and r.get('field') not in _SIEGE_NEW_FIELDS):
        layout=random.choice(('suspended','layers','tower','opentop','wall'))
        size=next((k for k,v in _SIEGE_MAP_POOLS.items() if r.get('field') in v),'pool_medium')
        offset=random.randint(-12,12)+({'pool_small':35,'pool_medium':0,'pool_large':-28}.get(size,0))
        rise=0 if art else r.get('rise',0)
        r.update(layout=layout,offset=offset,rise=rise,gunShift=0,bodies=_siege_fort(offset,layout,rise),gunMotion=[],reflectors=[])
        gx=235+offset+random.randint(-6,15);r['launchers']=[(gx,368-rise),(960-gx,368-rise)];bodies=r['bodies']
    slots=[]
    def free(x,y,w,h):
        return not any(b['hp']>0 and abs(b['x']-x)<(b['w']+w)/2+.1 and abs(b['y']-y)<(b['h']+h)/2+.1 for b in bodies)
    def add(x,y,w,h,kind,side=-1):
        hp={'wood':42,'stone':75,'barrel':18}[kind]
        bodies.append(dict(id=max((b['id'] for b in bodies),default=-1)+1,side=side,x=x,y=y,w=w,h=h,kind=kind,hp=hp,max=hp,vx=0.,vy=0.))
    def tower(x,zone,h,base):
        for xx in (x-30,x+30):add(xx,base-h/2,16,h,'stone' if zone=='center' else 'wood')
        add(x,base-h-8,76,16,'stone')
        slots.append((x,base-h*.55,zone))
        if art:
            for xx in (x-12,x+12):add(xx,base-12,20,24,'barrel')
    # Same side-tower height and layout on both sides. The slot retains its
    # zone even after destruction. A blocked center gets a supported roof base.
    if count or art:
        h=random.choice((72,84,96));base=_siege_floor(r,480)
        if not free(480,base-h/2,78,h):
            base=min([base]+[b['y']-b['h']/2 for b in bodies if b['hp']>0 and abs(b['x']-480)<b['w']/2+39])
        if free(480,base-h/2-.2,78,h):tower(480,'center',h,base)
        h=random.choice((72,84,96))
        for x in (350,330,375):
            y=_siege_floor(r,x)
            if free(x,y-h/2,78,h) and free(960-x,y-h/2,78,h):
                tower(x,'side',h,y);tower(960-x,'side',h,y);break
    if art or random.random()<.35:
        # Explosives near actual fort supports can propagate into the core.
        cx=next(b['x'] for b in bodies if b['side']==0 and b['kind']=='core')
        candidates=[cx+d for d in (-62,-44,44,62,78,95,110) if 30<cx+d<420]
        random.shuffle(candidates);placed=0
        for x in candidates:
            floor=_siege_floor(r,x)
            if free(x,floor-12,20,24) and free(960-x,floor-12,20,24):
                add(x,floor-12,20,24,'barrel');add(960-x,floor-12,20,24,'barrel');placed+=1
                if placed>=(2 if art else 1):break
    r['nextBodyId']=max(100,max((b['id'] for b in bodies),default=0)+1)
    if not count or not _siege_allowed(r):r['items']=[];return
    if not any(k in ('demolish','compound') for k in _siege_allowed(r)):slots=[]
    center=next((p for p in slots if p[2]=='center'),None)
    positions=[center] if center else []
    sides=[p for p in slots if p[2]=='side']
    if len(sides)==2 and count-len(positions)>=2:positions+=sides
    # Allocate mirrored pairs; an even total with a center slot gets a second
    # neutral air slot rather than favoring one player.
    if (count-len(positions))%2:
        for y in (75,110,145,185,35):
            if free(480,y,30,30) and all(math.hypot(480-a,y-b)>30 for a,b,_ in positions):
                positions.append((480,y,'air'));break
    air=[(i['x'],i['y']) for i in r['items'] if i['x']<450]
    for _ in range(1200):
        if len(positions)+2>count:break
        x,y=air.pop(0) if air else (random.randint(45,445),random.randint(45,250))
        if not free(x,y,30,30) or not free(960-x,y,30,30):continue
        if any(math.hypot(xx-a,y-b)<30 for xx in (x,960-x) for a,b,_ in positions):continue
        positions.extend([(x,y,'air'),(960-x,y,'air')])
    r['items']=[];pair_kind={};pair_amount={};pair_recipe={}
    for x,y,zone in positions[:count]:
        key=(round(min(x,960-x),1),round(y,1),zone);k=pair_kind.get(key) or _siege_v24_draw(r,zone);pair_kind[key]=k
        if k:
            amount=pair_amount.get(key) or _siege_v24_amount(r,k);pair_amount[key]=amount
            it=dict(id=len(r['items']),slot=len(r['items']),kind=k,x=x,y=y,r=15,amount=amount,zone=zone)
            if k=='compound':
                if key not in pair_recipe:pair_recipe[key]=_siege_compound_recipe()
                it['recipe']=pair_recipe[key]
            r['items'].append(it)

def _siege_new(name,identity,bot=False,item_count=_SIEGE_DEFAULT_ITEMS,mode='classic',wind_level='off',ammo=0,buff_mode='auto',allowed_buffs=None,stack_caps=None,fort_strength='normal'):
    r={'code':'','players':[{'name':name,'key':identity}]+([{'name':'练习炮手','key':'bot'}] if bot else []),'bot':bot,'turn':0,'shots':[0,0],'phase':'play' if bot else 'wait','winner':None,'rev':0,'event':None,'until':0.,'touched':time.time(),'itemCount':item_count,'mode':mode,'windLevel':wind_level,'ammo':ammo,'buffMode':buff_mode,'allowedBuffs':list(_siege_allowed({'allowedBuffs':allowed_buffs})),'stackCaps':stack_caps or {},'fortStrength':fort_strength}
    _siege_field(r);return r

def _siege_rematch(r):
    r.setdefault('itemCount',_SIEGE_DEFAULT_ITEMS);r.setdefault('mode','classic');r.setdefault('windLevel','off');r.setdefault('ammo',_SIEGE_MAX_SHOTS)
    r.update(turn=0,shots=[0]*max(2,r.get('zombiePlayerCount',2)),phase='play',winner=None,rev=r['rev']+1,event=None,until=0.)
    _siege_field(r)

def _siege_pos(b):return [b['id'],round(b['x'],1),round(b['y'],1),max(0,round(b['hp'],1))]
def _siege_core_body(bodies,side):return next(b for b in bodies if b['kind']=='core' and (b['side']==side or b.get('shared')))
def _siege_core(bodies,side):return _siege_core_body(bodies,side)['hp']
def _siege_cannon(r,side):
    return next((b for b in r.get('bodies',[]) if b['kind']=='cannon' and b['side']==side),None)
def _siege_install_cannons(r):
    # Canonical physical body, with barrel pivot at body top.
    for side in range(1 if r.get('zombieSolo') else r.get('zombiePlayerCount',2) if r.get('theme')=='zombie' else 2):
        x,y=_siege_launcher(side,r,0)
        r['bodies'].append(dict(id=r['nextBodyId'],kind='cannon',side=side,x=x,y=y+24,w=46,h=48,hp=75,max=75,vx=0.,vy=0.))
        r['nextBodyId']+=1
    r['gunMotion']=[]
    for b in r['bodies']:
        if b['kind']=='core':
            for k in ('fixed','motionY','floatFort','baseY'):b.pop(k,None)
def _siege_direction(r,side):
    if (r or {}).get('theme')=='zombie':return -1 if r.get('zombieBothSides') and side==0 else 1
    return 1 if side==0 else -1
def _siege_launcher(side,r=None,t=None):
    b=_siege_cannon(r,side) if r else None
    if b is not None:return b['x'],b['y']-24
    if r and r.get("launchers"):
        x,y=r['launchers'][side]
        if r.get('gunMotion'):
            m=r['gunMotion'][side];t=max(0,time.time()-r.get('motionEpoch',time.time())) if t is None else t
            y+=m['amplitude']*math.sin(t*.8+m['phase'])
        return x,min(y,_siege_floor(r,x)-48)
    offset=(r or {}).get("offset",0)+(r or {}).get("gunShift",0);return (235+offset if side==0 else 725-offset,368-(r or {}).get("rise",0))
def _siege_muzzle(side,r,angle,radius=6,t=None):
    x,y=_siege_launcher(side,r,t);a=math.radians(angle);d=_siege_direction(r,side)
    length=_SIEGE_BARREL+radius+2
    return x+d*math.cos(a)*length,y-math.sin(a)*length

def _siege_box_bounce(b,ox,oy,x,y,vx,vy,radius):
    # Expanded AABB: resolve the entering face, not the nearest centre.
    lo=b['x']-b['w']/2-radius;hi=b['x']+b['w']/2+radius
    top=b['y']-b['h']/2-radius;bottom=b['y']+b['h']/2+radius
    candidates=[]
    for edge,old,new,nx,ny in ((lo,ox,x,-1,0),(hi,ox,x,1,0),(top,oy,y,0,-1),(bottom,oy,y,0,1)):
        if new==old or vx*nx+vy*ny>=0:continue
        u=(edge-old)/(new-old)
        if 0<=u<=1:
            cx=ox+(x-ox)*u;cy=oy+(y-oy)*u
            if lo-.01<=cx<=hi+.01 and top-.01<=cy<=bottom+.01:candidates.append((u,nx,ny,cx,cy))
    if candidates:_,nx,ny,cx,cy=min(candidates)
    else:
        _,nx,ny,cx,cy=min([(abs(x-lo),-1,0,lo,y),(abs(x-hi),1,0,hi,y),(abs(y-top),0,-1,x,top),(abs(y-bottom),0,1,x,bottom)])
    dot=vx*nx+vy*ny
    if dot<0:vx-=1.76*dot*nx;vy-=1.76*dot*ny
    return cx+nx*.5,cy+ny*.5,vx,vy

def _siege_robot(r,side):return bool(r.get('bot') and side==1)

def _siege_shell_radius(r,n):return 6+(4 if _siege_v24(r) else 6)*n
def _siege_launch_check(r,side,angle,selection=None,t=None,force=False):
    # Protect the entire shell footprint against raised ground, even for forced fire.
    chosen=_siege_selection(r,selection,side)
    radius=_siege_shell_radius(r,chosen.get('big',0) if r.get('buffMode','auto')=='stock' else int(r['buffs'][side].get('big',0)>0))
    if radius<=6:return None
    x,y=_siege_muzzle(side,r,angle,radius,t)
    if y+radius>=min(_siege_floor(r,z) for z in (x-radius,x,x+radius)):
        raise ValueError('巨型弹炮口接触地面，请提高角度或减少巨型弹层数')
    blocked=next((b for b in r['bodies'] if b['hp']>0 and not (b['kind']=='cannon' and b['side']==side) and abs(x-b['x'])<b['w']/2+radius and abs(y-(b['baseY']+b['motionY']*math.sin(t*.8+b.get('phase',0)) if b.get('motionY') and t is not None else b['y']))<b['h']/2+radius),None)
    if blocked is not None and not force:raise ValueError('巨型弹炮口被建筑挡住，可强制开炮（可能误伤己方）')
    return blocked

def _siege_selection(r,selection,side=None):
    if r.get('buffMode','auto')!='stock':return {}
    if selection is None:selection={}
    if _siege_robot(r,r['turn'] if side is None else side) and isinstance(selection,dict):selection={k:n for k,n in selection.items() if k not in _SIEGE_ONE_SHOT}
    if not isinstance(selection,dict):raise ValueError('增益选择无效')
    _siege_normalize_buffs(r);seat=r['turn'] if side is None else side;inv=r['buffs'][seat];out={}
    for k,n in selection.items():
        if _siege_v24(r) and isinstance(k,str) and k.startswith('compound:'):
            recipe=k.split(':',1)[1]
            if recipe not in _SIEGE_COMPOUND_RECIPES or type(n) is not int or not 0<=n<=r['compoundRecipes'][seat].count(recipe):raise ValueError('复合弹配方数量超出库存')
            if n:out[k]=n
            continue
        if (k not in _SIEGE_SELECTABLE and not (_siege_v24(r) and k=='heal')) or (k in (*_SIEGE_TNT_KEYS,*_SIEGE_ELITE_KEYS) and not _siege_v24(r)) or (_siege_v24(r) and k not in _SIEGE_V24_KEYS) or type(n) is not int or not 0<=n<=min(_siege_cap(r,k),inv[k]):raise ValueError('增益数量超出库存或单次上限')
        if _siege_v24(r) and k in ('shield','armor') and n+r.get('armed',[{},{}])[r['turn'] if side is None else side].get(k,0)>_siege_cap(r,k):raise ValueError('已有防御待命，请减少本炮选择数量')
        if n:out[k]=n
    if _siege_v24(r) and sum(n for k,n in out.items() if k=='compound' or k.startswith('compound:'))>inv['compound']:raise ValueError('复合弹总数超出库存')
    if 'compound' in out and any(k.startswith('compound:') for k in out):raise ValueError('请选择具体复合弹配方')
    return out

def _siege_motion(r,t):
    for b in r['bodies']:
        if b.get('motionY'):b['y']=b['baseY']+b['motionY']*math.sin(t*.8+b.get('phase',0))

def _siege_reflect(r,ox,oy,x,y,vy,radius):
    # Sweep against the underside of a horizontal elastic rail, not a damageable block.
    # Return the contact point; the next physics tick continues with reflected velocity.
    if vy>=0 or y>=oy:return None
    for rail in r.get('reflectors',[]):
        surface=rail['y']+radius
        if oy>=surface and y<=surface:
            u=(oy-surface)/(oy-y);cx=ox+(x-ox)*u
            if rail['x1']<=cx<=rail['x2']:return cx,surface+.1
    return None

def _siege_v20_offset(t,spiral,negatives):
    # Spiral alone orbits the parabolic path. Unstable shots now have ONE launch angle error.
    t=max(0,t);phase=(6+2.2*spiral)*t
    dx=(10+3*spiral)*math.sin(phase) if spiral else 0.
    dy=(10+3*spiral)*(math.cos(phase)-1) if spiral else 0.
    return dx,dy

def _siege_v20_fart(t):
    return 180+640*max(0,math.sin(t*18))

def _siege_v20_vanish(distance,negatives):
    return max(.22,1-distance/1150) if negatives.get('vanish') else 1.

def _siege_v20_radius(radius,distance,negatives):
    return max(2.5,radius*_siege_v20_vanish(distance,negatives))

def _siege_v20_push(body,vx,vy,layers):
    """Maintain the hit shell's direction and velocity for TWO seconds per layer."""
    if body.get('platform') or body.get('kind')=='core' or layers<=0:return
    speed=max(220.,min(610.,math.hypot(vx,vy)*.9))
    mag=max(1.,math.hypot(vx,vy))
    body['pushVX']=vx/mag*speed
    body['pushVY']=vy/mag*speed
    # Preserve remaining forced-flight time when another projectile hits this block.
    body['pushTime']=body.get('pushTime',0.)+2.0*layers
    body['vx']=body['pushVX'];body['vy']=body['pushVY']
    # A fixed floating fort piece must be released before it can fly.
    for key in ('fixed','motionY','floatFort','baseY'):body.pop(key,None)

def _siege_body_mass(b):
    density=1.8 if b['kind']=='stone' else 1.35 if b['kind']=='core' else 1.
    return max(.55,b['w']*b['h']/1368*density)

def _siege_wall_damage(speed):
    return min(85.,85.*(max(0.,min(650.,speed)-120.)/530.)**1.5)

def _siege_falling_crush_damage(body,vertical_speed):
    """Kinetic-type overhead impact, not a flat per-block damage constant.

    Fixed zombies use pathfinding rather than rigid-body motion; their former
    fixed-body contact path only damaged the falling block. The 120 px/s
    threshold prevents resting/jittering blocks from hurting stationary mobs.
    """
    if body['kind'] not in ('stone','wood') or vertical_speed<=120.:
        return 0.
    mass=min(1.65,_siege_body_mass(body)**.5)
    material=1.35 if body['kind']=='stone' else .75
    return min(90.,(vertical_speed-120.)*.11*mass*material)

def _siege_v24_push(body,vx,vy,layers,share=1.):
    if body['hp']<=0 or layers<=0:return
    mag=max(1.,math.hypot(vx,vy))
    mass=_siege_body_mass(body)
    strength=(290+105*(layers-1))*share/max(.75,mass**.5)
    body['vx']+=vx/mag*strength
    body['vy']+=min(-170*share,vy/mag*strength-220*share)
    forces=body.setdefault('pushForces',[])
    forces.append([vx/mag*300.*share, min(0.,vy/mag)*180.*share,min(1.1,.35+.15*layers)])
    body['pushTime']=max(f[2] for f in forces)
    for key in ('fixed','motionY','floatFort','baseY'):body.pop(key,None)

def _siege_tnt_arm(b,now,source=None):
    if b['kind'] not in _SIEGE_TNT_KINDS or b['hp']<=0:return False
    deadline=now+.10
    if deadline<b.get('tntDeadline',float('inf')):
        b['tntDeadline']=deadline;b['tntTriggerAt']=now
        b['tntSource']=source if source in (0,1) else b.get('side',-1)
    b['tntTriggered']=True
    return True

def _siege_body_supported(b,bodies,floor):
    feet=b['y']+b['h']/2
    return abs(feet-floor)<=1.5 or any(c is not b and c['hp']>0 and abs(c['x']-b['x'])<(c['w']+b['w'])/2 and abs(c['y']-c['h']/2-feet)<=1.5 for c in bodies)

def _siege_tnt_step(b,bodies,floor,now,dt):
    if b['kind']!='tnt' or b['hp']<=0 or 'tntDeadline' in b:return
    supported=_siege_body_supported(b,bodies,floor)
    b['tntStable']=b.get('tntStable',0.)+dt if supported and math.hypot(b['vx'],b['vy'])<18. else 0.
    if b['tntStable']>=.20-1e-8:
        b['tntDeadline']=now+1.;b['tntFuseStart']=now;b['tntSource']=b.get('side',-1)

def _siege_tnt_alloc(counts):
    """Distribute the shared shot budget across separate projectile branches."""
    total=(1+counts.get('repeat',0))*2**counts.get('splitshot',0)
    out=[{} for _ in range(total)]
    budget=min(_SIEGE_TNT_SHOT_CAP,total*sum(counts.get(k,0) for k in _SIEGE_TNT_KEYS))
    types=[]
    for layer in range(max((counts.get(k,0) for k in _SIEGE_TNT_KEYS),default=0)):
        types.extend(k for k in _SIEGE_TNT_KEYS if counts.get(k,0)>layer)
    if not types:return out
    for i in range(budget):
        rank=(i*total//min(total,budget))%total
        k=types[(i//total+i%total)%len(types)]
        if out[rank].get(k,0)>=counts.get(k,0):
            k=next((q for q in _SIEGE_TNT_KEYS if out[rank].get(q,0)<counts.get(q,0)),None)
        if k:out[rank][k]=out[rank].get(k,0)+1
    return out

def _siege_support_surface(r,x,width,feet,ignore=None):
    """Nearest living solid surface underneath the object's feet (not above it)."""
    surface=_siege_floor(r,x)
    for b in r['bodies']:
        if b is ignore or b['hp']<=0 or b.get('falling'):continue
        if abs(x-b['x'])<(width+b['w'])/2 and b['y']-b['h']/2>=feet-2.:
            surface=min(surface,b['y']-b['h']/2)
    return surface

def _siege_gun_gravity(r,dt):
    """After cannon teleport, its support may be destroyed on later shots."""
    for side in range(len(r.get('launchers',[]))):
        if _siege_cannon(r,side) is not None:continue
        if not r.get('launchers') or not r.get('gunGravity',[False,False])[side]:continue
        if r.get('gunMotion') and r['gunMotion'][side].get('amplitude'):continue
        x,y=r['launchers'][side]
        floor=_siege_support_surface(r,x,52,y+48)-48
        if y<floor-.1:
            r['gunFallV'][side]=min(720.,r['gunFallV'][side]+_SIEGE_GRAV*dt)
            r['launchers'][side][1]=min(floor,y+r['gunFallV'][side]*dt)
        else:r['gunFallV'][side]=0.


_SIEGE_SCOPEABLE=('bounce','through','spiral','power','shock','pierce','push','blackhole','ignite','firetrail','snake','dive','antigrav','homing','pingpong','fuse')
_SIEGE_EVENT_KINDS=('launch','apex','bounce','through','end')
_SIEGE_PAYLOADS=('splitshot','bounceblast','wooddrop','stonedrop','mine','blackhole','ignite','clone',*_SIEGE_TNT_KEYS)
_SIEGE_RETIRED=('larpa','downpour','fuse')
_SIEGE_REPLACEMENT={'larpa':'splitshot','downpour':'splitshot','fuse':'bounceblast'}
_SIEGE_ACTIVE_ITEMS=tuple(k for k in _SIEGE_ITEMS if k not in (*_SIEGE_RETIRED,*_SIEGE_TNT_KEYS,*_SIEGE_ELITE_KEYS))
_SIEGE_OBJECT_LIMITS={'wooddrop':24,'stonedrop':24,'mine':12,'clone':12,'blackhole':12,'tntdrop':8,'tntwait':8}
def _siege_migrate_catalog(r):
    # Only public sessions migrate; legacy direct engine regressions remain reproducible.
    _siege_normalize_buffs(r)
    if _siege_v24(r):
        r['allowedBuffs']=list(_siege_allowed(r));return
    for b in r['buffs']:
        for k in _SIEGE_RETIRED:
            b[_SIEGE_REPLACEMENT[k]]+=b.get(k,0);b[k]=0
    for it in (*r.get('items',[]),*r.get('respawns',[])):
        if it.get('kind') in _SIEGE_RETIRED:it['kind']=_SIEGE_REPLACEMENT[it['kind']]
    r['allowedBuffs']=list(_siege_allowed(r))

def _siege_public_config(config=None):
    if config is None:config={}
    if not isinstance(config,dict):raise ValueError('炮弹配置无效')
    out=dict(config);out.update(unified=True,manual=True,delayedSplit=True)
    if 'triggers' not in out and 'splitMode' in out:
        old={'air':'apex','hit':'end','timer':'apex','bounce':'bounce','expire':'end'}.get(out['splitMode'])
        if old:out['triggers']={'splitshot':old}
    return _siege_config(out)

def _siege_event_for(config,k):
    return config['triggers'].get(k,'apex' if k=='splitshot' else 'bounce' if k=='bounceblast' else 'end')

def _siege_config(config=None):
    if config is None:config={}
    if not isinstance(config,dict) or set(config)-{'build','fuseMode','fuseTime','splitMode','splitTime','parentEnd','scopes','childFuseTime','diveTime','copyMode','childSplit','blackholeMode','simple','unified','triggers','splitPattern','burstMode','manual','delayedSplit'}:raise ValueError('炮弹配置无效')
    out={'build':config.get('build','attack'),'fuseMode':config.get('fuseMode','strict'),'fuseTime':config.get('fuseTime',3),'splitMode':config.get('splitMode','air'),'splitTime':config.get('splitTime',1.5),'parentEnd':config.get('parentEnd','continue'),'scopes':config.get('scopes',{}),'childFuseTime':config.get('childFuseTime',0),'diveTime':config.get('diveTime',1.2),'copyMode':config.get('copyMode','bounce'),'childSplit':config.get('childSplit',False),'blackholeMode':config.get('blackholeMode','fixed'),'simple':config.get('simple',False),'unified':config.get('unified',False),'triggers':config.get('triggers',{}),'splitPattern':config.get('splitPattern','fan'),'burstMode':config.get('burstMode','serial'),'manual':config.get('manual',False),'delayedSplit':config.get('delayedSplit',False)}
    if out['build'] not in ('safe','attack') or out['fuseMode'] not in ('strict','either','delay') or out['splitMode'] not in ('air','hit','timer','bounce','expire') or out['parentEnd'] not in ('continue','vanish','explode'):raise ValueError('炮弹行为无效')
    if type(out['unified']) is not bool or not isinstance(out['triggers'],dict) or any(k not in _SIEGE_PAYLOADS or (v not in _SIEGE_EVENT_KINDS and not (k=='splitshot' and v=='contact')) for k,v in out['triggers'].items()) or out['splitPattern'] not in ('fan','down','radial') or out['burstMode'] not in ('serial','volley'):raise ValueError('触发设置无效')
    if type(out['manual']) is not bool or type(out['delayedSplit']) is not bool:raise ValueError('操纵配置无效')
    if type(out['simple']) is not bool:raise ValueError('炮弹配置无效')
    if out['blackholeMode'] not in ('fixed','attached'):raise ValueError('引力场行为无效')
    if out['copyMode'] not in ('bounce','expire','trail','chaos','orbit') or type(out['childSplit']) is not bool:raise ValueError('复制行为无效')
    for k in ('fuseTime','splitTime','diveTime'):
        if type(out[k]) not in (int,float) or not .5<=out[k]<=5:raise ValueError('触发时间须在0.5至5秒之间')
    if type(out['childFuseTime']) not in (int,float) or not (out['childFuseTime']==0 or .5<=out['childFuseTime']<=5):raise ValueError('子弹引信时间无效')
    if not isinstance(out['scopes'],dict) or any(k not in _SIEGE_SCOPEABLE or v not in ('mother','child','both') for k,v in out['scopes'].items()):raise ValueError('修饰器作用对象无效')
    if out['unified']:
        out.update(simple=True,scopes={},childSplit=False,parentEnd='vanish',splitMode='air')
    if out['simple']:
        # Game-facing presets own their timing. Legacy explicit configurations remain compatible.
        out.update(fuseTime=2.5,splitTime=1.5,diveTime=1.2,childFuseTime=0)
    return out

def _siege_compile_spec(counts,config):
    """Compile immutable per-shot behavior; children do not recursively copy event generators."""
    if config.get('unified'):
        root={k:v for k,v in counts.items() if k not in _SIEGE_RETIRED}
        child={k:v for k,v in root.items() if k not in ('repeat','splitshot','gunteleport','coreteleport')}
        return dict(root=root,child=child,events=[dict(event=_siege_event_for(config,k),effect=k,count=root[k]) for k in _SIEGE_PAYLOADS if root.get(k)])
    scopes=config['scopes'] if any(counts.get(k) for k in ('splitshot','larpa','downpour')) else {}
    root={k:v for k,v in counts.items() if scopes.get(k,'both')!='child'}
    child={k:v for k,v in counts.items() if scopes.get(k,'both')!='mother' and k not in ('repeat','splitshot','larpa','downpour','bounceblast','clone')}
    # Source shells keep the original geometry; child scope changes effects and motion.
    rules=[]
    if counts.get('splitshot'):rules.append(dict(event=config['splitMode'],effect='split',count=2*counts['splitshot'],after=config['parentEnd']))
    if counts.get('larpa'):rules.append(dict(event={'bounce':'bounce','expire':'expire','trail':'interval','chaos':'interval','orbit':'launch'}[config['copyMode']],effect='copy',count=2*counts['larpa'],pattern=config['copyMode']))
    if counts.get('bounceblast'):rules.append(dict(event='bounce',effect='blast',count=2*counts['bounceblast']))
    if counts.get('downpour'):rules.append(dict(event='interval',effect='down',count=2*counts['downpour'],interval=.35))
    return dict(root=root,child=child,events=rules)

def _siege_release_interval(level,base):
    # Higher stacks release more promptly in ordinary, short artillery flights.
    return base/(1+.25*max(0,level-1))

def _siege_dive_strike(level):
    return 1+.2*max(0,level)

def _siege_v24_guidance(vx,vy,x,y,dt,side,bodies,age=0.):
    """Coop acquires nearest living zombie after .2s; classic keeps its midfield gate."""
    coop=any(b.get('shared') for b in bodies)
    if coop:
        if age<.2-1e-8:return vx,vy
        target=min((b for b in bodies if b['kind']=='zombie' and b['hp']>0),key=lambda b:math.hypot(b['x']-x,b['y']-y),default=None)
    else:
        if (side==0 and x<480.) or (side==1 and x>480.):return vx,vy
        target=next((b for b in bodies if b['kind']=='core' and b['side']==1-side and b['hp']>0),None)
    if target is None:return vx,vy
    dx,dy=target['x']-x,target['y']-y
    if math.hypot(dx,dy)<1e-8:return vx,vy
    goal=math.atan2(dy,dx)
    speed=math.hypot(vx,vy)
    angle=math.atan2(vy,vx) if speed>1. else goal
    diff=(goal-angle+math.pi)%(2*math.pi)-math.pi
    turn=7.5*dt
    angle+=max(-turn,min(turn,diff))
    # Strong propulsion prevents a slow shell from falling short after crossing.
    speed=min(800.,max(400.,speed+(650.-speed)*min(1.,6.*dt)))
    return speed*math.cos(angle),speed*math.sin(angle)

def _siege_motion_delta(vx,vy,x,y,age,dt,counts,config,side,bodies,dived=False):
    """A real velocity transform, shared by the mother and every child."""
    if counts.get('dive') and not dived and (age>=config['diveTime'] if not config.get('simple') else age>=.18 and (vy>=0 or age>=2.5)):
        vx=0.;vy=300.+60*(counts['dive']-1);dived=True
    # Each layer purchases exactly one periodic reversal. Vertical dive owns vx
    # until it is redirected by a subsequent real bounce or homing force.
    folds=int((max(0,age)+1e-8)/.65);previous=int((max(0,age-dt)+1e-8)/.65)
    if counts.get('pingpong') and previous<folds<=counts['pingpong'] and not dived:vx=-vx
    if counts.get('homing') and config.get('autoHomingV24'):
        vx,vy=_siege_v24_guidance(vx,vy,x,y,dt,side,bodies,age)
    elif counts.get('homing'):
        target=next((b for b in bodies if b['kind']=='core' and b['side']==1-side and b['hp']>0),None)
        if target and math.hypot(target['x']-x,target['y']-y)<=100+20*counts['homing']:
            speed=math.hypot(vx,vy)
            if speed>1:
                a=math.atan2(vy,vx);goal=math.atan2(target['y']-y,target['x']-x);d=(goal-a+math.pi)%(2*math.pi)-math.pi
                turn=(.7+.25*counts['homing'])*dt;a+=max(-turn,min(turn,d));vx=speed*math.cos(a);vy=speed*math.sin(a)
    return vx,vy,dived

def _siege_gravity(counts,negatives):
    return _SIEGE_GRAV*max(-.5,1-.30*counts.get('antigrav',0))*(6.5 if negatives.get('heavy') else 1)

def _siege_path_offset(t,counts,negatives):
    x,y=_siege_v20_offset(t,counts.get('spiral',0),negatives)
    if counts.get('snake'):y+=(7+5*counts['snake'])*math.sin(max(0,t)*12)
    return x,y

def _siege_burn_round(r):
    """Advance fire once per completed round, never on real-time waiting."""
    bodies=r['bodies'];burning=[b for b in bodies if b['hp']>0 and b.get('burnRounds',0)>0]
    if not burning:return False
    # Snapshot sources: newly ignited blocks do not propagate or take burn damage this round.
    burning_ids={b['id'] for b in burning};spread=[]
    for b in burning:
        for c in bodies:
            if c['kind']!='wood' or c['hp']<=0 or c['id'] in burning_ids or c.get('burnRounds',0)>0 or c.get('burnSpent'):continue
            dx=max(0,abs(c['x']-b['x'])-(c['w']+b['w'])/2);dy=max(0,abs(c['y']-b['y'])-(c['h']+b['h'])/2)
            if math.hypot(dx,dy)>2:continue
            # Adjacent material only; a stone wall cannot conduct the spread.
            if c not in spread:spread.append(c)
    for b in burning:
        b['hp']=max(0,b['hp']-b.get('burnDamage',5));b['burnRounds']-=1
        if not b['burnRounds']:b['burnSpent']=True
        if b['hp']<=0:b['burnRounds']=0;b.pop('fixed',None)
    for b in spread:
        if b['hp']>0:
            advanced=any(src.get('burnDamage',5)>=14 for src in burning)
            b['burnRounds']=3 if advanced else 2;b['burnDamage']=14 if advanced else 5
    return True

def _siege_trial_stock(r):
    # Trial inventory is refilled after each shot; ordinary rooms never enter here.
    r['buffs'][0]={k:_SIEGE_V24_CAPS.get(k,0) if _siege_v24(r) else max(1,_SIEGE_HARD_CAPS[k]) if k in _SIEGE_ACTIVE_ITEMS else 0 for k in _SIEGE_ITEMS}
    r['buffs'][1]={k:0 for k in _SIEGE_ITEMS}
    if _siege_v24(r):r['compoundRecipes']=[[k for k in _SIEGE_COMPOUND_RECIPES for _ in range(3)],[]]

def _siege_trial_reset(r,mode=None):
    if mode is not None:
        if mode not in (*_SIEGE_FIELDS,*_SIEGE_NEW_FIELDS,'classic'):raise ValueError('试验地图无效')
        r['mode']=mode
    r.update(turn=0,shots=[0,0],phase='play',winner=None,rev=r['rev']+1,event=None,until=0.,ammo=0,itemCount=0,buffMode='stock',combatMode='turn',trial=True,trialDamage=0.)
    rng=random.getstate()
    try:
        random.seed('siege-trial-'+r['mode']);_siege_field(r)
    finally:random.setstate(rng)
    _siege_trial_stock(r)

_SIEGE_TRIAL_ZOMBIE_LIMIT=12
def _siege_trial_summon(r,kind,count):
    """Place destructible zombie specimens in the private trial arena only.

    Training specimens use the real zombie body, HP, armor and hit rules, but
    remain stationary. A wave AI tick is deliberately not started in a trial
    since it would unexpectedly damage/reset the target structures.
    """
    if kind not in _SIEGE_ZOMBIE_TYPES or kind=='engineer':
        raise ValueError('未知丧尸种类')
    if type(count) is not int or count not in (1,3):
        raise ValueError('只能召唤 1 或 3 只')
    existing=sum(b['kind']=='zombie' and b['hp']>0 for b in r['bodies'])
    if existing+count>_SIEGE_TRIAL_ZOMBIE_LIMIT:
        raise ValueError('场上最多保留 12 只丧尸，请先清空图鉴召唤')
    w,h,hp,_,_=_SIEGE_ZOMBIE_TYPES[kind]
    positions=[]
    for x in range(920,505,-8):
        y=_siege_floor_body(r,x,w)-h/2
        if y-h/2 < 6:continue
        if any(b['hp']>0 and
               abs(x-b['x'])<(w+b['w'])/2+5 and
               abs(y-b['y'])<(h+b['h'])/2+5
               for b in (*r['bodies'],*positions)):continue
        positions.append(dict(id=r['nextBodyId']+len(positions),kind='zombie',
                              zombieType=kind,trialSpecimen=True,side=2,
                              x=float(x),y=y,w=w,h=h,hp=hp,max=hp,
                              fixed=True,vx=0.,vy=0.))
        if len(positions)==count:break
    if len(positions)!=count:raise ValueError('当前地图的右侧空地不足，请减少数量或切换地图')
    r['bodies'].extend(positions);r['nextBodyId']+=count
    r['event']=None;r['rev']+=1
    return len(positions)

def _siege_trial_steps(r,angle,power,selection,force=False,config=None,control=None):
    if not isinstance(selection,dict):raise ValueError('增益选择无效')
    selected={}
    for k,n in selection.items():
        if _siege_v24(r) and isinstance(k,str) and k.startswith('compound:'):
            if k.split(':',1)[1] not in _SIEGE_COMPOUND_RECIPES or type(n) is not int or not 0<=n<=3:raise ValueError('复合弹数量无效')
            if n:selected[k]=n
            continue
        if k not in _SIEGE_ITEMS or type(n) is not int or not 0<=n<=_siege_cap(r,k):raise ValueError('增益数量无效')
        if n:selected[k]=n
    config=_siege_config(config)
    # Validate before modifying any state. Negatives and heal are trial-only direct choices.
    chosen={k:n for k,n in selected.items() if k in _SIEGE_SELECTABLE or (_siege_v24(r) and (k=='heal' or k.startswith('compound:')))}
    _siege_launch_check(r,0,angle,chosen,force=force)
    r['negativePending'][0]={k:1 for k in _SIEGE_NEGATIVE if selected.get(k)}
    if selected.get('heal') and not _siege_v24(r):
        core=next(b for b in r['bodies'] if b['kind']=='core' and b['side']==0);core['hp']=min(core['max'],core['hp']+18)
    # Target defense enables real damage-reduction comparisons without enemy fire.
    if not _siege_v24(r):r['armed'][1]={k:selected[k] for k in _SIEGE_DEFENSE if k in selected}
    elif _siege_v24(r):r['armed'][1]={k:selected[k] for k in ('shield','armor') if selected.get(k)} # test target defense
    chosen={k:n for k,n in chosen.items() if k not in _SIEGE_DEFENSE}
    yield from _siege_fire_steps(r,angle,power,chosen,force=force,config=config,control=control)
