# Room-scoped legacy engines: one lock guards context switching and all mutations.
ROOMS_FILE=DATA_DIR/'gamehall_rooms_v05.json'
ROOMS={}
_ROOM_ACTIVE=None
_ROOM_GLOBALS=('STATE','TOKENS','ACTION_CACHE','_bot_pending','_bot_due','_army_cache','_army_due')
def _room_record(code, mode='cards'):
    s=fresh_state();s['mode']=mode
    return {'code':code,'state':s,'tokens':{},'runtime':{},'created':time.time()}
try:
    for code,record in json.loads(ROOMS_FILE.read_text(encoding='utf-8')).items():
        if re.fullmatch('[A-F0-9]{6}',code):
            record['state']=migrate(record['state']);record['runtime']={};ROOMS[code]=record
except (OSError,ValueError,TypeError,KeyError):pass

@contextmanager
def _room_scope(record):
    global _ROOM_ACTIVE
    with LOCK:
        old={k:globals()[k] for k in _ROOM_GLOBALS};previous=_ROOM_ACTIVE
        runtime=record['runtime']; defaults={'ACTION_CACHE':{},'_bot_pending':None,'_bot_due':0.,'_army_cache':(None,None),'_army_due':(None,0.)}
        globals().update(STATE=record['state'],TOKENS=record['tokens'])
        for k,v in defaults.items():globals()[k]=runtime.get(k,v)
        _ROOM_ACTIVE=record
        try:yield
        finally:
            record['state']=STATE;record['tokens']=TOKENS
            for k in defaults:runtime[k]=globals()[k]
            globals().update(old);_ROOM_ACTIVE=previous

_legacy_snapshot=_snapshot_json
_legacy_flush=flush_state
def flush_state():
    # Keep original state file intact; room state has its own atomic snapshot.
    _legacy_flush()
    try:
        with SAVE_WRITE_LOCK:
            with LOCK:
                payload=json.dumps({k:{n:v for n,v in r.items() if n!='runtime'} for k,r in ROOMS.items()},ensure_ascii=False)
            tmp=ROOMS_FILE.with_suffix('.tmp');tmp.write_text(payload,encoding='utf-8');tmp.replace(ROOMS_FILE)
    except Exception as e:print('房间保存失败:',e)

_ROOM_MODES=('cards','dice','draw','ddz','chuanma','army','siege')
def _room_list():
    return [{'code':k,'mode':r['state']['mode'] if r.get('selected',True) else None,'phase':r['state']['phase'],'host':next((p['name'] for p in r['state']['players'] if p['id']==r['state']['hostPlayerId']),'等待加入'), 'count':sum(not p.get('isBot') for p in r['state']['players']),'capacity':4} for k,r in ROOMS.items() if r['state']['players']]

def _room_create(data):
    # Create and acquire the host seat atomically under the room lock.
    now=time.time()
    for k,r in list(ROOMS.items()):
        if not r['state']['players'] and now-r['created']>180:del ROOMS[k]
    if len(ROOMS)>=64:return {'ok':False,'error':'房间数量已达上限'}
    code=secrets.token_hex(3).upper()
    while code in ROOMS:code=secrets.token_hex(3).upper()
    r=_room_record(code);r['selected']=False
    class Capture:
        def reply(self,payload,*args):self.payload=payload
    cap=Capture()
    # Only accept identity fields, never a token/seat from a different room.
    identity={'name':str(data.get('name','游客'))[:10], 'accountToken':str(data.get('accountToken',''))[:256], 'seatKey':secrets.token_urlsafe(24)}
    with _room_scope(r):
        _room_join_base(cap,identity)
    result=cap.payload
    if not result.get('ok'):return result
    ROOMS[code]=r;save_state()
    return {**result,'code':code,'seatKey':identity['seatKey']}

_room_join_base=Handler.join_player
def _room_join(self,data):
    if _ROOM_ACTIVE and not STATE['players'] and _ROOM_ACTIVE.get('claim'):
        if not secrets.compare_digest(str(data.get('claim','')),_ROOM_ACTIVE['claim']):return self.reply({'ok':False,'error':'等待创建者进入房间'})
        result=_room_join_base(self,data)
        if STATE['players']:_ROOM_ACTIVE.pop('claim',None);save_state()
        return result
    return _room_join_base(self,data)
Handler.join_player=_room_join

_room_action_base=Handler.handle_action
_room_public_base=public_state

def _room_start_siege(player,solo=False):
    if player['id']!=STATE['hostPlayerId'] or STATE['phase']!='lobby':return {'error':'仅房主可以开始'},403
    humans=[p for p in STATE['players'] if not p.get('isBot')]
    if solo:
        if len(humans)!=1:return {'error':'单人练习仅限一名真人'},409
        if len(STATE['players'])==1:
            add_local_bot();STATE['players'][-1]['autoBot']=True
        player['ready']=True
    if len(STATE['players'])!=2 or not humans or not all(is_connected(p) for p in humans):return {'error':'需要两名在线玩家'},409
    seats=sorted(STATE['players'],key=lambda p: p['id']!=STATE['hostPlayerId'])
    r=_siege_new(seats[0]['name'],seats[0]['id'],bool(seats[1].get('isBot')),STATE['settings'].get('siegeItemCount',_SIEGE_DEFAULT_ITEMS),('random' if STATE['settings'].get('siegeMode','random')=='dynamic' else STATE['settings'].get('siegeMode','random')),STATE['settings'].get('siegeWind','medium'),STATE['settings'].get('siegeAmmo',0),STATE['settings'].get('siegeBuffMode','auto'))
    r.update(code=_ROOM_ACTIVE['code'],players=[{'name':p['name'],'key':p['id']} for p in seats],phase='play')
    STATE.update(siege=r,phase='siege_play',matchId=secrets.token_hex(16),turnPlayerId=seats[0]['id'],roundNo=1);bump();return {},200

def _room_action(self,player,action,data):
    if _ROOM_ACTIVE is None:return _room_action_base(self,player,action,data)
    if action in ('start','solo_start','add_bot') and not _ROOM_ACTIVE.get('selected',True):return {'error':'请先选择游戏'},409
    if action=='toggle_ready':return {},200  # legacy clients; no readiness gate
    if action=='dissolve':
        if player['id']!=STATE['hostPlayerId']:return {'error':'仅房主可解散房间'},403
        ROOMS.pop(_ROOM_ACTIVE['code'],None);save_state();return {'dissolved':True},200
    if action=='set_mode' and data.get('mode')=='siege':
        if STATE['phase']!='lobby' or player['id']!=STATE['hostPlayerId']:return {'error':'仅房主可在房间选择游戏'},403
        STATE['mode']='siege';_ROOM_ACTIVE['selected']=True;trim_bots_for_mode('siege')
        for p in STATE['players']:p['ready']=bool(p.get('isBot'))
        bump();return {},200
    if STATE['mode']=='siege':
        if action=='siege_settings':
            if STATE['phase']!='lobby' or player['id']!=STATE['hostPlayerId']:return {'error':'仅房主可在房间设置'},403
            count=data.get('itemCount')
            if type(count) is not int or not 0<=count<=_SIEGE_MAX_ITEMS:return {'error':'道具数量须为 0–25 的整数'},400
            ammo=data.get('ammo',STATE['settings'].get('siegeAmmo',0));mode=data.get('mode',('random' if STATE['settings'].get('siegeMode','random')=='dynamic' else STATE['settings'].get('siegeMode','random')));wind=data.get('wind',STATE['settings'].get('siegeWind','medium'))
            if type(ammo) is not int or ammo not in _SIEGE_AMMO or type(mode) is not str or mode not in _SIEGE_MODES or type(wind) is not str or wind not in _SIEGE_WIND:return {'error':'战场设置无效'},400
            buff_mode=data.get('buffMode',STATE['settings'].get('siegeBuffMode','auto'))
            if buff_mode not in ('auto','stock'):return {'error':'增益模式无效'},400
            STATE['settings'].update(siegeItemCount=count,siegeAmmo=ammo,siegeMode=mode,siegeWind=wind,siegeBuffMode=buff_mode);bump();return {},200
        if action in ('start','solo_start'):return _room_start_siege(player,action=='solo_start')
        if action=='reset':
            if player['id']!=STATE['hostPlayerId']:return {'error':'仅房主可结束本局'},403
            r=STATE.get('siege');
            if r and r['phase']=='play' and time.time()<r['until']:return {'error':'请等待炮击动画结束'},409
            STATE.pop('siege',None);STATE.update(phase='lobby',turnPlayerId=None,roundNo=0,winnerId=None);bump();return {},200
    result=_room_action_base(self,player,action,data)
    if action=='set_mode' and result[1]==200:_ROOM_ACTIVE['selected']=True;save_state()
    return result
Handler.handle_action=_room_action

def public_state(player_id,draw_since=-1,draw_revision=-1):
    v=_room_public_base(player_id,draw_since,draw_revision)
    if _ROOM_ACTIVE:
        v['roomCode']=_ROOM_ACTIVE['code'];v['modeSelected']=_ROOM_ACTIVE.get('selected',True)
        if not v['modeSelected']:v['canStart']=False
        if STATE['mode']=='siege':v['canStart']=v['canStart'] and len(STATE['players'])==2
    return v

def _room_siege(data):
    pid=TOKENS.get(str(data.get('token','')));p=player_by_id(pid);r=STATE.get('siege')
    if not p or not r or STATE['mode']!='siege' or STATE['phase']!='siege_play':return {'ok':False,'error':'对局已结束，请返回房间','roomEnded':True}
    touch_player(p);kind=data.get('type');now=time.time();seat=next((i for i,x in enumerate(r['players']) if x['key']==pid),None)
    if seat is None:return {'ok':False,'error':'不在对局中'}
    if kind=='fire':
        a,power=data.get('angle'),data.get('power')
        if r['phase']!='play' or r['turn']!=seat or now<r['until'] or data.get('rev')!=r['rev']:return {'ok':False,'error':'当前不能发射，请等待回合'}
        if type(a) not in (int,float) or type(power) not in (int,float) or not (5<=a<=175 and 15<=power<=100):return {'ok':False,'error':'角度或力度无效'}
        try:_siege_fire(r,a,power,data.get('selection'))
        except ValueError as e:return {'ok':False,'error':str(e)}
        save_state()
    elif kind=='rematch':
        if pid!=STATE['hostPlayerId'] or r['phase']!='over' or now<r['until']:return {'ok':False,'error':'等待房主开始下一局'}
        # Existing v0.8 matches finish under their original rules; new rounds use room settings.
        r.update(itemCount=STATE['settings'].get('siegeItemCount',13),mode=('random' if STATE['settings'].get('siegeMode','random')=='dynamic' else STATE['settings'].get('siegeMode','random')),windLevel=STATE['settings'].get('siegeWind','medium'),ammo=STATE['settings'].get('siegeAmmo',0),buffMode=STATE['settings'].get('siegeBuffMode','auto'))
        _siege_rematch(r);save_state()
    elif kind=='return':
        if pid!=STATE['hostPlayerId']:return {'ok':False,'error':'请等待房主返回房间'}
        if now<r['until']:return {'ok':False,'error':'请等待炮击结束'}
        STATE.pop('siege',None);STATE.update(phase='lobby',turnPlayerId=None,roundNo=0);bump();return {'ok':True,'returned':True}
    elif kind!='state':return {'ok':False,'error':'未知操作'}
    if r['bot'] and r['phase']=='play' and r['turn']==1 and now>=r['until']+.65:_siege_bot(r);save_state()
    v=_siege_public(r,pid,data.get('last',-1));v['host']=pid==STATE['hostPlayerId'];return v

_rooms_get_base=Handler.do_GET;_rooms_post_base=Handler.do_POST

def _room_route(self,post=False):
    # Bound a stalled client so it cannot indefinitely retain the shared room lock.
    self.connection.settimeout(8)
    parsed=urlparse(self.path);path=parsed.path;match=re.fullmatch(r'/r/([A-Fa-f0-9]{6})(/.*)?',path)
    if not post and path=='/':return self.reply(HUB_PAGE,200,'text/html; charset=utf-8')
    if not post and path=='/api/rooms':
        with LOCK:return self.reply({'rooms':_room_list()})
    if post and path=='/api/rooms':
        try:
            if not 0<int(self.headers.get('Content-Length','0'))<=4096:raise ValueError()
            data=self.read_json()
            if not isinstance(data,dict):raise ValueError()
            with LOCK:return self.reply(_room_create(data))
        except (ValueError,TypeError):return self.reply({'ok':False,'error':'请求无效'},400)
    if match:
        code=match[1].upper();sub=match[2] or '/'
        with LOCK:
            r=ROOMS.get(code)
            if not r:return self.reply({'ok':False,'error':'房间已解散','roomEnded':True},404) if sub.startswith('/api/') else self.reply(HUB_PAGE,200,'text/html; charset=utf-8')
            with _room_scope(r):
                if post:
                    try:
                        if not 0<int(self.headers.get('Content-Length','0'))<=262144:raise ValueError()
                    except ValueError:return self.reply({'ok':False,'error':'请求无效'},400)
                if post and sub=='/api/siege':
                    try:
                        if not 0<int(self.headers.get('Content-Length','0'))<=4096:raise ValueError()
                        data=self.read_json();return self.reply(_room_siege(data))
                    except (ValueError,TypeError,KeyError,AttributeError):return self.reply({'ok':False,'error':'请求无效'},400)
                if not post and sub=='/siege':return self.reply(SIEGE_PAGE,200,'text/html; charset=utf-8')
                if not post and sub=='/':return self.reply(HTML_PAGE,200,'text/html; charset=utf-8')
                if sub not in ('/api/join','/api/state','/api/action'):return self.reply({'error':'not found'},404)
                self.path=sub+('?' + parsed.query if parsed.query else '')
                try:return (_rooms_post_base if post else _rooms_get_base)(self)
                finally:
                    if not STATE['players'] and STATE['hostPlayerId'] is None and sub!='/api/join' and not r.get('claim'):ROOMS.pop(code,None);save_state()
    if path in ('/api/account','/api/invite','/api/qr','/favicon.ico'):return (_rooms_post_base if post else _rooms_get_base)(self)
    return self.reply({'error':'请从公共大厅进入房间'},404)
Handler.do_GET=lambda self:_room_route(self)
Handler.do_POST=lambda self:_room_route(self,True)
